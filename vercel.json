{
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @factory/web build",
  "outputDirectory": "apps/web/.next",
  "env": {
    "TUS_ROUTES_ENABLED": "false",
    "TUS_PROVIDER_ACTIONS_ENABLED": "false",
    "TUS_RELEASE_JOBS_ENABLED": "false",
    "TUS_FLEET_JOBS_ENABLED": "false"
  }
}
