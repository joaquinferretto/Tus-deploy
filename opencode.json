{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },

    "edit": "allow",

    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",

    "external_directory": {
      "*": "ask"
    },

    "bash": {
      "*": "ask",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",

      "node *": "allow",
      "corepack *": "allow",
      "pnpm *": "allow",
      "npm *": "allow",
      "npx *": "allow",

      "docker ps*": "allow",
      "docker compose ps*": "allow",
      "docker compose logs*": "allow",

      "git commit *": "ask",
      "git add *": "ask",
      "git switch *": "ask",
      "git checkout *": "ask",
      "git restore *": "ask",

      "git push *": "deny",
      "git push origin web-tus": "deny",
      "git reset --hard*": "deny",
      "git clean *": "deny",

      "rm *": "deny",
      "rmdir *": "deny",
      "del *": "deny",
      "Remove-Item *": "deny",

      "docker compose down*": "ask",
      "docker compose up*": "ask",
      "docker rm *": "ask",
      "docker volume *": "ask",

      "prisma migrate reset*": "deny",
      "pnpm prisma migrate reset*": "deny",
      "npx prisma migrate reset*": "deny"
    }
  }
}