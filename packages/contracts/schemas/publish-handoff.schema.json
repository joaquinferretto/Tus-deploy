{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golden-boilerplate.dev/contracts/publish-handoff.v1.schema.json",
  "title": "PublishHandoffV1",
  "description": "Publishing payload emitted after a successful render/generation step.",
  "type": "object",
  "required": ["contractVersion", "assetId", "destination", "requestedAt", "artifacts", "trace"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "assetId": { "type": "string", "minLength": 1 },
    "destination": {
      "type": "object",
      "required": ["channel", "uri"],
      "properties": {
        "channel": { "enum": ["cms", "s3", "cdn", "webhook", "queue"] },
        "uri": { "type": "string", "format": "uri" },
        "region": { "type": "string" }
      },
      "additionalProperties": false
    },
    "requestedAt": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "uri", "mimeType"],
        "properties": {
          "role": { "enum": ["primary", "thumbnail", "transcript", "manifest", "metadata"] },
          "uri": { "type": "string", "format": "uri" },
          "mimeType": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "metadata": { "type": "object", "additionalProperties": true },
    "trace": {
      "type": "object",
      "required": ["traceId", "correlationId"],
      "properties": {
        "traceId": { "type": "string", "minLength": 16 },
        "correlationId": { "type": "string", "minLength": 8 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
