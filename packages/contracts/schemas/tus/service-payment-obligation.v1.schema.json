{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tus/service-payment-obligation.v1",
  "title": "TUS service payment obligation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "obligacionId",
    "tenantId",
    "clienteId",
    "prestadorTenantId",
    "prestadorId",
    "publicacionId",
    "commitmentId",
    "trabajoId",
    "amountSource",
    "budgetId",
    "budgetVersion",
    "amountMinor",
    "currency",
    "status",
    "version",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "contractVersion": { "type": "string" },
    "obligacionId": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "clienteId": { "type": "string", "minLength": 1 },
    "prestadorTenantId": { "type": "string", "minLength": 1 },
    "prestadorId": { "type": "string", "minLength": 1 },
    "publicacionId": { "type": "string", "minLength": 1 },
    "commitmentId": { "type": "string", "minLength": 1 },
    "trabajoId": { "type": "string", "minLength": 1 },
    "amountSource": { "enum": ["accepted_budget", "fixed_price_commitment"] },
    "budgetId": { "type": ["string", "null"], "minLength": 1 },
    "budgetVersion": { "type": ["integer", "null"], "minimum": 1 },
    "amountMinor": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "status": { "enum": ["pending_payment", "paid", "refunded", "charged_back"] },
    "version": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 }
  }
}
