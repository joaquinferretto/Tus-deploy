{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tusservicios.com/contracts/tus/pos-conflict.v1.schema.json",
  "title": "TUS POS conflict",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "conflictId", "tenantId", "operationId", "reason", "status", "createdAt"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "conflictId": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "operationId": { "type": "string", "minLength": 1 },
    "reason": { "enum": ["idempotency_conflict", "version_conflict", "uncertain_sync"] },
    "expectedVersion": { "type": "integer", "minimum": 0 },
    "actualVersion": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["open", "resolved", "discarded"] },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
