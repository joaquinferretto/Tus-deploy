{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tus/work-evidence.v1",
  "title": "TUS work evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "evidenceId", "trabajoId", "tenantId", "prestadorTenantId", "phase", "actorId", "correlationId", "reference", "metadata", "occurredAt", "createdAt"],
  "properties": {
    "contractVersion": { "type": "string" },
    "evidenceId": { "type": "string", "minLength": 1 },
    "trabajoId": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "prestadorTenantId": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["request", "diagnosis", "budget", "execution", "completion"] },
    "actorId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "reference": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" },
    "occurredAt": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 }
  }
}
