{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golden-boilerplate.dev/contracts/asset-lineage.v1.schema.json",
  "title": "AssetLineageV1",
  "description": "Immutable lineage event that explains where an asset came from and how it was produced.",
  "type": "object",
  "required": ["contractVersion", "assetId", "derivedFrom", "operation", "recordedAt"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "assetId": { "type": "string", "minLength": 1 },
    "derivedFrom": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["assetId", "relationship"],
        "properties": {
          "assetId": { "type": "string", "minLength": 1 },
          "relationship": { "enum": ["source", "reference", "mask", "audio", "template"] },
          "version": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "operation": {
      "type": "object",
      "required": ["stage", "tool", "performedBy", "jobId"],
      "properties": {
        "stage": { "enum": ["ingest", "transform", "generate", "publish"] },
        "tool": { "type": "string", "minLength": 1 },
        "performedBy": { "type": "string", "minLength": 1 },
        "jobId": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "recordedAt": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "uri"],
        "properties": {
          "kind": { "enum": ["prompt", "checksum", "report", "model-response", "render-log"] },
          "uri": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
