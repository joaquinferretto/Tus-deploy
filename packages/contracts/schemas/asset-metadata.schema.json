{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golden-boilerplate.dev/contracts/asset-metadata.v1.schema.json",
  "title": "AssetMetadataV1",
  "description": "Portable metadata envelope for any asset entering or leaving the content pipeline.",
  "type": "object",
  "required": [
    "contractVersion",
    "assetId",
    "mimeType",
    "sourceUri",
    "checksum",
    "sizeBytes",
    "capturedAt",
    "ownership"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "assetId": {
      "type": "string",
      "minLength": 1
    },
    "mimeType": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "sourceUri": {
      "type": "string",
      "format": "uri"
    },
    "checksum": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "enum": ["sha256", "sha512"]
        },
        "value": {
          "type": "string",
          "minLength": 16
        }
      },
      "additionalProperties": false
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "durationMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "ownership": {
      "type": "object",
      "required": ["tenantId", "workspaceId"],
      "properties": {
        "tenantId": { "type": "string", "minLength": 1 },
        "workspaceId": { "type": "string", "minLength": 1 },
        "actorId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "properties": {
        "parentAssetIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "jobId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": []
    },
    "custom": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
