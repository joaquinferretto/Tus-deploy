{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golden-boilerplate.dev/contracts/workflow-state.v1.schema.json",
  "title": "WorkflowStateV1",
  "description": "Shared snapshot of workflow execution state consumed by UIs, orchestrators, and workers.",
  "type": "object",
  "required": ["contractVersion", "workflowId", "runId", "status", "updatedAt", "steps"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "workflowId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["queued", "running", "waiting", "succeeded", "failed", "cancelled"] },
    "updatedAt": { "type": "string", "format": "date-time" },
    "input": { "type": "object", "additionalProperties": true },
    "output": { "type": "object", "additionalProperties": true },
    "currentStep": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "updatedAt"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["queued", "running", "waiting", "succeeded", "failed", "skipped"] },
          "updatedAt": { "type": "string", "format": "date-time" },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "required": ["traceId", "correlationId"],
      "properties": {
        "traceId": { "type": "string", "minLength": 16 },
        "correlationId": { "type": "string", "minLength": 8 },
        "spanId": { "type": "string", "minLength": 8 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
