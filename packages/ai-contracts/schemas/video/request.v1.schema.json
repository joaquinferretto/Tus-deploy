{
  "$id": "https://golden-boilerplate.dev/ai-contracts/video/request.v1.schema.json",
  "title": "Asynchronous video generation and editing request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "tenantId", "actorId", "correlationId", "lineage", "retention", "operation", "prompt", "mimeType", "durationSeconds", "model"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "tenantId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "lineage": { "$ref": "#/$defs/lineage" },
    "retention": { "$ref": "#/$defs/retention" },
    "operation": { "enum": ["generate", "edit"] },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "sourceVideoBase64": { "type": ["string", "null"], "minLength": 1 },
    "sourceAssetId": { "type": ["string", "null"], "minLength": 1 },
    "sourceUri": { "type": ["string", "null"], "pattern": "^b2://" },
    "sourceChecksum": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "mimeType": { "enum": ["video/mp4", "video/webm"] },
    "fileName": { "type": ["string", "null"], "minLength": 1 },
    "durationSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
    "model": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootMessageId", "source"],
      "properties": {
        "rootMessageId": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "sourceAssetId": { "type": ["string", "null"] }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expiresAt", "encrypted", "keyRef", "algorithm"],
      "properties": {
        "expiresAt": { "type": "integer", "minimum": 0 },
        "encrypted": { "const": true },
        "keyRef": { "type": "string", "minLength": 1 },
        "algorithm": { "type": "string", "minLength": 1 }
      }
    }
  }
}
