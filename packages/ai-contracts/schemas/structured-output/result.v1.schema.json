{
  "$id": "https://golden-boilerplate.dev/ai-contracts/structured-output/result.v1.schema.json",
  "title": "Structured output result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "tenantId",
    "actorId",
    "correlationId",
    "lineage",
    "status",
    "attempts",
    "errors",
    "usage"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "tenantId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "lineage": { "$ref": "#/$defs/lineage" },
    "status": { "enum": ["succeeded", "failed"] },
    "output": {},
    "attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
    "errors": { "type": "array", "items": { "type": "string" } },
    "usage": { "$ref": "#/$defs/usage" }
  },
  "$defs": {
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootMessageId", "source"],
      "properties": {
        "rootMessageId": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promptTokens", "completionTokens", "totalTokens", "estimatedCostUsd"],
      "properties": {
        "promptTokens": { "type": "integer", "minimum": 0 },
        "completionTokens": { "type": "integer", "minimum": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 },
        "estimatedCostUsd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
