{
  "$id": "https://golden-boilerplate.dev/ai-contracts/moderation/response.v1.schema.json",
  "title": "Moderation response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "tenantId",
    "actorId",
    "correlationId",
    "lineage",
    "retention",
    "redactedContent",
    "labels",
    "provider",
    "model",
    "usage",
    "safety",
    "audit",
    "availability"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "tenantId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "lineage": { "$ref": "#/$defs/lineage" },
    "retention": { "$ref": "#/$defs/retention" },
    "redactedContent": { "type": "string", "minLength": 1 },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/label" }
    },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "usage": { "$ref": "#/$defs/usage" },
    "safety": { "$ref": "#/$defs/safety" },
    "audit": { "$ref": "#/$defs/audit" },
    "availability": { "$ref": "#/$defs/availability" },
    "reviewId": { "type": ["string", "null"] }
  },
  "$defs": {
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootMessageId", "source"],
      "properties": {
        "rootMessageId": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expiresAt", "encrypted", "keyRef", "algorithm"],
      "properties": {
        "expiresAt": { "type": "integer", "minimum": 0 },
        "encrypted": { "const": true },
        "keyRef": { "type": "string", "minLength": 1 },
        "algorithm": { "type": "string", "minLength": 1 }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "confidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputCharacters", "outputLabels", "estimatedCostUsd"],
      "properties": {
        "inputCharacters": { "type": "integer", "minimum": 0 },
        "outputLabels": { "type": "integer", "minimum": 1 },
        "estimatedCostUsd": { "type": "number", "minimum": 0 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "category", "reason", "policyVersion"],
      "properties": {
        "decision": { "enum": ["allow", "deny", "escalate"] },
        "category": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "policyVersion": { "type": "string", "minLength": 1 },
        "reviewId": { "type": ["string", "null"] }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auditId",
        "tenantId",
        "actorId",
        "correlationId",
        "idempotencyKey",
        "outcome",
        "category",
        "policyVersion",
        "lineage"
      ],
      "properties": {
        "auditId": { "type": "string", "minLength": 1 },
        "tenantId": { "type": "string", "minLength": 1 },
        "actorId": { "type": "string", "minLength": 1 },
        "correlationId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "outcome": {
          "enum": ["allowed", "denied", "escalated", "approved", "rejected"]
        },
        "category": { "type": "string", "minLength": 1 },
        "policyVersion": { "type": "string", "minLength": 1 },
        "lineage": { "type": "object", "minProperties": 2 }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "alternative"],
      "properties": {
        "status": { "enum": ["active", "alternative", "gated", "unavailable", "deferred"] },
        "reason": { "type": "string", "minLength": 1 },
        "alternative": { "type": ["string", "null"] }
      }
    }
  }
}
