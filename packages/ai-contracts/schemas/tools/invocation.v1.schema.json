{
  "$id": "https://golden-boilerplate.dev/ai-contracts/tools/invocation.v1.schema.json",
  "title": "Permissioned tool invocation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "tenantId",
    "actorId",
    "correlationId",
    "lineage",
    "name",
    "arguments"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "tenantId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "lineage": { "$ref": "#/$defs/lineage" },
    "name": { "type": "string", "minLength": 1 },
    "arguments": { "type": "object" }
  },
  "$defs": {
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootMessageId", "source"],
      "properties": {
        "rootMessageId": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
