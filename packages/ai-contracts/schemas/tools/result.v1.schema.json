{
  "$id": "https://golden-boilerplate.dev/ai-contracts/tools/result.v1.schema.json",
  "title": "Permissioned tool result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "tenantId",
    "actorId",
    "correlationId",
    "lineage",
    "status",
    "audit"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "tenantId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "lineage": { "$ref": "#/$defs/lineage" },
    "status": { "enum": ["succeeded", "denied", "invalid"] },
    "output": {},
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auditId", "event", "decision", "reason"],
      "properties": {
        "auditId": { "type": "string", "minLength": 1 },
        "event": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["allowed", "denied", "invalid"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootMessageId", "source"],
      "properties": {
        "rootMessageId": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
