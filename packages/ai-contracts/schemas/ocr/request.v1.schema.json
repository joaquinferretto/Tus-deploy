{
  "$id": "https://golden-boilerplate.dev/ai-contracts/ocr/request.v1.schema.json",
  "title": "OCR request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "tenantId",
    "actorId",
    "correlationId",
    "lineage",
    "retention",
    "documentBase64",
    "mimeType",
    "fileName",
    "sourceAssetId",
    "sourceUri",
    "sourceChecksum",
    "model"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "tenantId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "lineage": { "$ref": "#/$defs/lineage" },
    "retention": { "$ref": "#/$defs/retention" },
    "documentBase64": { "type": "string", "minLength": 1, "contentEncoding": "base64" },
    "mimeType": {
      "enum": ["application/pdf", "image/jpeg", "image/png", "image/tiff", "image/webp"]
    },
    "fileName": { "type": "string", "minLength": 1 },
    "sourceAssetId": { "type": "string", "minLength": 1 },
    "sourceUri": { "type": "string", "pattern": "^b2://[^/].*" },
    "sourceChecksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "model": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootMessageId",
        "source",
        "workspaceId",
        "sourceAssetId",
        "sourceUri",
        "sourceChecksum"
      ],
      "properties": {
        "rootMessageId": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "workspaceId": { "type": "string", "minLength": 1 },
        "sourceAssetId": { "type": "string", "minLength": 1 },
        "sourceUri": { "type": "string", "pattern": "^b2://[^/].*" },
        "sourceChecksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expiresAt", "encrypted", "keyRef", "algorithm"],
      "properties": {
        "expiresAt": { "type": "integer", "minimum": 0 },
        "encrypted": { "const": true },
        "keyRef": { "type": "string", "minLength": 1 },
        "algorithm": { "type": "string", "minLength": 1 }
      }
    }
  }
}
