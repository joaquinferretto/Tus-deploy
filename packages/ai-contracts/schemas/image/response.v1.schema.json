{
  "$id": "https://golden-boilerplate.dev/ai-contracts/image/response.v1.schema.json",
  "title": "Image generation and editing response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "tenantId", "actorId", "correlationId", "lineage", "retention", "operation", "assets", "provider", "model", "usage", "safety", "availability"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "tenantId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "lineage": { "$ref": "#/$defs/lineage" },
    "retention": { "$ref": "#/$defs/retention" },
    "operation": { "enum": ["generate", "edit"] },
    "assets": { "type": "array", "maxItems": 1, "items": { "$ref": "#/$defs/asset" } },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "usage": { "$ref": "#/$defs/usage" },
    "safety": { "$ref": "#/$defs/safety" },
    "availability": { "$ref": "#/$defs/availability" }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "key", "mimeType", "checksum", "tenantId", "workspaceId", "state", "expiresAt"],
      "properties": {
        "assetId": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "mimeType": { "enum": ["image/jpeg", "image/png", "image/webp"] },
        "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "tenantId": { "type": "string", "minLength": 1 },
        "workspaceId": { "type": "string", "minLength": 1 },
        "state": { "enum": ["staged", "promoted"] },
        "expiresAt": { "type": "integer", "minimum": 0 },
        "sourceAssetId": { "type": ["string", "null"] }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootMessageId", "source"],
      "properties": {
        "rootMessageId": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "sourceAssetId": { "type": ["string", "null"] }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expiresAt", "encrypted", "keyRef", "algorithm"],
      "properties": {
        "expiresAt": { "type": "integer", "minimum": 0 },
        "encrypted": { "const": true },
        "keyRef": { "type": "string", "minLength": 1 },
        "algorithm": { "type": "string", "minLength": 1 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputBytes", "outputBytes", "estimatedCostUsd"],
      "properties": {
        "inputBytes": { "type": "integer", "minimum": 0 },
        "outputBytes": { "type": "integer", "minimum": 0 },
        "estimatedCostUsd": { "type": "number", "minimum": 0 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "category", "reason", "policyVersion"],
      "properties": {
        "decision": { "enum": ["allow", "deny", "escalate"] },
        "category": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "policyVersion": { "type": "string", "minLength": 1 },
        "reviewId": { "type": ["string", "null"] }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "alternative"],
      "properties": {
        "status": { "enum": ["active", "alternative", "gated", "unavailable", "deferred"] },
        "reason": { "type": "string", "minLength": 1 },
        "alternative": { "type": ["string", "null"] }
      }
    }
  }
}
