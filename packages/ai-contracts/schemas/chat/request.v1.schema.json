{
  "$id": "https://golden-boilerplate.dev/ai-contracts/chat/request.v1.schema.json",
  "title": "Chat request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "tenantId",
    "actorId",
    "correlationId",
    "lineage",
    "messages",
    "model"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "tenantId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "lineage": { "$ref": "#/$defs/lineage" },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["system", "user", "assistant", "tool"] },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    },
    "model": { "type": "string", "minLength": 1 },
    "maxTokens": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootMessageId", "source"],
      "properties": {
        "rootMessageId": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
