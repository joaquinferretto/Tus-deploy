  id              String   @id(map: "outbox_facturacion_pkey")
  tenantId        String   @map("tenant_id")
  eventoId        String   @map("evento_id")
  correlacionId   String   @map("correlacion_id")
  tipoEvento      String   @map("tipo_evento")
  agregadoId      String   @map("agregado_id")
  datosEvento     Json     @map("datos_evento")
  estado          String   @map("estado")
  intentos        Int      @map("intentos")
  disponibleDesde DateTime @map("disponible_desde")
  fechaCreacion   DateTime @map("fecha_creacion")

  @@unique([tenantId, eventoId], map: "uq_outbox_facturacion_tenant_evento")
  @@index([tenantId, estado, disponibleDesde], map: "idx_outbox_facturacion_tenant_estado_disponible")
  @@map("outbox_facturacion")
}

model GestionMora {
  id             String    @id(map: "gestion_mora_pkey")
  tenantId       String    @map("tenant_id")
  moraId         String    @map("mora_id")
  suscripcionId  String    @map("suscripcion_id")
  intento        Int       @map("intento")
  motivo         String    @map("motivo")
  estado         String    @map("estado")
  fechaReintento DateTime? @map("fecha_reintento")
  fechaCreacion  DateTime  @map("fecha_creacion")

  suscripcion Suscripcion @relation(fields: [tenantId, suscripcionId], references: [tenantId, suscripcionId], onDelete: Restrict, onUpdate: NoAction, map: "fk_gestion_mora_suscripciones")

  @@unique([tenantId, moraId], map: "uq_gestion_mora_tenant_mora")
  @@index([tenantId, suscripcionId, fechaCreacion], map: "idx_gestion_mora_tenant_suscripcion_fecha_creacion")
  @@map("gestion_mora")
}

model SecuenciaNumeracion {
  id              String @id(map: "secuencias_numeracion_pkey")
  tenantId        String @unique(map: "uq_secuencias_numeracion_tenant_id") @map("tenant_id")
  siguienteNumero Int    @map("siguiente_numero")

  @@map("secuencias_numeracion")
}

model ExportacionContable {
  id                          String   @id(map: "exportaciones_contables_pkey")
  tenantId                    String   @map("tenant_id")
  exportacionId               String   @map("exportacion_id")
  idsFacturas                 String[] @map("ids_facturas")
  idsEntradasContables        String[] @map("ids_entradas_contables")
  referenciaAprobacionExterna String   @map("referencia_aprobacion_externa")
  estado                      String   @map("estado")
  publicadaExternamente       Boolean  @default(false) @map("publicada_externamente")
  fechaCreacion               DateTime @map("fecha_creacion")

  @@unique([tenantId, exportacionId], map: "uq_exportaciones_tenant_exportacion")
  @@index([tenantId, fechaCreacion], map: "idx_exportaciones_tenant_fecha_creacion")
  @@map("exportaciones_contables")
}

model TusJob {
  id          String    @id
  tenantId    String
  jobId       String
  jobType     String
  status      String
  attempts    Int
  availableAt DateTime
  claimId     String?
  claimUntil  DateTime?
  payload     Json
  lastError   String?
  createdAt   DateTime
  updatedAt   DateTime

  @@unique([tenantId, jobId])
  @@index([tenantId, status, availableAt, claimUntil])
}

model TusDeadLetter {
  id            String   @id
  tenantId      String
  jobId         String
  reason        String
  payload       Json
  correlationId String
  createdAt     DateTime

  @@unique([tenantId, id])
  @@index([tenantId, jobId, createdAt])
}
