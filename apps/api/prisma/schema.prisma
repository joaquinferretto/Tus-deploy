  @@unique([tenantId, exportId])
  @@index([tenantId, createdAt])
}

model TusJob {
  id            String   @id
  tenantId      String
  jobId         String
  jobType       String
  status        String
  attempts      Int
  availableAt   DateTime
  claimId       String?
  claimUntil    DateTime?
  payload       Json
  lastError     String?
  createdAt     DateTime
  updatedAt     DateTime

  @@unique([tenantId, jobId])
  @@index([tenantId, status, availableAt, claimUntil])
}

model TusDeadLetter {
  id          String   @id
  tenantId    String
  jobId       String
  reason      String
  payload     Json
  correlationId String
  createdAt   DateTime

  @@unique([tenantId, id])
  @@index([tenantId, jobId, createdAt])
}
