  estadoProveedor          String    @map("estado_proveedor")
  estadoComercial          String    @map("estado_comercial")
  monto                    BigInt    @map("monto")
  moneda                   String    @map("moneda")
  claveIdempotencia        String    @map("clave_idempotencia")
  correlacionId            String    @map("correlacion_id")
  credencialesRecolectadas Boolean   @map("credenciales_recolectadas")
  origen                   String    @map("origen")
  ordenId                  String    @default("") @map("orden_id")
  operacionPosId           String?   @map("operacion_pos_id")
  comercianteRegistro      String    @default("tus-intermediary") @map("comerciante_registro")
  modeloCobro              String    @default("intermediary") @map("modelo_cobro")
  politicaDistribucion     Json?     @map("politica_distribucion")
  fechaLiberacion          DateTime  @default(now()) @map("fecha_liberacion")
  fechaEventoProveedor     DateTime? @map("fecha_evento_proveedor")
  errorProveedor           String?   @map("error_proveedor")
  fechaCreacion            DateTime  @map("fecha_creacion")
  fechaActualizacion       DateTime  @map("fecha_actualizacion")

  compromiso Compromiso?             @relation(fields: [tenantId, compromisoId], references: [tenantId, compromisoId], onDelete: Restrict, onUpdate: NoAction, map: "fk_intenciones_pago_compromisos")
  obligacion ObligacionPagoServicio? @relation(fields: [tenantId, obligacionId], references: [tenantId, obligacionId], onDelete: Restrict, onUpdate: NoAction, map: "fk_intenciones_pago_obligaciones")

  @@unique([tenantId, pagoId], map: "uq_intenciones_pago_tenant_pago")
  @@unique([tenantId, compromisoId], map: "uq_intenciones_pago_tenant_compromiso")
