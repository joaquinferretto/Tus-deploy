generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(uuid())
  email           String       @unique
  normalizedEmail String       @unique
  displayName     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  accounts        Account[]
  memberships     Membership[]
}

model Account {
  id                 String               @id
  userId             String
  tenantId           String
  roles              String[]             @default([])
  status             String
  emailVerifiedAt    DateTime?
  createdAt          DateTime
  updatedAt          DateTime
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentials        PasswordCredential[]
  verificationTokens VerificationToken[]
  recoveryTokens     RecoveryToken[]
  devices            Device[]
  sessions           Session[]

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model PasswordCredential {
  id           String    @id
  accountId    String    @unique
  passwordHash String
  status       String
  createdAt    DateTime
  updatedAt    DateTime
  lastUsedAt   DateTime?
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id          String    @id
  accountId   String
  tokenDigest String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model RecoveryToken {
  id          String    @id
  accountId   String
  tokenDigest String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Device {
  id          String   @id @default(uuid())
  accountId   String
  deviceId    String
  label       String
  firstSeenAt DateTime
  lastSeenAt  DateTime
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, deviceId], name: "accountId_deviceId")
  @@index([accountId])
}

model Session {
  id                String    @id
  accountId         String
  tenantId          String
  deviceId          String
  accessTokenDigest String    @unique
  roles             String[]  @default([])
  permissions       String[]  @default([])
  createdAt         DateTime
  expiresAt         DateTime
  revokedAt         DateTime?
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt])
  @@index([tenantId])
}

// P2.1 relational source-of-truth records. MongoDB, Redis, queues, and
// object storage may receive projections or delivery state, but never own
// these records.
model Organization {
  id          String       @id
  name        String
  slug        String       @default("")
  defaultWorkspaceId String @default("")
  createdAt   DateTime
  updatedAt   DateTime
  workspaces  Workspace[]
  memberships Membership[]

  @@index([createdAt])
}

model Workspace {
  id             String       @id
  organizationId String
  name           String
  slug           String
  createdAt      DateTime
  updatedAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Membership {
  id             String       @id
  organizationId String
  workspaceId    String
  userId         String
  role           String
  roleIds        String[]  @default([])
  status         String
  createdAt      DateTime
  updatedAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([organizationId, userId])
  @@index([workspaceId, status])
}

model TenantRole {
  id             String   @id
  tenantId       String
  name           String
  permissions    String[]
  resourceScopes String[]
  createdAt      DateTime

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Invitation {
  id          String    @id
  tenantId    String
  email       String
  roleIds     String[]
  tokenDigest String    @unique
  status      String
  expiresAt   DateTime
  createdAt   DateTime
  acceptedAt  DateTime?

  @@index([tenantId, status])
}

model TenantResource {
  id       String @id
  tenantId String
  type     String
  value    String

  @@index([tenantId, type])
}

model AuditEvent {
  id             String    @id
  tenantId       String
  actorId        String?
  correlationId  String
  eventType      String
  outcome        String
  metadata       Json
  occurredAt     DateTime
  retentionUntil DateTime?

  @@index([tenantId, occurredAt])
  @@index([correlationId])
  @@index([eventType, occurredAt])
}

model SearchRecord {
  id            String   @id
  tenantId      String
  entityType    String
  entityId      String
  searchText    String
  payload       Json?
  sourceVersion Int
  createdAt     DateTime
  updatedAt     DateTime

  @@unique([tenantId, entityType, entityId])
  @@index([tenantId, entityType])
  @@index([updatedAt])
}

model AggregateSnapshot {
  id            String   @id
  tenantId      String
  aggregateType String
  aggregateId   String
  version       Int
  state         Json
  createdAt     DateTime
  updatedAt     DateTime

  @@unique([tenantId, aggregateType, aggregateId])
  @@index([tenantId, aggregateType, version])
}

model QuotaAccount {
  id           String             @id
  tenantId     String
  metric       String
  limit        Int
  used         Int                @default(0)
  reserved     Int                @default(0)
  createdAt    DateTime
  updatedAt    DateTime
  reservations QuotaReservation[]

  @@unique([tenantId, metric])
  @@index([tenantId, updatedAt])
}

model QuotaReservation {
  id             String       @id
  quotaAccountId String
  idempotencyKey String
  units          Int
  status         String
  expiresAt      DateTime
  createdAt      DateTime
  quotaAccount   QuotaAccount @relation(fields: [quotaAccountId], references: [id], onDelete: Cascade)

  @@unique([quotaAccountId, idempotencyKey])
  @@index([quotaAccountId, status])
  @@index([expiresAt, status])
}

model IdempotencyRecord {
  id          String   @id
  tenantId    String
  key         String
  requestHash String
  status      String
  response    Json?
  createdAt   DateTime
  expiresAt   DateTime

  @@unique([tenantId, key])
  @@index([expiresAt])
}

model OutboxEvent {
  id            String    @id
  tenantId      String
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        String
  attempts      Int       @default(0)
  availableAt   DateTime
  lastError     String?
  createdAt     DateTime
  publishedAt   DateTime?
  claimId       String?
  claimUntil    DateTime?

  @@index([status, availableAt])
  @@index([status, availableAt, claimUntil])
  @@index([tenantId, status, claimUntil])
  @@index([tenantId, aggregateType, aggregateId])
  @@index([createdAt])
}

model RunLedger {
  id             String   @id
  tenantId       String
  idempotencyKey String
  requestHash    String
  runType        String
  status         String
  input          Json
  result         Json?
  error          Json?
  createdAt      DateTime
  updatedAt      DateTime

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, updatedAt])
}

model OwnershipRecord {
  id              String   @id @default(uuid())
  dataClass       String   @unique
  owner           String
  rebuildStrategy String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// PostgreSQL/PGVector owns retrieval metadata and vectors. B2 lineage remains
// the rebuild source; this table is never a durable source-document store.
model RagEmbedding {
  id                String   @id
  tenantId          String
  workspaceId       String
  sourceId          String
  chunkId           String
  chunkIndex        Int
  embeddingModel    String
  embeddingVersion  String
  indexVersion      String
  vector            Unsupported("vector")
  sourceChecksum    String
  sourceUri         String
  parserVersion     String
  chunkerVersion    String
  retentionUntil    DateTime?
  metadata          Json
  createdAt         DateTime
  updatedAt         DateTime

  @@unique([tenantId, sourceId, chunkIndex, embeddingVersion, indexVersion])
  @@index([tenantId, indexVersion])
  @@index([tenantId, sourceId])
}

// P4.3 owns the auditable, versioned AI catalog. Registry APIs must enforce
// tenant scope before reaching these relational records.
model PromptDefinition {
  id          String          @id
  tenantId    String
  key         String
  owner       String
  description String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  versions    PromptVersion[]
  rollouts    Rollout[]

  @@unique([tenantId, key])
  @@index([tenantId, updatedAt])
}

model PromptVersion {
  id               String           @id
  tenantId         String
  promptId         String
  version          Int
  template         String
  checksum         String
  status           String
  createdBy        String
  approvedBy       String?
  deprecatedReason String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  prompt            PromptDefinition @relation(fields: [promptId], references: [id], onDelete: Cascade)
  @@unique([tenantId, promptId, version])
  @@index([tenantId, promptId, status])
}

model ModelDefinition {
  id           String              @id
  tenantId     String
  key          String
  provider     String
  modelName    String
  owner        String
  status       String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  availability ModelAvailability[]
  rollouts     Rollout[]

  @@unique([tenantId, key])
  @@index([tenantId, provider, status])
}

model ModelAvailability {
  id         String          @id
  tenantId   String
  modelId    String
  status     String
  reason     String
  observedAt DateTime
  model      ModelDefinition @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([tenantId, modelId])
  @@index([tenantId, status, observedAt])
}

model Rollout {
  id              String           @id
  tenantId        String
  promptId        String
  promptVersion   Int
  modelId         String
  percentage      Int
  state           String
  createdBy       String
  rolloutVersion  Int
  previousRolloutId String?
  failureReason   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  prompt          PromptDefinition @relation(fields: [promptId], references: [id], onDelete: Cascade)
  model           ModelDefinition  @relation(fields: [modelId], references: [id], onDelete: Restrict)

  @@index([tenantId, promptId, state])
  @@index([tenantId, modelId, state])
}

model Approval {
  id           String   @id
  tenantId     String
  resourceType String
  resourceId   String
  requestedBy  String
  status       String
  approverId   String?
  reason       String
  createdAt    DateTime @default(now())
  decidedAt    DateTime?

  @@index([tenantId, resourceType, resourceId, status])
}

model RegistryAudit {
  id           String   @id
  tenantId     String
  actorId      String
  correlationId String
  action       String
  resourceType String
  resourceId   String
  version      Int?
  outcome      String
  metadata     Json
  occurredAt   DateTime @default(now())

  @@index([tenantId, occurredAt])
  @@index([tenantId, resourceType, resourceId, occurredAt])
  @@index([correlationId])
}

model EvidenciaHabilitacion {
  id            String    @id
  contractVersion String  @default("1.0.0")
  tenantId      String
  capability    String
  gate          String
  owner         String
  scope         String
  tipoEvidencia String    @map("evidenceType")
  referenciaEvidencia String @map("evidenceRef")
  policyVersion String
  issuedAt      DateTime
  expiresAt     DateTime?
  revoked       Boolean   @default(false)
  source        String
  profile       String    @default("legacy-unscoped")
  execution     String    @default("live")
  evidenceClass String    @default("deferred")
  liveConformance Boolean  @default(false)
  createdAt     DateTime
  updatedAt     DateTime

  @@unique([tenantId, capability, gate, referenciaEvidencia], map: "TusReadinessEvidence_tenantId_capability_gate_evidenceRef_key")
  @@index([tenantId, capability, gate, revoked], map: "TusReadinessEvidence_tenantId_capability_gate_revoked_idx")
  @@index([expiresAt], map: "TusReadinessEvidence_expiresAt_idx")
  @@map("TusReadinessEvidence")
}

model DecisionHabilitacion {
  id               String   @id
  tenantId         String
  capability       String
  evaluatedAt      DateTime
  enabled          Boolean
  resultadoHabilitacion String   @map("disposition")
  requisitosFallidos Json     @map("failedGates")
  idsEvidencia     String[] @map("evidenceIds")
  deterministic    Boolean
  conflicts        Json?
  reason           String?
  evidencePreserved Boolean?
  auditPreserved   Boolean?
  actorId          String   @default("legacy")
  jobId            String?
  correlationId    String   @default("legacy")
  profile          String   @default("legacy-unscoped")
  scope            String   @default("legacy")
  outcome          String   @default("blocked")
  createdAt        DateTime

  @@index([tenantId, capability, evaluatedAt], map: "TusReadinessDecision_tenantId_capability_evaluatedAt_idx")
  @@index([tenantId, capability, enabled], map: "TusReadinessDecision_tenantId_capability_enabled_idx")
  @@index([tenantId, correlationId], map: "TusReadinessDecision_tenantId_correlationId_idx")
  @@map("TusReadinessDecision")
}

// TUS commerce source-of-truth records. Every query and unique key is tenant
// scoped; projections and provider adapters must not own these aggregates.
model Compromiso {
  id              String   @id(map: "TusCommitment_pkey")
  versionContrato String   @map("contractVersion")
  compromisoId    String   @map("commitmentId")
  carritoId       String   @map("cartId")
  tenantId        String   @map("tenantId")
  prestadorId     String   @map("merchantId")
  contexto        String   @map("context")
  monto           BigInt   @map("amount")
  moneda          String   @map("currency")
  estado          String   @map("status")
  idsLineas       String[] @map("lineIds")
  version         Int      @default(1)
  fechaCreacion   DateTime @map("createdAt")
  fechaActualizacion DateTime @map("updatedAt")

  @@unique([tenantId, compromisoId], map: "TusCommitment_tenantId_commitmentId_key")
  @@index([tenantId, fechaCreacion], map: "TusCommitment_tenantId_createdAt_idx")
  @@index([tenantId, carritoId], map: "TusCommitment_tenantId_cartId_idx")
  @@map("TusCommitment")
}

model TransicionCompromiso {
  id              String   @id(map: "TusCommitmentTransition_pkey")
  tenantId        String   @map("tenantId")
  compromisoId    String   @map("commitmentId")
  estadoAnterior  String   @map("fromStatus")
  estadoNuevo     String   @map("toStatus")
  version         Int
  actorId         String   @map("actorId")
  correlacionId   String   @map("correlationId")
  motivo          String   @map("reason")
  fechaCreacion   DateTime @map("createdAt")

  @@unique([tenantId, compromisoId, version], map: "TusCommitmentTransition_tenantId_commitmentId_version_key")
  @@index([tenantId, compromisoId, fechaCreacion], map: "TusCommitmentTransition_tenantId_commitmentId_createdAt_idx")
  @@map("TusCommitmentTransition")
}

model CompensacionCompromiso {
  id              String   @id(map: "TusCommitmentCompensation_pkey")
  compensacionId  String   @map("compensationId")
  tenantId        String   @map("tenantId")
  compromisoId    String   @map("commitmentId")
  actorId         String   @map("actorId")
  correlacionId   String   @map("correlationId")
  monto           BigInt   @map("amount")
  moneda          String   @map("currency")
  motivo          String   @map("reason")
  fechaCreacion   DateTime @map("createdAt")

  @@unique([tenantId, compensacionId], map: "TusCommitmentCompensation_tenantId_compensationId_key")
  @@unique([tenantId, compromisoId], map: "TusCommitmentCompensation_tenantId_commitmentId_key")
  @@index([tenantId, compromisoId, fechaCreacion], map: "TusCommitmentCompensation_tenantId_commitmentId_createdAt_idx")
  @@map("TusCommitmentCompensation")
}

model ReferenciaAuditoria {
  id              String   @id(map: "TusAuditReference_pkey")
  referenciaId    String   @map("referenceId")
  tenantId        String   @map("tenantId")
  actorId         String   @map("actorId")
  correlacionId   String   @map("correlationId")
  compromisoId    String   @map("commitmentId")
  tipoReferencia  String   @map("referenceType")
  metadatos       Json?    @map("metadata")
  fechaCreacion   DateTime @map("createdAt")

  @@unique([tenantId, referenciaId], map: "TusAuditReference_tenantId_referenceId_key")
  @@index([tenantId, compromisoId, fechaCreacion], map: "TusAuditReference_tenantId_commitmentId_createdAt_idx")
  @@index([tenantId, correlacionId], map: "TusAuditReference_tenantId_correlationId_idx")
  @@map("TusAuditReference")
}

model Prestador {
  id                     String   @id(map: "TusMerchant_pkey")
  tenantId               String   @unique(map: "TusMerchant_tenantId_key") @map("tenantId")
  prestadorId            String   @map("merchantId")
  cohorte                String   @map("cohort")
  ubicacionId            String   @map("locationId")
  zonaHoraria            String   @map("timezone")
  rolesPersonal          String[] @map("staffRoles")
  versionPoliticaOperativa String @map("operatingPolicyVersion")
  estado                 String   @map("status")
  fechaCreacion          DateTime @map("createdAt")
  fechaActualizacion     DateTime @map("updatedAt")
  publicaciones          Publicacion[]

  @@index([tenantId, estado], map: "TusMerchant_tenantId_status_idx")
  @@map("TusMerchant")
}

model Publicacion {
  id                   String       @id(map: "TusListing_pkey")
  versionContrato      String       @map("contractVersion")
  tenantId             String       @map("tenantId")
  prestadorId          String       @map("merchantId")
  tipo                 String       @map("kind")
  nombre               String       @map("name")
  descripcion          String       @map("description")
  cohorte              String       @map("cohort")
  ubicacionId          String       @map("locationId")
  moneda               String       @map("currency")
  precio               BigInt       @map("price")
  versionDisponibilidad Int         @map("availabilityVersion")
  publicada             Boolean     @map("published")
  versionPolitica     String       @map("policyVersion")
  existencias          Int?         @map("stock")
  duracionMinutos      Int?         @map("durationMinutes")
  capacidad            Int?         @map("capacity")
  horarioTrabajo       Json         @map("workingHours")
  fechaCreacion        DateTime     @map("createdAt")
  fechaActualizacion    DateTime     @map("updatedAt")
  prestadorRelacionLegacy Prestador @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade, map: "TusListing_tenantId_fkey")

  @@index([tenantId, publicada], map: "TusListing_tenantId_published_idx")
  @@index([tenantId, versionDisponibilidad], map: "TusListing_tenantId_availabilityVersion_idx")
  @@index([prestadorId, tipo], map: "TusListing_merchantId_kind_idx")
  @@map("TusListing")
}

model CompromisoMercadoServicios {
  id                   String   @id(map: "TusMarketplaceCommitment_pkey")
  versionContrato      String   @map("contractVersion")
  compromisoId         String   @map("commitmentId")
  carritoId            String   @map("cartId")
  tenantId             String   @map("tenantId")
  prestadorId          String   @map("merchantId")
  publicacionId        String   @map("listingId")
  contexto             String   @map("context")
  idsLineas            String[] @map("lineIds")
  cantidad             Int      @map("quantity")
  monto                BigInt   @map("amount")
  moneda               String   @map("currency")
  estado               String   @map("status")
  versionDisponibilidad Int     @map("availabilityVersion")
  versionPolitica      String   @map("policyVersion")
  franjaInicio         DateTime? @map("slotStart")
  franjaFin            DateTime? @map("slotEnd")
  fechaCreacion        DateTime @map("createdAt")
  fechaActualizacion   DateTime @map("updatedAt")

  @@unique([tenantId, compromisoId], map: "TusMarketplaceCommitment_tenantId_commitmentId_key")
  @@index([tenantId, fechaCreacion], map: "TusMarketplaceCommitment_tenantId_createdAt_idx")
  @@index([publicacionId, franjaInicio, franjaFin], map: "TusMarketplaceCommitment_listingId_slotStart_slotEnd_idx")
  @@index([prestadorId, contexto, estado], map: "TusMarketplaceCommitment_merchantId_context_status_idx")
  @@map("TusMarketplaceCommitment")
}

model AuditoriaMercadoServicios {
  id             String   @id(map: "TusMarketplaceAudit_pkey")
  tenantId       String   @map("tenantId")
  actorId        String   @map("actorId")
  correlacionId  String   @map("correlationId")
  accion         String   @map("action")
  tipoRecurso    String   @map("resourceType")
  recursoId      String   @map("resourceId")
  resultado      String   @map("outcome")
  fechaCreacion  DateTime @map("createdAt")

  @@index([tenantId, fechaCreacion], map: "TusMarketplaceAudit_tenantId_createdAt_idx")
  @@index([tenantId, tipoRecurso, recursoId], map: "TusMarketplaceAudit_tenantId_resourceType_resourceId_idx")
  @@map("TusMarketplaceAudit")
}

// TUS finance source-of-truth records. Provider state is deliberately separate
// from commercial state; ledger entries are append-only and corrections link to
// their originating entry instead of rewriting history.
model IntencionPago {
  id                      String   @id(map: "TusPaymentIntent_pkey")
  versionContrato         String   @map("contractVersion")
  pagoId                  String   @map("paymentId")
  tenantId                String   @map("tenantId")
  compromisoId            String   @map("commitmentId")
  proveedor               String   @map("provider")
  referenciaProveedor     String?  @map("providerReference")
  estadoProveedor         String   @map("providerStatus")
  estadoComercial         String   @map("commercialStatus")
  monto                   BigInt   @map("amount")
  moneda                  String   @map("currency")
  claveIdempotencia       String   @map("idempotencyKey")
  correlacionId           String   @map("correlationId")
  credencialesRecolectadas Boolean @map("credentialsCollected")
  origen                  String   @map("source")
  ordenId                 String   @default("") @map("orderId")
  operacionPosId          String?  @map("posOperationId")
  comercianteRegistro     String   @default("tus-intermediary") @map("merchantOfRecord")
  modeloCobro             String   @default("intermediary") @map("collectionModel")
  politicaDistribucion    Json?    @map("splitPolicy")
  fechaLiberacion         DateTime @default(now()) @map("releaseAt")
  fechaEventoProveedor    DateTime? @map("providerEventAt")
  errorProveedor          String?  @map("providerError")
  fechaCreacion           DateTime @map("createdAt")
  fechaActualizacion      DateTime @map("updatedAt")

  @@unique([tenantId, pagoId], map: "TusPaymentIntent_tenantId_paymentId_key")
  @@unique([tenantId, compromisoId], map: "TusPaymentIntent_tenantId_commitmentId_key")
  @@unique([tenantId, claveIdempotencia], map: "TusPaymentIntent_tenantId_idempotencyKey_key")
  @@index([tenantId, estadoProveedor], map: "TusPaymentIntent_tenantId_providerStatus_idx")
  @@index([tenantId, estadoComercial], map: "TusPaymentIntent_tenantId_commercialStatus_idx")
  @@map("TusPaymentIntent")
}

model IdempotenciaFinanciera {
  id                String   @id(map: "TusFinanceIdempotency_pkey")
  tenantId          String   @map("tenantId")
  claveIdempotencia String   @map("idempotencyKey")
  hashSolicitud     String   @map("requestHash")
  respuesta         Json     @map("response")
  fechaCreacion     DateTime @default(now()) @map("createdAt")
  fechaActualizacion DateTime @updatedAt @map("updatedAt")

  @@unique([tenantId, claveIdempotencia], map: "TusFinanceIdempotency_tenantId_idempotencyKey_key")
  @@index([tenantId, fechaActualizacion], map: "TusFinanceIdempotency_tenantId_updatedAt_idx")
  @@map("TusFinanceIdempotency")
}

model InstantaneaComision {
  id                  String   @id(map: "TusCommissionSnapshot_pkey")
  versionContrato     String   @map("contractVersion")
  instantaneaId       String   @map("snapshotId")
  tenantId            String   @map("tenantId")
  compromisoId        String   @map("commitmentId")
  contexto            String   @map("context")
  montoBruto          BigInt   @map("grossAmount")
  deducciones         BigInt   @map("deductions")
  baseComisionable    BigInt   @map("commissionableBase")
