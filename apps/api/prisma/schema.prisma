  fechaActualizacion DateTime @map("updatedAt")

  @@unique([tenantId, reservaId], map: "TusBooking_tenantId_bookingId_key")
  @@index([tenantId, calendarioId, fechaInicio, fechaFin], map: "TusBooking_tenantId_calendarId_startsAt_endsAt_idx")
  @@index([tenantId, clienteId, estado], map: "TusBooking_tenantId_customerId_status_idx")
  @@map("TusBooking")
}

