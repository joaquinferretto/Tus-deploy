  @@index([tenantId, createdAt])
}

model TusBillingAudit {
  id            String   @id
  tenantId      String
  auditId       String
  actorId       String
  correlationId String
  action        String
  resourceId    String
  outcome       String
  reason        String?
  createdAt     DateTime

  @@unique([tenantId, auditId])
  @@index([tenantId, correlationId, createdAt])
}

model OutboxFacturacion {
  id             String   @id(map: "TusBillingOutbox_pkey")
  tenantId       String   @map("tenantId")
  eventoId       String   @map("eventId")
  correlacionId  String   @map("correlationId")
  tipoEvento     String   @map("eventType")
  agregadoId     String   @map("aggregateId")
  datosEvento    Json     @map("payload")
  estado         String   @map("status")
  intentos       Int      @map("attempts")
  disponibleDesde DateTime @map("availableAt")
  fechaCreacion  DateTime @map("createdAt")

  @@unique([tenantId, eventoId], map: "TusBillingOutbox_tenantId_eventId_key")
  @@index([tenantId, estado, disponibleDesde], map: "TusBillingOutbox_tenantId_status_availableAt_idx")
  @@map("TusBillingOutbox")
}

model TusBillingDunning {
