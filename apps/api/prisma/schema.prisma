  @@index([tenantId, estadoComercial], map: "idx_intenciones_pago_tenant_estado_comercial")
  @@map("intenciones_pago")
}

// WEB-09A: canonical financial identity of a WEB-08 service. tenant_id is the customer
// tenant (same as trabajos.tenant_id); the composite FK pins the whole chain
// Trabajo -> CompromisoMercadoServicios -> Publicacion -> Prestador so an obligation
// cannot mix tenants, providers, publications or commitments.
model ObligacionPagoServicio {
  id                 String   @id(map: "obligaciones_pago_servicio_pkey")
  versionContrato    String   @map("version_contrato")
  obligacionId       String   @map("obligacion_id")
  tenantId           String   @map("tenant_id")
  clienteId          String   @map("cliente_id")
  prestadorTenantId  String   @map("prestador_tenant_id")
  prestadorId        String   @map("prestador_id")
  publicacionId      String   @map("publicacion_id")
  compromisoId       String   @map("compromiso_id")
  trabajoId          String   @map("trabajo_id")
  origenImporte      String   @map("origen_importe")
  presupuestoId      String?  @map("presupuesto_id")
  presupuestoVersion Int?     @map("presupuesto_version")
  monto              BigInt   @map("monto")
  moneda             String   @map("moneda")
  estado             String   @map("estado")
  version            Int      @default(1) @map("version")
  actorId            String   @map("actor_id")
  correlacionId      String   @map("correlacion_id")
  fechaCreacion      DateTime @map("fecha_creacion")
  fechaActualizacion DateTime @map("fecha_actualizacion")

  trabajo              Trabajo               @relation(fields: [tenantId, trabajoId, compromisoId, prestadorTenantId, prestadorId, publicacionId], references: [tenantId, trabajoId, compromisoId, prestadorTenantId, prestadorId, publicacionId], onDelete: Restrict, onUpdate: NoAction, map: "fk_obligaciones_pago_trabajos")
  presupuesto          Presupuesto?          @relation(fields: [tenantId, presupuestoId, presupuestoVersion], references: [tenantId, presupuestoId, version], onDelete: Restrict, onUpdate: NoAction, map: "fk_obligaciones_pago_presupuestos")
  intencionesPago      IntencionPago[]
  instantaneasComision InstantaneaComision[]
  movimientosContables MovimientoContable[]

  @@unique([tenantId, obligacionId], map: "uq_obligaciones_pago_tenant_obligacion")
  @@unique([tenantId, trabajoId], map: "uq_obligaciones_pago_tenant_trabajo")
  @@index([prestadorTenantId, prestadorId, estado], map: "idx_obligaciones_pago_prestador_estado")
  @@index([tenantId, estado], map: "idx_obligaciones_pago_tenant_estado")
  @@map("obligaciones_pago_servicio")
}

