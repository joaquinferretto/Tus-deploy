  id                String   @id(map: "TusOperationsRecord_pkey")
  tenantId          String   @map("tenantId")
  contexto          String   @map("context")
  canal             String   @map("channel")
  geografia         String   @map("geography")
  resultado         String   @map("outcome")
  monto             BigInt   @map("amount")
  moneda            String   @map("currency")
  estadoContable    String   @map("ledgerStatus")
  accionesWhatsApp Int      @map("whatsappActions")
  disputas          Int      @map("disputes")
  posFueraLinea     Int      @map("posOffline")
  fechaCreacion     DateTime @map("createdAt")

  @@index([tenantId, fechaCreacion], map: "TusOperationsRecord_tenantId_createdAt_idx")
  @@index([tenantId, contexto, canal, geografia], map: "TusOperationsRecord_tenantId_context_channel_geography_idx")
  @@map("TusOperationsRecord")
}

// Argentina launch baseline. These records are PostgreSQL-owned and every
// tenant-owned identity is scoped by tenantId in its unique keys and indexes.
model TusTenant {
  id        String   @id
  slug      String
  name      String
  status    String
  createdAt DateTime
  updatedAt DateTime

  @@unique([slug])
  @@index([status, createdAt])
}

model TusProduct {
  id          String   @id
  tenantId    String
  sku         String
  name        String
  description String
  category    String
  status      String
  createdAt   DateTime
  updatedAt   DateTime

  @@unique([tenantId, sku])
  @@index([tenantId, status])
}

model TusService {
  id              String   @id
  tenantId        String
  serviceCode     String
  name            String
  description     String
  durationMinutes Int
  capacity        Int
  status          String
  createdAt       DateTime
  updatedAt       DateTime

  @@unique([tenantId, serviceCode])
  @@index([tenantId, status])
}

model TusInventory {
  id        String   @id
  tenantId  String
  productId String
  quantity  Int
  reserved  Int
  version   Int
  createdAt DateTime
  updatedAt DateTime

  @@unique([tenantId, productId])
  @@index([tenantId, quantity])
}

model Calendario {
  id          String   @id(map: "TusCalendar_pkey")
  tenantId    String   @map("tenantId")
  servicioId  String   @map("serviceId")
  nombre      String   @map("name")
  zonaHoraria String   @map("timezone")
  estado      String   @map("status")
  fechaCreacion DateTime @map("createdAt")
  fechaActualizacion DateTime @map("updatedAt")

  @@unique([tenantId, id], map: "TusCalendar_tenantId_id_key")
  @@index([tenantId, servicioId, estado], map: "TusCalendar_tenantId_serviceId_status_idx")
  @@map("TusCalendar")
}

model ReglaCalendario {
  id            String   @id(map: "TusCalendarRule_pkey")
  tenantId      String   @map("tenantId")
  calendarioId  String   @map("calendarId")
  diaSemana     Int      @map("weekday")
  horaInicio    String   @map("startsAt")
  horaFin       String   @map("endsAt")
  capacidad     Int      @map("capacity")
  fechaCreacion DateTime @map("createdAt")
  fechaActualizacion DateTime @map("updatedAt")

  @@unique([tenantId, calendarioId, diaSemana, horaInicio, horaFin], map: "TusCalendarRule_tenantId_calendarId_weekday_startsAt_endsAt_key")
  @@index([tenantId, calendarioId], map: "TusCalendarRule_tenantId_calendarId_idx")
  @@map("TusCalendarRule")
}

model ExcepcionCalendario {
  id            String   @id(map: "TusCalendarException_pkey")
  tenantId      String   @map("tenantId")
  calendarioId  String   @map("calendarId")
  fechaInicio   DateTime @map("startsAt")
  fechaFin      DateTime @map("endsAt")
  motivo        String   @map("reason")
  estado        String   @map("status")
  fechaCreacion DateTime @map("createdAt")

  @@unique([tenantId, id], map: "TusCalendarException_tenantId_id_key")
  @@index([tenantId, calendarioId, fechaInicio, fechaFin], map: "TusCalendarException_tenantId_calendarId_startsAt_endsAt_idx")
  @@map("TusCalendarException")
}

model Reserva {
  id            String   @id(map: "TusBooking_pkey")
  tenantId      String   @map("tenantId")
  reservaId     String   @map("bookingId")
  servicioId    String   @map("serviceId")
  calendarioId  String   @map("calendarId")
  clienteId     String   @map("customerId")
  fechaInicio   DateTime @map("startsAt")
  fechaFin      DateTime @map("endsAt")
  estado        String   @map("status")
  version       Int
  fechaCreacion DateTime @map("createdAt")
  fechaActualizacion DateTime @map("updatedAt")

  @@unique([tenantId, reservaId], map: "TusBooking_tenantId_bookingId_key")
  @@index([tenantId, calendarioId, fechaInicio, fechaFin], map: "TusBooking_tenantId_calendarId_startsAt_endsAt_idx")
  @@index([tenantId, clienteId, estado], map: "TusBooking_tenantId_customerId_status_idx")
  @@map("TusBooking")
}

model EventoWebhookPago {
  id                String   @id(map: "TusPaymentWebhookEvent_pkey")
  tenantId          String   @map("tenantId")
  proveedor         String   @map("provider")
  eventoProveedorId String   @map("providerEventId")
  firma             String   @map("signature")
  fechaOcurrencia   DateTime @map("occurredAt")
  datosEvento       Json     @map("payload")
  estado            String   @map("status")
  fechaCreacion     DateTime @map("createdAt")

  @@unique([tenantId, proveedor, eventoProveedorId], map: "TusPaymentWebhookEvent_tenant_provider_event_key")
  @@index([tenantId, estado, fechaOcurrencia], map: "TusPaymentWebhookEvent_tenantId_status_occurredAt_idx")
  @@map("TusPaymentWebhookEvent")
}

model ConsentimientoWhatsApp {
  id                 String   @id(map: "TusWhatsAppConsent_pkey")
  tenantId           String   @map("tenantId")
  destinatarioId     String   @map("recipientId")
  tipoDestinatario   String   @map("recipientType")
  estado             String   @map("status")
  origen             String   @map("source")
  fechaOtorgamiento  DateTime @map("grantedAt")
  fechaRevocacion    DateTime? @map("revokedAt")
  fechaCreacion      DateTime @map("createdAt")
  fechaActualizacion DateTime @map("updatedAt")

  @@unique([tenantId, destinatarioId], map: "TusWhatsAppConsent_tenantId_recipientId_key")
  @@index([tenantId, estado], map: "TusWhatsAppConsent_tenantId_status_idx")
  @@map("TusWhatsAppConsent")
}

model MensajeWhatsApp {
  id                 String   @id(map: "TusWhatsAppMessage_pkey")
  tenantId           String   @map("tenantId")
  mensajeId          String   @map("messageId")
  destinatarioId     String   @map("recipientId")
  plantilla          String   @map("template")
  versionPlantilla   String   @map("templateVersion")
  consentimientoId  String   @map("consentId")
  hashSolicitud      String   @map("requestHash")
  variables          Json?    @map("variables")
  estado             String   @map("status")
  correlacionId      String   @map("correlationId")
  retencionHasta     DateTime? @map("retentionUntil")
  fechaCreacion      DateTime @map("createdAt")
  fechaActualizacion DateTime @map("updatedAt")

  @@unique([tenantId, mensajeId], map: "TusWhatsAppMessage_tenantId_messageId_key")
  @@index([tenantId, destinatarioId, estado], map: "TusWhatsAppMessage_tenantId_recipientId_status_idx")
  @@map("TusWhatsAppMessage")
}

model EventoWebhookWhatsApp {
  id               String   @id(map: "TusWhatsAppWebhookEvent_pkey")
  tenantId         String   @map("tenantId")
  eventoProveedorId String  @map("providerEventId")
  firma            String   @map("signature")
  fechaOcurrencia  DateTime @map("occurredAt")
  estado           String   @map("status")
  fechaCreacion    DateTime @map("createdAt")

  @@unique([tenantId, eventoProveedorId], map: "TusWhatsAppWebhookEvent_tenantId_providerEventId_key")
  @@index([tenantId, estado, fechaOcurrencia], map: "TusWhatsAppWebhookEvent_tenantId_status_occurredAt_idx")
  @@map("TusWhatsAppWebhookEvent")
}

model OutboxWhatsApp {
  id             String   @id(map: "TusWhatsAppOutbox_pkey")
  tenantId       String   @map("tenantId")
  eventoId       String   @map("eventId")
  correlacionId  String   @map("correlationId")
  tipoEvento     String   @map("eventType")
  agregadoId     String   @map("aggregateId")
  datosEvento    Json     @map("payload")
  estado         String   @map("status")
  fechaCreacion  DateTime @map("createdAt")
  retencionHasta DateTime @map("retentionUntil")

  @@unique([tenantId, eventoId], map: "TusWhatsAppOutbox_tenantId_eventId_key")
  @@index([tenantId, estado, fechaCreacion], map: "TusWhatsAppOutbox_tenantId_status_createdAt_idx")
  @@index([tenantId, correlacionId], map: "TusWhatsAppOutbox_tenantId_correlationId_idx")
  @@map("TusWhatsAppOutbox")
}

model TusInvoice {
  id            String   @id
  tenantId      String
  invoiceId     String
  accountId     String   @default("")
  commitmentId  String
  paymentId     String   @default("")
  orderId       String   @default("")
  posOperationId String?
  currency      String
  subtotal      BigInt
  taxAmount     BigInt
  feeAmount     BigInt
  total         BigInt
  subtotalMinor BigInt   @default(0)
  taxMinor      BigInt   @default(0)
  feeMinor      BigInt   @default(0)
  totalMinor    BigInt   @default(0)
  status        String
  number        String?
  invoiceType   String   @default("commercial")
  taxReference  String?
  taxSnapshot   Json?
  snapshotVersion Int    @default(1)
  issuedAt      DateTime?
  createdAt     DateTime
  updatedAt     DateTime
  lines         TusInvoiceLine[]

  @@unique([tenantId, invoiceId])
  @@index([tenantId, commitmentId, status])
}

model TusInvoiceLine {
  id          String   @id
  tenantId    String
  invoiceId   String
  lineId      String   @default("")
  description String
  quantity    Int
  unitMinor   BigInt
  taxMinor    BigInt
  totalMinor  BigInt
  currency    String   @default("ARS")
  snapshot    Json?
  createdAt   DateTime
  invoice     TusInvoice @relation(fields: [tenantId, invoiceId], references: [tenantId, invoiceId])

  @@unique([tenantId, id])
  @@index([tenantId, invoiceId])
}

model TusCreditNote {
  id           String   @id
  tenantId     String
  creditNoteId String
  invoiceId    String
  paymentId    String   @default("")
  orderId      String   @default("")
  posOperationId String?
  currency     String
  amountMinor  BigInt
  reason       String
  status       String
  createdAt    DateTime

  @@unique([tenantId, creditNoteId])
  @@index([tenantId, invoiceId, status])
}

model TusSubscription {
  id             String   @id
  tenantId       String
  subscriptionId String
  customerId     String
  planId         String   @default("")
  planSnapshot   Json?
  currency       String
  amountMinor    BigInt
  interval       String
  status         String
  dunningAttempt Int      @default(0)
  cancelReason   String?
  cancelledAt    DateTime?
  createdAt      DateTime
  updatedAt      DateTime

  @@unique([tenantId, subscriptionId])
  @@index([tenantId, customerId, status])
}

model TusTaxProfile {
  id            String   @id
  tenantId      String
  partyId       String
  taxIdentity   String
  taxCategory   String
  status        String
  evidenceRef   String
  authority     String   @default("ARCA/AFIP-external")
  ivaTreatment  String?
  withholdingTreatment String?
  externalApprovalReference String?
  createdAt     DateTime
  updatedAt     DateTime

  @@unique([tenantId, partyId])
  @@index([tenantId, status])
}

model TusBillingAccount {
  id               String   @id
  tenantId         String
  billingAccountId String
  partyId          String
  role             String
  status           String
  createdAt        DateTime
  updatedAt        DateTime

  @@unique([tenantId, billingAccountId])
  @@index([tenantId, partyId, status])
}

model TusSubscriptionPlan {
  id         String   @id
  tenantId   String
  planId     String
  name       String
  amountMinor BigInt
  currency   String
  interval   String
  status     String
  createdAt  DateTime
  updatedAt  DateTime

  @@unique([tenantId, planId])
  @@index([tenantId, status])
}

model TusBillingRefund {
  id            String   @id
  tenantId      String
  refundId      String
  invoiceId     String
  paymentId     String
  orderId       String
  posOperationId String?
  currency      String
  amountMinor   BigInt
  reason        String
  status        String
  createdAt     DateTime

  @@unique([tenantId, refundId])
  @@index([tenantId, invoiceId])
}

model TusBillingLedger {
  id            String   @id
  tenantId      String
  entryId       String
  invoiceId     String
  entryType     String
  amountMinor   BigInt
  currency      String
  linkedEntryId String?
  creditNoteId  String?
  refundId      String?
  paymentId     String
  orderId       String
  posOperationId String?
  immutable     Boolean  @default(true)
  createdAt     DateTime

  @@unique([tenantId, entryId])
  @@index([tenantId, invoiceId, createdAt])
}

model TusBillingIdempotency {
  id          String   @id
  tenantId    String
  key         String
  requestHash String
  response    Json
  createdAt   DateTime @default(now())

