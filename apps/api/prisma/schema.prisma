// Argentina launch baseline. These records are PostgreSQL-owned and every
// tenant-owned identity is scoped by tenantId in its unique keys and indexes.
model TusTenant {
  id        String   @id
  slug      String
  name      String
  status    String
  createdAt DateTime
  updatedAt DateTime

  @@unique([slug])
  @@index([status, createdAt])
}

