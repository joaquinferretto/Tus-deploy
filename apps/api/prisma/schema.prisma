generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(uuid())
  email           String       @unique
  normalizedEmail String       @unique
  displayName     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  accounts        Account[]
  memberships     Membership[]
}

model Account {
  id                 String               @id
  userId             String
  tenantId           String
  roles              String[]             @default([])
  status             String
  emailVerifiedAt    DateTime?
  createdAt          DateTime
  updatedAt          DateTime
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentials        PasswordCredential[]
  verificationTokens VerificationToken[]
  recoveryTokens     RecoveryToken[]
  devices            Device[]
  sessions           Session[]

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model PasswordCredential {
  id           String    @id
  accountId    String    @unique
  passwordHash String
  status       String
  createdAt    DateTime
  updatedAt    DateTime
  lastUsedAt   DateTime?
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id          String    @id
  accountId   String
  tokenDigest String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model RecoveryToken {
  id          String    @id
  accountId   String
  tokenDigest String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Device {
  id          String   @id @default(uuid())
  accountId   String
  deviceId    String
  label       String
  firstSeenAt DateTime
  lastSeenAt  DateTime
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, deviceId], name: "accountId_deviceId")
  @@index([accountId])
}

model Session {
  id                String    @id
  accountId         String
  tenantId          String
  deviceId          String
  accessTokenDigest String    @unique
  roles             String[]  @default([])
  permissions       String[]  @default([])
  createdAt         DateTime
  expiresAt         DateTime
  revokedAt         DateTime?
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt])
  @@index([tenantId])
}

// P2.1 relational source-of-truth records. MongoDB, Redis, queues, and
// object storage may receive projections or delivery state, but never own
// these records.
model Organization {
  id                 String       @id
  name               String
  slug               String       @default("")
  defaultWorkspaceId String       @default("")
  createdAt          DateTime
  updatedAt          DateTime
  workspaces         Workspace[]
  memberships        Membership[]

  @@index([createdAt])
}

model Workspace {
  id             String       @id
  organizationId String
  name           String
  slug           String
  createdAt      DateTime
  updatedAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Membership {
  id             String       @id
  organizationId String
  workspaceId    String
  userId         String
  role           String
  roleIds        String[]     @default([])
  status         String
  createdAt      DateTime
  updatedAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([organizationId, userId])
  @@index([workspaceId, status])
}

model TenantRole {
  id             String   @id
  tenantId       String
  name           String
  permissions    String[]
  resourceScopes String[]
  createdAt      DateTime

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Invitation {
  id          String    @id
  tenantId    String
  email       String
  roleIds     String[]
  tokenDigest String    @unique
  status      String
  expiresAt   DateTime
  createdAt   DateTime
  acceptedAt  DateTime?

  @@index([tenantId, status])
}

model TenantResource {
  id       String @id
  tenantId String
  type     String
  value    String

  @@index([tenantId, type])
}

model AuditEvent {
  id             String    @id
  tenantId       String
  actorId        String?
  correlationId  String
  eventType      String
  outcome        String
  metadata       Json
  occurredAt     DateTime
  retentionUntil DateTime?

  @@index([tenantId, occurredAt])
  @@index([correlationId])
  @@index([eventType, occurredAt])
}

model SearchRecord {
  id            String   @id
  tenantId      String
  entityType    String
  entityId      String
  searchText    String
  payload       Json?
  sourceVersion Int
  createdAt     DateTime
  updatedAt     DateTime

  @@unique([tenantId, entityType, entityId])
  @@index([tenantId, entityType])
  @@index([updatedAt])
}

model AggregateSnapshot {
  id            String   @id
  tenantId      String
  aggregateType String
  aggregateId   String
  version       Int
  state         Json
  createdAt     DateTime
  updatedAt     DateTime

  @@unique([tenantId, aggregateType, aggregateId])
  @@index([tenantId, aggregateType, version])
}

model QuotaAccount {
  id           String             @id
  tenantId     String
  metric       String
  limit        Int
  used         Int                @default(0)
  reserved     Int                @default(0)
  createdAt    DateTime
  updatedAt    DateTime
  reservations QuotaReservation[]

  @@unique([tenantId, metric])
  @@index([tenantId, updatedAt])
}

model QuotaReservation {
  id             String       @id
  quotaAccountId String
  idempotencyKey String
  units          Int
  status         String
  expiresAt      DateTime
  createdAt      DateTime
  quotaAccount   QuotaAccount @relation(fields: [quotaAccountId], references: [id], onDelete: Cascade)

  @@unique([quotaAccountId, idempotencyKey])
  @@index([quotaAccountId, status])
  @@index([expiresAt, status])
}

model IdempotencyRecord {
  id          String   @id
  tenantId    String
  key         String
  requestHash String
  status      String
  response    Json?
  createdAt   DateTime
  expiresAt   DateTime

  @@unique([tenantId, key])
  @@index([expiresAt])
}

model OutboxEvent {
  id            String    @id
  tenantId      String
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        String
  attempts      Int       @default(0)
  availableAt   DateTime
  lastError     String?
  createdAt     DateTime
  publishedAt   DateTime?
  claimId       String?
  claimUntil    DateTime?

  @@index([status, availableAt])
  @@index([status, availableAt, claimUntil])
  @@index([tenantId, status, claimUntil])
  @@index([tenantId, aggregateType, aggregateId])
  @@index([createdAt])
}

model RunLedger {
  id             String   @id
  tenantId       String
  idempotencyKey String
  requestHash    String
  runType        String
  status         String
  input          Json
  result         Json?
  error          Json?
  createdAt      DateTime
  updatedAt      DateTime

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, updatedAt])
}

model OwnershipRecord {
  id              String   @id @default(uuid())
  dataClass       String   @unique
  owner           String
  rebuildStrategy String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// PostgreSQL/PGVector owns retrieval metadata and vectors. B2 lineage remains
// the rebuild source; this table is never a durable source-document store.
model RagEmbedding {
  id               String                @id
  tenantId         String
  workspaceId      String
  sourceId         String
  chunkId          String
  chunkIndex       Int
  embeddingModel   String
  embeddingVersion String
  indexVersion     String
  vector           Unsupported("vector")
  sourceChecksum   String
  sourceUri        String
  parserVersion    String
  chunkerVersion   String
  retentionUntil   DateTime?
  metadata         Json
  createdAt        DateTime
  updatedAt        DateTime

  @@unique([tenantId, sourceId, chunkIndex, embeddingVersion, indexVersion])
  @@index([tenantId, indexVersion])
  @@index([tenantId, sourceId])
}

// P4.3 owns the auditable, versioned AI catalog. Registry APIs must enforce
// tenant scope before reaching these relational records.
model PromptDefinition {
  id          String          @id
  tenantId    String
  key         String
  owner       String
  description String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  versions    PromptVersion[]
  rollouts    Rollout[]

  @@unique([tenantId, key])
  @@index([tenantId, updatedAt])
}

model PromptVersion {
  id               String           @id
  tenantId         String
  promptId         String
  version          Int
  template         String
  checksum         String
  status           String
  createdBy        String
  approvedBy       String?
  deprecatedReason String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  prompt           PromptDefinition @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([tenantId, promptId, version])
  @@index([tenantId, promptId, status])
}

model ModelDefinition {
  id           String              @id
  tenantId     String
  key          String
  provider     String
  modelName    String
  owner        String
  status       String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  availability ModelAvailability[]
  rollouts     Rollout[]

  @@unique([tenantId, key])
  @@index([tenantId, provider, status])
}

model ModelAvailability {
  id         String          @id
  tenantId   String
  modelId    String
  status     String
  reason     String
  observedAt DateTime
  model      ModelDefinition @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([tenantId, modelId])
  @@index([tenantId, status, observedAt])
}

model Rollout {
  id                String           @id
  tenantId          String
  promptId          String
  promptVersion     Int
  modelId           String
  percentage        Int
  state             String
  createdBy         String
  rolloutVersion    Int
  previousRolloutId String?
  failureReason     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  prompt            PromptDefinition @relation(fields: [promptId], references: [id], onDelete: Cascade)
  model             ModelDefinition  @relation(fields: [modelId], references: [id], onDelete: Restrict)

  @@index([tenantId, promptId, state])
  @@index([tenantId, modelId, state])
}

model Approval {
  id           String    @id
  tenantId     String
  resourceType String
  resourceId   String
  requestedBy  String
  status       String
  approverId   String?
  reason       String
  createdAt    DateTime  @default(now())
  decidedAt    DateTime?

  @@index([tenantId, resourceType, resourceId, status])
}

model RegistryAudit {
  id            String   @id
  tenantId      String
  actorId       String
  correlationId String
  action        String
  resourceType  String
  resourceId    String
  version       Int?
  outcome       String
  metadata      Json
  occurredAt    DateTime @default(now())

  @@index([tenantId, occurredAt])
  @@index([tenantId, resourceType, resourceId, occurredAt])
  @@index([correlationId])
}

model EvidenciaHabilitacion {
  id                  String    @id
  contractVersion     String    @default("1.0.0") @map("version_contrato")
  tenantId            String    @map("tenant_id")
  capability          String    @map("capacidad")
  gate                String    @map("requisito")
  owner               String    @map("propietario")
  scope               String    @map("alcance")
  tipoEvidencia       String    @map("tipo_evidencia")
  referenciaEvidencia String    @map("referencia_evidencia")
  policyVersion       String    @map("version_politica")
  issuedAt            DateTime  @map("fecha_emision")
  expiresAt           DateTime? @map("fecha_expiracion")
  revoked             Boolean   @default(false) @map("revocada")
  source              String    @map("origen")
  profile             String    @default("legacy-unscoped") @map("perfil")
  execution           String    @default("live") @map("ejecucion")
  evidenceClass       String    @default("deferred") @map("clase_evidencia")
  liveConformance     Boolean   @default(false) @map("conformidad_produccion")
  createdAt           DateTime  @map("fecha_creacion")
  updatedAt           DateTime  @map("fecha_actualizacion")

  @@unique([tenantId, capability, gate, referenciaEvidencia], map: "uq_evidencias_hab_tenant_requisito_ref")
  @@index([tenantId, capability, gate, revoked], map: "idx_evidencias_hab_tenant_requisito_revocada")
  @@index([expiresAt], map: "idx_evidencias_hab_fecha_expiracion")
  @@map("evidencias_habilitacion")
}

model DecisionHabilitacion {
  id                    String   @id
  tenantId              String   @map("tenant_id")
  capability            String   @map("capacidad")
  evaluatedAt           DateTime @map("fecha_evaluacion")
  enabled               Boolean  @map("habilitada")
  resultadoHabilitacion String   @map("resultado_habilitacion")
  requisitosFallidos    Json     @map("requisitos_fallidos")
  idsEvidencia          String[] @map("ids_evidencia")
  deterministic         Boolean  @map("determinista")
  conflicts             Json?    @map("conflictos")
  reason                String?  @map("motivo")
  evidencePreserved     Boolean? @map("evidencia_preservada")
  auditPreserved        Boolean? @map("auditoria_preservada")
  actorId               String   @default("legacy") @map("actor_id")
  jobId                 String?  @map("trabajo_id")
  correlationId         String   @default("legacy") @map("correlacion_id")
  profile               String   @default("legacy-unscoped") @map("perfil")
  scope                 String   @default("legacy") @map("alcance")
  outcome               String   @default("blocked") @map("resultado")
  createdAt             DateTime @map("fecha_creacion")

  @@index([tenantId, capability, evaluatedAt], map: "idx_decisiones_hab_tenant_capacidad_evaluacion")
  @@index([tenantId, capability, enabled], map: "idx_decisiones_hab_tenant_capacidad_habilitada")
  @@index([tenantId, correlationId], map: "idx_decisiones_hab_tenant_correlacion")
  @@map("decisiones_habilitacion")
}

// TUS commerce source-of-truth records. Every query and unique key is tenant
// scoped; projections and provider adapters must not own these aggregates.
model Compromiso {
  id                 String   @id(map: "compromisos_pkey")
  versionContrato    String   @map("version_contrato")
  compromisoId       String   @map("compromiso_id")
  carritoId          String   @map("carrito_id")
  tenantId           String   @map("tenant_id")
  prestadorId        String   @map("prestador_id")
  contexto           String   @map("contexto")
  monto              BigInt   @map("monto")
  moneda             String   @map("moneda")
  estado             String   @map("estado")
  idsLineas          String[] @map("ids_lineas")
  version            Int      @default(1)
  fechaCreacion      DateTime @map("fecha_creacion")
  fechaActualizacion DateTime @map("fecha_actualizacion")

  prestador                 Prestador                @relation(fields: [tenantId, prestadorId], references: [tenantId, prestadorId], onDelete: Restrict, onUpdate: NoAction, map: "fk_compromisos_prestadores")
  transiciones              TransicionCompromiso[]
  compensaciones            CompensacionCompromiso[]
  intencionesPago           IntencionPago[]
  instantaneasComision      InstantaneaComision[]
  movimientosContables      MovimientoContable[]
  evidenciasFinancieras     EvidenciaFinanciera[]
  confirmacionesFinancieras ConfirmacionFinanciera[]
  bloqueosFinancieros       BloqueoFinanciero[]
  registrosConciliacion     RegistroConciliacion[]
  facturas                  Factura[]

  @@unique([tenantId, compromisoId], map: "uq_compromisos_tenant_compromiso")
  @@index([tenantId, fechaCreacion], map: "idx_compromisos_tenant_fecha_creacion")
  @@index([tenantId, carritoId], map: "idx_compromisos_tenant_carrito")
  @@map("compromisos")
}

model TransicionCompromiso {
  id             String   @id(map: "transiciones_compromiso_pkey")
  tenantId       String   @map("tenant_id")
  compromisoId   String   @map("compromiso_id")
  estadoAnterior String   @map("estado_anterior")
  estadoNuevo    String   @map("estado_nuevo")
  version        Int
  actorId        String   @map("actor_id")
  correlacionId  String   @map("correlacion_id")
  motivo         String   @map("motivo")
  fechaCreacion  DateTime @map("fecha_creacion")

  compromiso Compromiso @relation(fields: [tenantId, compromisoId], references: [tenantId, compromisoId], onDelete: Restrict, onUpdate: NoAction, map: "fk_transiciones_compromiso_compromisos")

  @@unique([tenantId, compromisoId, version], map: "uq_transiciones_tenant_compromiso_version")
  @@index([tenantId, compromisoId, fechaCreacion], map: "idx_transiciones_tenant_compromiso_fecha_creacion")
  @@map("transiciones_compromiso")
}

model CompensacionCompromiso {
  id             String   @id(map: "compensaciones_compromiso_pkey")
  compensacionId String   @map("compensacion_id")
  tenantId       String   @map("tenant_id")
  compromisoId   String   @map("compromiso_id")
  actorId        String   @map("actor_id")
  correlacionId  String   @map("correlacion_id")
  monto          BigInt   @map("monto")
  moneda         String   @map("moneda")
  motivo         String   @map("motivo")
  fechaCreacion  DateTime @map("fecha_creacion")

  compromiso Compromiso @relation(fields: [tenantId, compromisoId], references: [tenantId, compromisoId], onDelete: Restrict, onUpdate: NoAction, map: "fk_compensaciones_compromiso_compromisos")

  @@unique([tenantId, compensacionId], map: "uq_compensaciones_tenant_compensacion")
  @@unique([tenantId, compromisoId], map: "uq_compensaciones_tenant_compromiso")
  @@index([tenantId, compromisoId, fechaCreacion], map: "idx_compensaciones_tenant_compromiso_fecha_creacion")
  @@map("compensaciones_compromiso")
}

model ReferenciaAuditoria {
  id             String   @id(map: "referencias_auditoria_pkey")
  referenciaId   String   @map("referencia_id")
  tenantId       String   @map("tenant_id")
  actorId        String   @map("actor_id")
  correlacionId  String   @map("correlacion_id")
  compromisoId   String   @map("compromiso_id")
  tipoReferencia String   @map("tipo_referencia")
  metadatos      Json?    @map("metadatos")
  fechaCreacion  DateTime @map("fecha_creacion")

  @@unique([tenantId, referenciaId], map: "uq_referencias_tenant_referencia")
  @@index([tenantId, compromisoId, fechaCreacion], map: "idx_referencias_tenant_compromiso_fecha_creacion")
  @@index([tenantId, correlacionId], map: "idx_referencias_tenant_correlacion")
  @@map("referencias_auditoria")
}

model Prestador {
  id                       String        @id(map: "prestadores_pkey")
  tenantId                 String        @map("tenant_id")
  prestadorId              String        @map("prestador_id")
  cohorte                  String        @map("cohorte")
  ubicacionId              String        @map("ubicacion_id")
  zonaHoraria              String        @map("zona_horaria")
  rolesPersonal            String[]      @map("roles_personal")
  versionPoliticaOperativa String        @map("version_politica_operativa")
  estado                   String        @map("estado")
  fechaCreacion            DateTime      @map("fecha_creacion")
  fechaActualizacion       DateTime      @map("fecha_actualizacion")
  publicaciones            Publicacion[]
  calendarios              Calendario[]

  compromisos Compromiso[]
  trabajos    Trabajo[]

  @@unique([tenantId, prestadorId], map: "uq_prestadores_tenant_prestador")
  @@index([tenantId, estado], map: "idx_prestadores_tenant_estado")
  @@map("prestadores")
}

model Publicacion {
  id                      String   @id(map: "publicaciones_pkey")
  versionContrato         String   @map("version_contrato")
  tenantId                String   @map("tenant_id")
  prestadorId             String   @map("prestador_id")
  tipo                    String   @map("tipo")
  nombre                  String   @map("nombre")
  descripcion             String   @map("descripcion")
  cohorte                 String   @map("cohorte")
  ubicacionId             String   @map("ubicacion_id")
  moneda                  String   @map("moneda")
  precio                  BigInt   @map("precio")
  versionDisponibilidad   Int      @map("version_disponibilidad")
  publicada               Boolean  @map("publicada")
  versionPolitica         String   @map("version_politica")
  existencias             Int?     @map("existencias")
  duracionMinutos         Int?     @map("duracion_minutos")
  capacidad               Int?     @map("capacidad")
  modalidadReserva        String?  @map("modalidad_reserva")
  duracionEstimadaMinutos Int?     @map("duracion_estimada_minutos")
  modalidadPrecio         String?  @map("modalidad_precio")
  horarioTrabajo          Json     @map("horario_trabajo")
  fechaCreacion           DateTime @map("fecha_creacion")
  fechaActualizacion      DateTime @map("fecha_actualizacion")

  compromisosMercadoServicios CompromisoMercadoServicios[]
  trabajos                    Trabajo[]
  reservas                    Reserva[]
  prestador                   Prestador                    @relation(fields: [tenantId, prestadorId], references: [tenantId, prestadorId], onDelete: Restrict, onUpdate: NoAction, map: "fk_publicaciones_prestadores")

  @@unique([tenantId, id], map: "uq_publicaciones_tenant_id")
  @@index([tenantId, publicada], map: "idx_publicaciones_tenant_publicada")
  @@index([tenantId, versionDisponibilidad], map: "idx_publicaciones_tenant_version_disponibilidad")
  @@index([prestadorId, tipo], map: "idx_publicaciones_prestador_tipo")
  @@map("publicaciones")
}

model CompromisoMercadoServicios {
  id                    String    @id(map: "compromisos_mercado_servicios_pkey")
  versionContrato       String    @map("version_contrato")
  compromisoId          String    @map("compromiso_id")
  carritoId             String    @map("carrito_id")
  tenantId              String    @map("tenant_id")
  prestadorTenantId     String    @map("prestador_tenant_id")
  prestadorId           String    @map("prestador_id")
  publicacionId         String    @map("publicacion_id")
  contexto              String    @map("contexto")
  idsLineas             String[]  @map("ids_lineas")
  cantidad              Int       @map("cantidad")
  monto                 BigInt    @map("monto")
  moneda                String    @map("moneda")
  estado                String    @map("estado")
  versionDisponibilidad Int       @map("version_disponibilidad")
  versionPolitica       String    @map("version_politica")
  franjaInicio          DateTime? @map("franja_inicio")
  franjaFin             DateTime? @map("franja_fin")
  fechaCreacion         DateTime  @map("fecha_creacion")
  fechaActualizacion    DateTime  @map("fecha_actualizacion")

  publicacion Publicacion @relation(fields: [prestadorTenantId, publicacionId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "fk_compromisos_mercado_servicios_publicaciones")
  trabajos    Trabajo[]

  @@unique([tenantId, compromisoId], map: "uq_compromisos_ms_tenant_compromiso")
  @@unique([tenantId, compromisoId, prestadorTenantId, prestadorId, publicacionId], map: "uq_compromisos_ms_tenant_proveedor_publicacion")
  @@index([tenantId, fechaCreacion], map: "idx_compromisos_ms_tenant_fecha_creacion")
  @@index([publicacionId, franjaInicio, franjaFin], map: "idx_compromisos_ms_publicacion_franja")
  @@index([prestadorId, contexto, estado], map: "idx_compromisos_ms_prestador_contexto_estado")
  @@map("compromisos_mercado_servicios")
}

model Trabajo {
  id                         String   @id(map: "trabajos_pkey")
  versionContrato            String   @map("version_contrato")
  trabajoId                  String   @map("trabajo_id")
  tenantId                   String   @map("tenant_id")
  prestadorTenantId          String   @map("prestador_tenant_id")
  compromisoId               String   @map("compromiso_id")
  prestadorId                String   @map("prestador_id")
  publicacionId              String   @map("publicacion_id")
