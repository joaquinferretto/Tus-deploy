model Calendario {
  id          String   @id(map: "TusCalendar_pkey")
  tenantId    String   @map("tenantId")
  servicioId  String   @map("serviceId")
  nombre      String   @map("name")
  zonaHoraria String   @map("timezone")
  estado      String   @map("status")
  fechaCreacion DateTime @map("createdAt")
  fechaActualizacion DateTime @map("updatedAt")

  @@unique([tenantId, id], map: "TusCalendar_tenantId_id_key")
  @@index([tenantId, servicioId, estado], map: "TusCalendar_tenantId_serviceId_status_idx")
  @@map("TusCalendar")
}

model ReglaCalendario {
  id            String   @id(map: "TusCalendarRule_pkey")
  tenantId      String   @map("tenantId")
  calendarioId  String   @map("calendarId")
  diaSemana     Int      @map("weekday")
  horaInicio    String   @map("startsAt")
  horaFin       String   @map("endsAt")
  capacidad     Int      @map("capacity")
  fechaCreacion DateTime @map("createdAt")
  fechaActualizacion DateTime @map("updatedAt")

  @@unique([tenantId, calendarioId, diaSemana, horaInicio, horaFin], map: "TusCalendarRule_tenantId_calendarId_weekday_startsAt_endsAt_key")
  @@index([tenantId, calendarioId], map: "TusCalendarRule_tenantId_calendarId_idx")
  @@map("TusCalendarRule")
}

model ExcepcionCalendario {
  id            String   @id(map: "TusCalendarException_pkey")
  tenantId      String   @map("tenantId")
  calendarioId  String   @map("calendarId")
  fechaInicio   DateTime @map("startsAt")
  fechaFin      DateTime @map("endsAt")
  motivo        String   @map("reason")
  estado        String   @map("status")
  fechaCreacion DateTime @map("createdAt")

  @@unique([tenantId, id], map: "TusCalendarException_tenantId_id_key")
  @@index([tenantId, calendarioId, fechaInicio, fechaFin], map: "TusCalendarException_tenantId_calendarId_startsAt_endsAt_idx")
  @@map("TusCalendarException")
}

model Reserva {
  id            String   @id(map: "TusBooking_pkey")
  tenantId      String   @map("tenantId")
  reservaId     String   @map("bookingId")
  servicioId    String   @map("serviceId")
  calendarioId  String   @map("calendarId")
