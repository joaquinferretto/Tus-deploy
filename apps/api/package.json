{
  "name": "@factory/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node ../../scripts/build-api.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint src/providers/whatsapp/index.ts src/tus/whatsapp/index.ts --max-warnings 0",
    "lint:security": "eslint . --ext .ts --config .eslintrc.security.json",
    "test": "node ../../scripts/test-runner.mjs tests/foundation/p12-deployment-operations.test.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "node ../../scripts/prisma-validate.mjs",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@factory/config": "workspace:*",
    "@factory/contracts": "workspace:*",
    "@factory/errors": "workspace:*",
    "@factory/observability": "workspace:*",
    "@factory/zod-schemas": "workspace:*",
    "@prisma/client": "^5.10.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "mongoose": "^8.2.1",
    "opossum": "^8.1.4",
    "pg": "^8.11.3",
    "playwright-core": "1.59.1",
    "prisma": "^5.10.2",
    "rate-limit-redis": "^4.2.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@factory/eslint-config": "workspace:*",
    "@factory/typescript-config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.2",
    "eslint": "^8.56.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
