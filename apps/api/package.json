    "cors": "^2.8.5",
    "zod": "^3.22.4",
    "opossum": "^8.1.4",
    "@prisma/client": "^5.10.2",
    "prisma": "^5.10.2",
    "pg": "^8.11.3",
    "mongoose": "^8.2.1",
    "ioredis": "^5.3.2",
    "dotenv": "^16.4.5",
    "@repo/zod-schemas": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.2",
    "eslint": "^8.56.0",
    "eslint-plugin-security": "^3.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
