Table facturas {
  id varchar [pk]
  tenant_id varchar
  factura_id varchar
  account_id varchar [note: '@default ""; [LOGICA] referencia a cuenta de facturación']
  compromiso_id varchar [note: 'FK objetivo -> compromisos (RESTRICT); hoy permite ""']
  pago_id varchar [note: '@default ""; [LOGICA]']
  order_id varchar [note: '@default ""; [LOGICA]']
  pos_operation_id varchar [null, note: '[LOGICA]']
  currency varchar
  subtotal bigint
  tax_amount bigint
  fee_amount bigint
  total bigint
  subtotal_minor bigint
  tax_minor bigint
  fee_minor bigint
  total_minor bigint
  status varchar
  number varchar [null]
  invoice_type varchar
  tax_reference varchar [null]
  tax_snapshot json [null, note: '[HISTORICA] snapshot fiscal']
  snapshot_version int
  issued_at timestamp [null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (tenant_id, factura_id) [unique, name: 'uq_facturas_tenant_factura']
    (tenant_id, compromiso_id, status) [name: 'idx_facturas_tenant_compromiso_status']
  }

  Note: '[HISTORICA] append-only (trigger). Documento fiscal. FK objetivo compromiso_id -> compromisos, RESTRICT.'
}

Table lineas_factura {
