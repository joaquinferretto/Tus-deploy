// ============================================================
// REPORTING
// ============================================================

Table registros_operaciones {
  id varchar [pk]
  tenant_id varchar
  contexto varchar [note: 'ex context']
  canal varchar [note: 'ex channel']
  geografia varchar [note: 'ex geography']
  resultado varchar [note: 'ex outcome']
  monto bigint [note: 'ex amount']
  moneda varchar [note: 'ex currency']
  estado_contable varchar [note: 'ex ledgerStatus']
  acciones_whatsapp int [note: 'ex whatsappActions']
  disputas int [note: 'ex disputes']
  pos_fuera_linea int [note: 'ex posOffline']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, fecha_creacion) [name: 'idx_registros_operaciones_tenant_fecha_creacion']
    (tenant_id, contexto, canal, geografia) [name: 'idx_registros_operaciones_tenant_contexto_canal_geografia']
  }

  Note: 'RegistroOperaciones = métrica operativa (reporting). Sin FK.'
}

// ============================================================
// TRABAJO Y PRESUPUESTO WEB-08A/B
// ============================================================

Table liquidaciones_servicio {
  id varchar [pk]
  version_contrato varchar
  liquidacion_id varchar
  tenant_id varchar
  prestador_tenant_id varchar
  obligacion_id varchar
  trabajo_id varchar
  monto_bruto bigint
  monto_comision bigint
  monto_neto bigint [note: 'monto_comision + monto_neto = monto_bruto']
  moneda varchar
  estado varchar [note: 'held | eligible | frozen | reversed']
  motivo varchar
  estado_desembolso varchar [note: "siempre 'not_executed' (CHECK)"]
  version int
  fecha_creacion timestamp
  fecha_actualizacion timestamp

  indexes {
    (tenant_id, liquidacion_id) [unique, name: 'uq_liquidaciones_servicio_tenant_liquidacion']
    (tenant_id, obligacion_id) [unique, name: 'uq_liquidaciones_servicio_tenant_obligacion']
    (prestador_tenant_id, estado) [name: 'idx_liquidaciones_servicio_prestador_estado']
  }

  Note: 'WEB-09C: liquidacion interna; no representa payout.'
}

Table conciliaciones_servicio {
  id varchar [pk]
  version_contrato varchar
  conciliacion_id varchar
  tenant_id varchar
  prestador_tenant_id varchar
  obligacion_id varchar
  estado varchar [note: 'matched | discrepancy | pending']
  hallazgos json
  monto_esperado bigint
  moneda varchar
  actor_id varchar
  correlacion_id varchar
  fecha_creacion timestamp

  Note: 'WEB-09C: corridas append-only (trigger).'
}

Table reembolsos_servicio {
  id varchar [pk]
  version_contrato varchar
  reembolso_id varchar
  tenant_id varchar
  prestador_tenant_id varchar
  obligacion_id varchar
  pago_id varchar
  intento int
  monto bigint [note: '> 0; solo reembolso total']
  moneda varchar
  estado varchar [note: 'requested | submitted | requires_review | failed']
  referencia_reembolso_proveedor varchar [null, note: '[EXTERNA] id de reembolso de Mercado Pago']
  error_proveedor varchar [null, note: 'codigo seguro, por ejemplo INSUFFICIENT_SELLER_FUNDS']
  motivo varchar
  clave_idempotencia varchar
  actor_id varchar
  correlacion_id varchar
  version int
  fecha_creacion timestamp
  fecha_actualizacion timestamp

  indexes {
    (tenant_id, reembolso_id) [unique, name: 'uq_reembolsos_servicio_tenant_reembolso']
    (tenant_id, clave_idempotencia) [unique, name: 'uq_reembolsos_servicio_tenant_clave']
    (tenant_id, pago_id, intento) [unique, name: 'uq_reembolsos_servicio_pago_intento']
  }

  Note: 'WEB-09E: intentos de reembolso via el vendedor (Split 1:1). FK (tenant_id, pago_id, obligacion_id) -> intenciones_pago RESTRICT. El dinero cambia solo por webhook verificado.'
}

Ref: reembolsos_servicio.(tenant_id, pago_id, obligacion_id) > intenciones_pago.(tenant_id, pago_id, obligacion_id) [delete: restrict]

Table politicas_comision_servicio {
  id varchar [pk]
  politica_id varchar [unique]
  alcance varchar [note: 'global | categoria | prestador']
  alcance_ref varchar [null, note: 'NULL solo para global; categoria = cohorte de la publicacion; prestador = prestador_id']
  clave_alcance varchar [note: 'global | categoria:<ref> | prestador:<ref> (CHECK)']
  version int
  tasa_puntos_base int [note: '0..3000 bp (CHECK)']
  version_regla varchar
  fee_psp_a_cargo varchar [note: 'undetermined | provider | platform']
  motivo varchar
  actor_id varchar
  correlacion_id varchar
  fecha_creacion timestamp

  indexes {
    (clave_alcance, version) [unique, name: 'uq_politicas_comision_clave_version']
  }

  Note: 'WEB-09D: politica de comision versionada, append-only (trigger). Global de plataforma, sin tenant.'
}

Table configuraciones_pagos_servicio {
  id varchar [pk]
  configuracion_id varchar [unique]
  version int [unique]
  pagos_habilitados boolean
  proveedor varchar [note: 'mercado-pago (CHECK)']
  moneda varchar
  motivo varchar
  actor_id varchar
  correlacion_id varchar
  fecha_creacion timestamp

  Note: 'WEB-09D: interruptor de producto de pagos, append-only (trigger). Nunca guarda secretos.'
}

Table cuentas_cobro_prestador {
  id varchar [pk]
  prestador_tenant_id varchar
  proveedor varchar
  estado varchar [note: 'not_connected | connected | revoked | expired | error']
  cuenta_externa_id varchar [null, note: '[EXTERNA] user_id de Mercado Pago']
  modo_productivo boolean [null]
  alcances varchar [note: 'scopes OAuth separados por espacio']
  conectada_en timestamp [null]
  expira_en timestamp [null]
  version int
  actor_id varchar
  correlacion_id varchar
  fecha_creacion timestamp
  fecha_actualizacion timestamp

  indexes {
    (prestador_tenant_id, proveedor) [unique, name: 'uq_cuentas_cobro_prestador_proveedor']
  }

  Note: 'WEB-09D: vinculo OAuth del prestador; solo referencias seguras.'
}

Table credenciales_cuenta_cobro {
  id varchar [pk]
  prestador_tenant_id varchar
  proveedor varchar
  credencial_cifrada text [note: 'AES-256-GCM v1.<iv>.<tag>.<ct>; AAD = tenant; clave fuera de la DB']
  version_clave varchar
  fecha_actualizacion timestamp

  indexes {
    (prestador_tenant_id, proveedor) [unique, name: 'uq_credenciales_cuenta_cobro_prestador']
  }

  Note: 'WEB-09D: tokens OAuth cifrados; se borran al desconectar. Nunca se exponen por HTTP.'
}

Table estados_oauth_cobro {
  id varchar [pk]
  huella_estado varchar [unique, note: 'sha256 hex del state (CHECK)']
  prestador_tenant_id varchar
  actor_id varchar
  proveedor varchar
  verificador_cifrado text [note: 'PKCE code_verifier cifrado']
  expira_en timestamp
  consumido_en timestamp [null, note: 'uso unico: UPDATE ... WHERE consumido_en IS NULL AND expira_en > now()']
  fecha_creacion timestamp

  Note: 'WEB-09D: state OAuth de un solo uso con TTL de 10 minutos.'
}

Table auditoria_finanzas_servicio {
  id varchar [pk]
  tenant_id varchar
  prestador_tenant_id varchar
  obligacion_id varchar
  tipo_recurso varchar
  recurso_id varchar
  accion varchar
  origen varchar [note: 'customer | provider_event | system']
  actor_id varchar
  correlacion_id varchar
  clave_idempotencia varchar [null]
  estado_anterior varchar [null]
  estado_nuevo varchar [null]
  metadatos json
  fecha_creacion timestamp

  Note: 'WEB-09B: auditoria append-only de finanzas de servicio; sin secretos ni raw bodies.'
}

Table obligaciones_pago_servicio {
  id varchar [pk]
  version_contrato varchar
  obligacion_id varchar
  tenant_id varchar [note: 'tenant cliente (igual a trabajos.tenant_id)']
  cliente_id varchar
  prestador_tenant_id varchar
  prestador_id varchar
  publicacion_id varchar
  compromiso_id varchar [note: 'compromisos_mercado_servicios, via FK compuesta a trabajos']
  trabajo_id varchar
  origen_importe varchar [note: 'accepted_budget | fixed_price_commitment']
  presupuesto_id varchar [null]
  presupuesto_version int [null]
  monto bigint [note: 'minor units >= 0']
  moneda varchar [note: 'ISO 4217']
  estado varchar [note: 'pending_payment | paid | refunded | charged_back']
  version int
  actor_id varchar
  correlacion_id varchar
  fecha_creacion timestamp
  fecha_actualizacion timestamp

  indexes {
    (tenant_id, obligacion_id) [unique, name: 'uq_obligaciones_pago_tenant_obligacion']
    (tenant_id, trabajo_id) [unique, name: 'uq_obligaciones_pago_tenant_trabajo', note: '1:1 con Trabajo']
    (tenant_id, obligacion_id, prestador_tenant_id, trabajo_id) [unique, name: 'uq_obligaciones_pago_identidad_prestador']
    (prestador_tenant_id, prestador_id, estado) [name: 'idx_obligaciones_pago_prestador_estado']
    (tenant_id, estado) [name: 'idx_obligaciones_pago_tenant_estado']
  }

  Note: 'WEB-09A: identidad financiera canonica de un servicio WEB-08. No implica cobro ni payout.'
}

Table trabajos {
  id varchar [pk]
  version_contrato varchar
  trabajo_id varchar
  tenant_id varchar [note: 'tenant cliente/compromiso']
  prestador_tenant_id varchar [note: 'tenant del prestador/publicacion/reserva']
  compromiso_id varchar
  prestador_id varchar
  publicacion_id varchar
  reserva_tenant_id varchar [null]
  reserva_id varchar [null]
  cliente_id varchar [null, note: 'EXTERNA/LOGICA']
  estado varchar [note: 'requested | in_diagnosis | budget_pending | accepted | in_progress | completed | cancelled']
  version int
  requiere_presupuesto boolean
  presupuesto_aceptado_id varchar [null]
  presupuesto_aceptado_version int [null]
  fecha_creacion timestamp
  fecha_actualizacion timestamp

  indexes {
    (tenant_id, trabajo_id) [unique, name: 'uq_trabajos_tenant_trabajo']
    (tenant_id, compromiso_id) [unique, name: 'uq_trabajos_tenant_compromiso']
    (tenant_id, trabajo_id, compromiso_id, prestador_tenant_id, prestador_id, publicacion_id) [unique, name: 'uq_trabajos_identidad_financiera']
    (tenant_id, presupuesto_aceptado_id, presupuesto_aceptado_version) [unique, name: 'uq_trabajos_tenant_presupuesto_aceptado']
    (reserva_tenant_id, reserva_id) [unique, name: 'uq_trabajos_reserva']
    (tenant_id, estado) [name: 'idx_trabajos_tenant_estado']
    (prestador_tenant_id, prestador_id, estado) [name: 'idx_trabajos_prestador_estado']
  }

  Note: 'Trabajo = agregado de ejecucion de servicio. tenant_id y prestador_tenant_id pueden ser distintos.'
}

Table diagnosticos {
  id varchar [pk]
  version_contrato varchar
  diagnostico_id varchar
  tenant_id varchar
  trabajo_id varchar
  version int
  estado varchar [note: 'draft | confirmed | cancelled']
  descripcion_original text
  datos_estructurados json [null]
  actor_id varchar
  correlacion_id varchar
  fecha_confirmacion timestamp [null]
  fecha_creacion timestamp
  fecha_actualizacion timestamp

  indexes {
    (tenant_id, diagnostico_id) [unique, name: 'uq_diagnosticos_tenant_diagnostico']
    (tenant_id, trabajo_id, version) [unique, name: 'uq_diagnosticos_tenant_trabajo_version']
    (tenant_id, trabajo_id, estado) [name: 'idx_diagnosticos_tenant_trabajo_estado']
  }
}

Table presupuestos {
  id varchar [pk]
  version_contrato varchar
  presupuesto_id varchar
  tenant_id varchar
  prestador_tenant_id varchar
  trabajo_id varchar
  version int
  estado varchar [note: 'draft | issued | accepted | rejected | expired | cancelled']
  moneda varchar
  monto_total bigint
  alcance text
  fecha_validez timestamp [null]
  creado_por varchar
  correlacion_id varchar
  fecha_creacion timestamp
  fecha_actualizacion timestamp

  indexes {
    (tenant_id, presupuesto_id, version) [unique, name: 'uq_presupuestos_tenant_presupuesto_version']
    (tenant_id, trabajo_id, version) [name: 'idx_presupuestos_tenant_trabajo_version']
  }
}

Table lineas_presupuesto {
  id varchar [pk]
  linea_id varchar
  presupuesto_registro_id varchar
  descripcion text
  cantidad int
  monto_unitario bigint
  monto_total bigint
  orden int
  fecha_creacion timestamp

  indexes {
    (presupuesto_registro_id, linea_id) [unique, name: 'uq_lineas_presupuesto_registro_linea']
    (presupuesto_registro_id, orden) [name: 'idx_lineas_presupuesto_registro_orden']
  }
}

Table aceptaciones_presupuesto {
  id varchar [pk]
  aceptacion_id varchar
  tenant_id varchar
  presupuesto_registro_id varchar
  decision varchar [note: 'accepted | rejected']
  actor_id varchar
  correlacion_id varchar
  motivo text [null]
  fecha_creacion timestamp

  indexes {
    (tenant_id, aceptacion_id) [unique, name: 'uq_aceptaciones_presupuesto_tenant_aceptacion']
    (tenant_id, presupuesto_registro_id) [unique, name: 'uq_aceptaciones_presupuesto_tenant_version']
    (tenant_id, fecha_creacion) [name: 'idx_aceptaciones_presupuesto_tenant_fecha_creacion']
  }
}

Table transiciones_trabajo {
  id varchar [pk]
  tenant_id varchar
  trabajo_id varchar
  estado_anterior varchar [null]
  estado_nuevo varchar
  version int
  actor_id varchar
  correlacion_id varchar
  motivo text
  fecha_creacion timestamp

  indexes {
    (tenant_id, trabajo_id, version) [unique, name: 'uq_transiciones_trabajo_tenant_trabajo_version']
    (tenant_id, trabajo_id, fecha_creacion) [name: 'idx_transiciones_trabajo_tenant_trabajo_fecha_creacion']
  }
}

Table evidencias_trabajo {
  id varchar [pk]
  evidencia_id varchar
  tenant_id varchar
  prestador_tenant_id varchar
  trabajo_id varchar
  fase varchar [note: 'request | diagnosis | budget | execution | completion']
  actor_id varchar
  correlacion_id varchar
  referencia varchar
  metadatos json
  fecha_ocurrencia timestamp
  fecha_creacion timestamp

  indexes {
    (tenant_id, evidencia_id) [unique, name: 'uq_evidencias_trabajo_tenant_evidencia']
    (tenant_id, trabajo_id, fase, fecha_ocurrencia) [name: 'idx_evidencias_trabajo_tenant_trabajo_fase']
    (prestador_tenant_id, trabajo_id, fecha_ocurrencia) [name: 'idx_evidencias_trabajo_prestador_trabajo_fecha']
  }
}

Table auditoria_trabajo {
  id varchar [pk]
  tenant_id varchar
  trabajo_tenant_id varchar
  prestador_tenant_id varchar
  trabajo_id varchar
  actor_id varchar
  correlacion_id varchar
  accion varchar
  tipo_recurso varchar
  recurso_id varchar
  resultado varchar
  metadatos json
  fecha_creacion timestamp

  indexes {
    (tenant_id, fecha_creacion) [name: 'idx_auditoria_trabajo_tenant_fecha_creacion']
    (trabajo_tenant_id, trabajo_id, fecha_creacion) [name: 'idx_auditoria_trabajo_trabajo_fecha_creacion']
    (prestador_tenant_id, trabajo_id, fecha_creacion) [name: 'idx_auditoria_trabajo_prestador_trabajo_fecha']
  }
}

// ============================================================
// RELACIONES FISICAS ACTUALES
// ============================================================

// LineaFactura -> Factura (FK compuesta tenant_id + factura_id) — FISICA_ACTUAL
Ref: lineas_factura.(tenant_id, factura_id) > facturas.(tenant_id, factura_id)
Ref: compromisos_mercado_servicios.(prestador_tenant_id, publicacion_id) > publicaciones.(tenant_id, id)
Ref: trabajos.(tenant_id, compromiso_id) > compromisos_mercado_servicios.(tenant_id, compromiso_id)
Ref: trabajos.(prestador_tenant_id, prestador_id) > prestadores.(tenant_id, prestador_id)
Ref: trabajos.(prestador_tenant_id, publicacion_id) > publicaciones.(tenant_id, id)
Ref: trabajos.(reserva_tenant_id, reserva_id) > reservas.(tenant_id, reserva_id)
Ref: trabajos.(tenant_id, presupuesto_aceptado_id, presupuesto_aceptado_version) > presupuestos.(tenant_id, presupuesto_id, version)
Ref: diagnosticos.(tenant_id, trabajo_id) > trabajos.(tenant_id, trabajo_id)
Ref: obligaciones_pago_servicio.(tenant_id, trabajo_id, compromiso_id, prestador_tenant_id, prestador_id, publicacion_id) - trabajos.(tenant_id, trabajo_id, compromiso_id, prestador_tenant_id, prestador_id, publicacion_id)
Ref: obligaciones_pago_servicio.(tenant_id, presupuesto_id, presupuesto_version) > presupuestos.(tenant_id, presupuesto_id, version)
Ref: intenciones_pago.(tenant_id, obligacion_id) > obligaciones_pago_servicio.(tenant_id, obligacion_id)
Ref: instantaneas_comision.(tenant_id, obligacion_id) - obligaciones_pago_servicio.(tenant_id, obligacion_id)
Ref: movimientos_contables.(tenant_id, obligacion_id) > obligaciones_pago_servicio.(tenant_id, obligacion_id)
Ref: eventos_webhook_pago.(tenant_id, obligacion_id) > obligaciones_pago_servicio.(tenant_id, obligacion_id)
Ref: auditoria_finanzas_servicio.(tenant_id, obligacion_id) > obligaciones_pago_servicio.(tenant_id, obligacion_id)
Ref: liquidaciones_servicio.(tenant_id, obligacion_id) - obligaciones_pago_servicio.(tenant_id, obligacion_id)
Ref: conciliaciones_servicio.(tenant_id, obligacion_id) > obligaciones_pago_servicio.(tenant_id, obligacion_id)
Ref: intenciones_pago.(tenant_id, obligacion_id, prestador_tenant_id, orden_id) > obligaciones_pago_servicio.(tenant_id, obligacion_id, prestador_tenant_id, trabajo_id)
Ref: liquidaciones_servicio.(tenant_id, obligacion_id, prestador_tenant_id, trabajo_id) - obligaciones_pago_servicio.(tenant_id, obligacion_id, prestador_tenant_id, trabajo_id)
Ref: eventos_webhook_pago.(tenant_id, pago_id, obligacion_id) > intenciones_pago.(tenant_id, pago_id, obligacion_id)
Ref: presupuestos.(tenant_id, trabajo_id) > trabajos.(tenant_id, trabajo_id)
Ref: lineas_presupuesto.presupuesto_registro_id > presupuestos.id
Ref: aceptaciones_presupuesto.presupuesto_registro_id > presupuestos.id
Ref: transiciones_trabajo.(tenant_id, trabajo_id) > trabajos.(tenant_id, trabajo_id)
Ref: evidencias_trabajo.(tenant_id, trabajo_id) > trabajos.(tenant_id, trabajo_id)
Ref: auditoria_trabajo.(trabajo_tenant_id, trabajo_id) > trabajos.(tenant_id, trabajo_id)

// ============================================================
// RELACIONES OBJETIVO FUTURO
// ============================================================
// FK aprobadas por el análisis relacional; aún NO existen físicamente.

// MERCADO
Ref: publicaciones.(tenant_id, prestador_id) > prestadores.(tenant_id, prestador_id)         // Prestador 1:N Publicacion (OBJETIVO_FUTURO, corrige FK por tenant_id)
Ref: calendarios.(tenant_id, prestador_id) > prestadores.(tenant_id, prestador_id)             // agenda principal nueva; NULL legacy

// COMPROMISOS
Ref: compromisos.(tenant_id, prestador_id) > prestadores.(tenant_id, prestador_id)           // OBJETIVO_FUTURO
Ref: transiciones_compromiso.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id) // OBJETIVO_FUTURO
Ref: compensaciones_compromiso.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id) // OBJETIVO_FUTURO

// CALENDARIO
Ref: reglas_calendario.(tenant_id, calendario_id) > calendarios.(tenant_id, id)      // OBJETIVO_FUTURO (FK compuesta tenant-scoped)
Ref: excepciones_calendario.(tenant_id, calendario_id) > calendarios.(tenant_id, id) // OBJETIVO_FUTURO (FK compuesta tenant-scoped)
Ref: reservas.(tenant_id, calendario_id) > calendarios.(tenant_id, id)               // OBJETIVO_FUTURO (FK compuesta tenant-scoped)
Ref: reservas.(tenant_id, publicacion_id) > publicaciones.(tenant_id, id)           // agenda/publicacion nueva; NULL legacy

// ENTREGA
Ref: turnos_entrega.(tenant_id, zona_id) > zonas_entrega.(tenant_id, zona_id)                // OBJETIVO_FUTURO
Ref: evidencias_entrega.(tenant_id, tarea_id) > tareas_entrega.(tenant_id, tarea_id)         // OBJETIVO_FUTURO
Ref: incidentes_entrega.(tenant_id, tarea_id) > tareas_entrega.(tenant_id, tarea_id)         // OBJETIVO_FUTURO

// POS
Ref: comprobantes_pos.(tenant_id, operacion_id) > operaciones_pos.(tenant_id, operacion_id)  // OBJETIVO_FUTURO
Ref: conflictos_pos.(tenant_id, operacion_id) > operaciones_pos.(tenant_id, operacion_id)    // OBJETIVO_FUTURO

// SOPORTE
Ref: evidencias_soporte.(tenant_id, caso_id) > casos_soporte.(tenant_id, caso_id)            // OBJETIVO_FUTURO
Ref: lineas_tiempo_soporte.(tenant_id, caso_id) > casos_soporte.(tenant_id, caso_id)         // OBJETIVO_FUTURO
Ref: compensaciones_soporte.(tenant_id, caso_id) > casos_soporte.(tenant_id, caso_id)        // OBJETIVO_FUTURO

// FINANZAS
Ref: intenciones_pago.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id)    // OBJETIVO_FUTURO
Ref: instantaneas_comision.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id) // OBJETIVO_FUTURO
Ref: movimientos_contables.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id) // OBJETIVO_FUTURO
Ref: evidencias_financieras.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id) // OBJETIVO_FUTURO
Ref: confirmaciones_financieras.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id) // OBJETIVO_FUTURO
Ref: bloqueos_financieros.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id) // OBJETIVO_FUTURO
Ref: registros_conciliacion.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id) // OBJETIVO_FUTURO

// FACTURACIÓN
Ref: facturas.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id)            // OBJETIVO_FUTURO (REQUIERE VALIDACION: "" permitido)
Ref: notas_credito.(tenant_id, factura_id) > facturas.(tenant_id, factura_id)                // OBJETIVO_FUTURO
Ref: reintegros_facturacion.(tenant_id, factura_id) > facturas.(tenant_id, factura_id)       // OBJETIVO_FUTURO
Ref: movimientos_contables_facturacion.(tenant_id, factura_id) > facturas.(tenant_id, factura_id) // OBJETIVO_FUTURO
Ref: gestion_mora.(tenant_id, suscripcion_id) > suscripciones.(tenant_id, suscripcion_id)    // OBJETIVO_FUTURO
Ref: suscripciones.(tenant_id, plan_id) > planes_suscripcion.(tenant_id, plan_id)            // OBJETIVO_FUTURO (REQUIERE VALIDACION: "" permitido)

// ============================================================
// RELACIONES NO-FK (LOGICA / EXTERNA / POLIMORFICA / LEGACY)
// ============================================================
// Documentadas en DICCIONARIO_DATOS_TUS.md (matriz de relaciones no-FK).
// No se modelan como Ref porque no son FK SQL.

// ============================================================
// IDENTITY-NOSIS (20260927100000_tus_identity_verification)
// ============================================================
Table verificaciones_identidad {
  id varchar [pk]
  tenant_id varchar
  usuario_id varchar
  proveedor_id varchar
  tipo_documento varchar [note: 'dni']
  numero_documento varchar [null]
  nombre_extraido varchar [null]
  apellido_extraido varchar [null]
  fecha_nacimiento_extraida varchar [null]
  sexo_extraido varchar [null]
  cuil_verificado varchar [null]
  estado varchar
  metodo_verificacion varchar [null, note: 'nosis_browser | nosis_api | demo | manual']
  referencia_proveedor varchar [null]
  motivo_revision varchar [null]
  nota_decision varchar [null]
  consentimiento_aceptado_en timestamp [null]
  consentimiento_version varchar [null]
  consentimiento_proposito varchar [null]
  lectura_ocr jsonb [null]
  lectura_vision jsonb [null]
  resultado_externo jsonb [null, note: 'snapshot minimo: resultCount, nameMatch, cuilValid']
  intentos int
  version int
  fecha_creacion timestamp
  encolada_en timestamp [null]
  procesamiento_iniciado_en timestamp [null]
  verificada_en timestamp [null]
  rechazada_en timestamp [null]
  fecha_actualizacion timestamp
  indexes {
    (tenant_id, fecha_creacion) [name: 'ix_verificaciones_identidad_tenant']
    (estado, fecha_creacion) [name: 'ix_verificaciones_identidad_estado']
    numero_documento [unique, name: 'uq_verificaciones_identidad_documento_verificado', note: 'parcial WHERE estado = verified']
    cuil_verificado [unique, name: 'uq_verificaciones_identidad_cuil_verificado', note: 'parcial WHERE estado = verified']
  }
  Note: 'IDENTITY-NOSIS: verificacion de identidad del prestador.'
}

Table documentos_identidad {
  id varchar [pk, note: 'verificacion_id:lado']
  verificacion_id varchar
  tenant_id varchar
  lado varchar [note: 'front | back']
  tipo_mime varchar
  tamano int
  sha256 varchar
  contenido_cifrado text [note: 'AES-256-GCM, clave TUS_IDENTITY_DOCUMENTS_KEY fuera de la DB']
  version_clave varchar
  fecha_creacion timestamp
  indexes {
    (verificacion_id, lado) [unique, name: 'uq_documentos_identidad_lado']
  }
}

Table cola_verificacion_identidad {
  id varchar [pk]
  verificacion_id varchar
  etapa varchar [note: 'lectura | consulta']
  estado varchar [note: 'queued | leased | done | cancelled']
  encolado_en timestamp
  disponible_en timestamp
  intentos int
  lease_owner varchar [null]
  lease_hasta timestamp [null]
  ultimo_error varchar [null]
  fecha_actualizacion timestamp
  indexes {
    verificacion_id [unique, name: 'uq_cola_verificacion_identidad_activo', note: 'parcial WHERE estado IN (queued, leased)']
    (estado, encolado_en, disponible_en) [name: 'ix_cola_verificacion_identidad_fifo']
  }
}

Table consultas_proveedor_identidad {
  id varchar [pk]
  proveedor_id varchar
  verificacion_id varchar
  consumida_en timestamp
  indexes {
    (proveedor_id, consumida_en) [name: 'ix_consultas_proveedor_identidad_ventana']
  }
  Note: 'append-only (trigger); ventana deslizante 7/h'
}

Table estado_proveedor_identidad {
  proveedor_id varchar [pk]
  estado varchar [note: 'running | paused | session_required | circuit_open']
  errores_consecutivos int
  motivo varchar [null]
  version int
  fecha_actualizacion timestamp
}

Table sesiones_navegador_proveedor {
  proveedor_id varchar [pk]
  estado_cifrado text [note: 'AES-256-GCM, TUS_NOSIS_SESSION_KEY']
  version_clave varchar
  fecha_actualizacion timestamp
}

Table auditoria_identidad {
  id varchar [pk]
  accion varchar
  verificacion_id varchar [null]
  tenant_id varchar [null]
  actor_id varchar
  correlacion_id varchar
  metadata jsonb [note: 'DNI/CUIL enmascarados']
  fecha_creacion timestamp
  indexes {
    (verificacion_id, fecha_creacion) [name: 'ix_auditoria_identidad_verificacion']
  }
  Note: 'append-only (trigger)'
}
