  revoked_at timestamp [null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (tenant_id, recipient_id) [unique, name: 'uq_consentimientos_whatsapp_tenant_recipient']
    (tenant_id, status) [name: 'idx_consentimientos_whatsapp_tenant_status']
  }

  Note: 'ConsentimientoWhatsApp = consentimiento. recipient_id [EXTERNA].'
}

Table mensajes_whatsapp {
  id varchar [pk]
  tenant_id varchar
  mensaje_id varchar
  recipient_id varchar [note: '[EXTERNA]']
  template varchar [note: '[EXTERNA] plantilla Meta']
  template_version varchar
  consentimiento_id varchar [note: '[LOGICA] referencia a consentimiento']
  request_hash varchar
  variables json [null]
  status varchar
  correlation_id varchar
  retention_until timestamp [null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (tenant_id, mensaje_id) [unique, name: 'uq_mensajes_whatsapp_tenant_mensaje']
    (tenant_id, recipient_id, status) [name: 'idx_mensajes_whatsapp_tenant_recipient_status']
  }

  Note: 'MensajeWhatsApp = mensaje/plantilla. recipient_id/template [EXTERNA]; consentimiento_id [LOGICA].'
}

Table eventos_webhook_whatsapp {
  id varchar [pk]
  tenant_id varchar
  provider_event_id varchar [note: '[EXTERNA] id de Meta']
  signature varchar [note: '[EXTERNA]']
  occurred_at timestamp
  status varchar
  created_at timestamp

  indexes {
    (tenant_id, provider_event_id) [unique, name: 'uq_eventos_webhook_whatsapp_tenant_event']
    (tenant_id, status, occurred_at) [name: 'idx_eventos_webhook_whatsapp_tenant_status_occurred']
  }

  Note: 'EventoWebhookWhatsApp = evento de proveedor. provider_event_id/signature [EXTERNA].'
}

// ============================================================
// HABILITACIÓN
// ============================================================

Table evidencias_habilitacion {
  id varchar [pk]
  contract_version varchar
  tenant_id varchar
  capability varchar [note: '[POLIMORFICA] capacidad evaluada']
  gate varchar [note: '[POLIMORFICA] gate/requisito']
  owner varchar [note: '[POLIMORFICA] propietario']
  scope varchar [note: '[POLIMORFICA] alcance']
  tipo_evidencia varchar [note: '@map evidenceType']
  referencia_evidencia varchar [note: '@map evidenceRef; [EXTERNA] referencia a evidencia externa']
  policy_version varchar
  issued_at timestamp
  expires_at timestamp [null]
  revoked boolean
  source varchar
  profile varchar
  execution varchar
  evidence_class varchar
  live_conformance boolean
  created_at timestamp
  updated_at timestamp

  indexes {
    (tenant_id, capability, gate, referencia_evidencia) [unique, name: 'uq_evidencias_hab_tenant_gate_ref']
    (tenant_id, capability, gate, revoked) [name: 'idx_evidencias_hab_tenant_gate_revoked']
    (expires_at) [name: 'idx_evidencias_hab_expires']
  }

  Note: '[HISTORICA] EvidenciaHabilitacion = evidencia de gate. capability/gate/owner/scope [POLIMORFICA], sin FK.'
}

Table decisiones_habilitacion {
  id varchar [pk]
  tenant_id varchar
  capability varchar [note: '[POLIMORFICA]']
  evaluated_at timestamp
  enabled boolean
  resultado_habilitacion varchar [note: '@map disposition; valor congelado']
  requisitos_fallidos json [note: '@map failedGates; valor congelado']
  ids_evidencia varchar[] [note: '@map evidenceIds']
  deterministic boolean
  conflicts json [null]
  reason varchar [null]
  evidence_preserved boolean [null]
  audit_preserved boolean [null]
  actor_id varchar
  job_id varchar [null]
  correlation_id varchar
  profile varchar
  scope varchar
  outcome varchar
  created_at timestamp

  indexes {
    (tenant_id, capability, evaluated_at) [name: 'idx_decisiones_hab_tenant_cap_evaluated']
    (tenant_id, capability, enabled) [name: 'idx_decisiones_hab_tenant_cap_enabled']
    (tenant_id, correlation_id) [name: 'idx_decisiones_hab_tenant_correlation']
  }

  Note: '[HISTORICA] append-only. capability/profile/scope [POLIMORFICA]. Valores resultado/requisitos congelados.'
}

