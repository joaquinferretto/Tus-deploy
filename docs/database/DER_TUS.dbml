// ============================================================
// DER CANÓNICO TUS — MODELO RELACIONAL OBJETIVO (español, snake_case)
// ============================================================
// ADVERTENCIA: este diagrama describe el modelo canónico OBJETIVO de TUS Core.
// NO es una copia exacta del estado físico actual de PostgreSQL.
// Las relaciones marcadas [OBJETIVO_FUTURO] todavía NO existen como FK física
// y se implementarán mediante migraciones forward-only posteriores.
// Las relaciones [FISICA_ACTUAL] ya existen físicamente.
// [LOGICA], [EXTERNA], [POLIMORFICA], [HISTORICA] y [TECNICA] NO son FK SQL.
//
// Convenciones:
//   id          -> PK surrogate estable e inmutable (varchar, generada por aplicación)
//   tenant_id   -> excepción técnica de aislamiento (permanece en inglés)
//   *_id de negocio -> identidad tenant-scoped, protegida por UNIQUE (tenant_id, <id>)
//   bigint      -> dinero/montos en unidades menores (NO int)
//   json        -> valores serializados congelados
//
// Utilizable directamente en dbdiagram.io

// ============================================================
// MERCADO
// ============================================================

Table prestadores {
  id varchar [pk, note: 'PK surrogate estable e inmutable']
  tenant_id varchar [note: 'excepción técnica de aislamiento']
  prestador_id varchar [note: 'id de negocio del prestador (merchantId)']
  cohort varchar
  location_id varchar
  timezone varchar
  staff_roles varchar[]
  operating_policy_version varchar
  status varchar
  created_at timestamp
  updated_at timestamp

  indexes {
    (tenant_id, prestador_id) [unique, name: 'uq_prestadores_tenant_prestador', note: 'OBJETIVO_FUTURO: hoy solo tenant_id es @unique']
    (tenant_id, status) [name: 'idx_prestadores_tenant_status']
  }

  Note: 'Prestador = actor que ofrece y ejecuta servicios. PK surrogate; identidad tenant-scoped por (tenant_id, prestador_id).'
}

Table publicaciones {
  id varchar [pk, note: 'PK surrogate estable e inmutable']
  contract_version varchar
  tenant_id varchar
  prestador_id varchar [note: 'FK objetivo -> prestadores (merchantId)']
  kind varchar
  name varchar
  description varchar
  cohort varchar
  location_id varchar
  currency varchar
  price bigint [note: 'unidades menores']
  availability_version int
  published boolean
  policy_version varchar
  stock int [null]
  duration_minutes int [null]
  capacity int [null]
  working_hours json
  created_at timestamp
  updated_at timestamp

  indexes {
    (tenant_id, published) [name: 'idx_publicaciones_tenant_published']
    (tenant_id, availability_version) [name: 'idx_publicaciones_tenant_avail']
    (prestador_id, kind) [name: 'idx_publicaciones_prestador_kind']
  }

  Note: 'Publicacion = oferta visible. Prestador 1:N Publicacion. FK objetivo (tenant_id, prestador_id) -> prestadores, onDelete RESTRICT.'
}

Table compromisos_mercado_servicios {
  id varchar [pk]
  contract_version varchar
  compromiso_id varchar
  cart_id varchar
  tenant_id varchar
  prestador_id varchar [note: 'referencia lógica a prestador (merchantId)']
  publicacion_id varchar [note: 'FK objetivo -> publicaciones (listingId)']
  context varchar
  line_ids varchar[]
  quantity int
  amount bigint
  currency varchar
  status varchar
  availability_version int
  policy_version varchar
  slot_start timestamp [null]
  slot_end timestamp [null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (tenant_id, compromiso_id) [unique, name: 'uq_compromisos_ms_tenant_compromiso']
    (tenant_id, created_at) [name: 'idx_compromisos_ms_tenant_created']
    (publicacion_id, slot_start, slot_end) [name: 'idx_compromisos_ms_listing_slot']
    (prestador_id, context, status) [name: 'idx_compromisos_ms_merchant_context_status']
  }

  Note: 'CompromisoMercadoServicios = línea de checkout del mercado. FK objetivo publicacion_id -> publicaciones.'
}

Table auditoria_mercado_servicios {
  id varchar [pk]
  tenant_id varchar
  actor_id varchar
  correlation_id varchar
  action varchar
  resource_type varchar [note: '[POLIMORFICA]']
  resource_id varchar [note: '[POLIMORFICA]']
  outcome varchar
  created_at timestamp

  indexes {
    (tenant_id, created_at) [name: 'idx_auditoria_ms_tenant_created']
    (tenant_id, resource_type, resource_id) [name: 'idx_auditoria_ms_tenant_resource']
  }

  Note: 'AuditoriaMercadoServicios = traza de acciones. resource_type/resource_id son [POLIMORFICA], sin FK.'
}

// ============================================================
// COMPROMISOS
// ============================================================

Table compromisos {
  id varchar [pk]
  contract_version varchar
  compromiso_id varchar
  cart_id varchar
  tenant_id varchar
  prestador_id varchar [note: 'FK objetivo -> prestadores (merchantId)']
  context varchar
  amount bigint
  currency varchar
  status varchar
  line_ids varchar[]
  version int
  created_at timestamp
  updated_at timestamp

  indexes {
    (tenant_id, compromiso_id) [unique, name: 'uq_compromisos_tenant_compromiso']
    (tenant_id, created_at) [name: 'idx_compromisos_tenant_created']
    (tenant_id, cart_id) [name: 'idx_compromisos_tenant_cart']
  }

  Note: 'Compromiso = obligación comercial canónica. FK objetivo prestador_id -> prestadores, onDelete RESTRICT.'
}

Table transiciones_compromiso {
  id varchar [pk]
  tenant_id varchar
  compromiso_id varchar [note: 'FK objetivo -> compromisos']
  from_status varchar
  to_status varchar
  version int
  actor_id varchar
  correlation_id varchar
  reason varchar
  created_at timestamp

  indexes {
    (tenant_id, compromiso_id, version) [unique, name: 'uq_transiciones_tenant_compromiso_version']
    (tenant_id, compromiso_id, created_at) [name: 'idx_transiciones_tenant_compromiso_created']
  }

  Note: '[HISTORICA] append-only. FK objetivo (tenant_id, compromiso_id) -> compromisos, onDelete RESTRICT.'
}

Table compensaciones_compromiso {
  id varchar [pk]
  compensacion_id varchar
  tenant_id varchar
  compromiso_id varchar [note: 'FK objetivo -> compromisos']
  actor_id varchar
  correlation_id varchar
  amount bigint
  currency varchar
  reason varchar
  created_at timestamp

  indexes {
    (tenant_id, compensacion_id) [unique, name: 'uq_compensaciones_tenant_compensacion']
    (tenant_id, compromiso_id) [unique, name: 'uq_compensaciones_tenant_compromiso', note: '1:1 compensación por compromiso']
    (tenant_id, compromiso_id, created_at) [name: 'idx_compensaciones_tenant_compromiso_created']
  }

  Note: 'CompensacionCompromiso = compensación de un compromiso. FK objetivo compromiso_id -> compromisos, RESTRICT.'
}

Table referencias_auditoria {
  id varchar [pk]
  referencia_id varchar
  tenant_id varchar
  actor_id varchar
  correlation_id varchar
  compromiso_id varchar [note: '[LOGICA] referencia a compromiso']
  reference_type varchar
  metadata json [null]
  created_at timestamp

  indexes {
    (tenant_id, referencia_id) [unique, name: 'uq_referencias_tenant_referencia']
    (tenant_id, compromiso_id, created_at) [name: 'idx_referencias_tenant_compromiso_created']
    (tenant_id, correlation_id) [name: 'idx_referencias_tenant_correlation']
  }

  Note: 'ReferenciaAuditoria = traza de referencias. compromiso_id es [LOGICA] (puede sobrevivir al agregado).'
}

// ============================================================
// CALENDARIO
// ============================================================

Table calendarios {
  id varchar [pk]
  tenant_id varchar
  service_id varchar [note: '[LEGACY] -> TusService. PENDIENTE migración a prestador/publicacion']
  name varchar
  timezone varchar
  status varchar
  created_at timestamp
  updated_at timestamp

  indexes {
    (tenant_id, service_id, status) [name: 'idx_calendarios_tenant_service_status']
  }

  Note: 'Calendario = calendario de disponibilidad. Propietario canónico: prestador. service_id es [LEGACY].'
}

Table reglas_calendario {
  id varchar [pk]
  tenant_id varchar
  calendario_id varchar [note: 'FK objetivo -> calendarios']
  weekday int
  starts_at varchar
  ends_at varchar
  capacity int
  created_at timestamp
  updated_at timestamp

  indexes {
    (tenant_id, calendario_id, weekday, starts_at, ends_at) [unique, name: 'uq_reglas_tenant_calendario_slot']
    (tenant_id, calendario_id) [name: 'idx_reglas_tenant_calendario']
  }

  Note: 'ReglaCalendario = regla de franja. FK objetivo (tenant_id, calendario_id) -> calendarios, onDelete CASCADE.'
}

Table excepciones_calendario {
  id varchar [pk]
  tenant_id varchar
  calendario_id varchar [note: 'FK objetivo -> calendarios']
  starts_at timestamp
  ends_at timestamp
  reason varchar
  status varchar
  created_at timestamp

  indexes {
    (tenant_id, calendario_id, starts_at, ends_at) [name: 'idx_excepciones_tenant_calendario_slot']
  }

  Note: 'ExcepcionCalendario = excepción de franja. FK objetivo (tenant_id, calendario_id) -> calendarios, CASCADE.'
}

Table reservas {
  id varchar [pk]
  tenant_id varchar
  reserva_id varchar
  service_id varchar [note: '[LEGACY] -> TusService']
  calendario_id varchar [note: 'FK objetivo -> calendarios']
  cliente_id varchar [note: '[EXTERNA/LOGICA] identidad de cliente']
  starts_at timestamp
  ends_at timestamp
  status varchar
  version int
  created_at timestamp
  updated_at timestamp

  indexes {
    (tenant_id, reserva_id) [unique, name: 'uq_reservas_tenant_reserva']
    (tenant_id, calendario_id, starts_at, ends_at) [name: 'idx_reservas_tenant_calendario_slot']
    (tenant_id, cliente_id, status) [name: 'idx_reservas_tenant_cliente_status']
  }

  Note: 'Reserva = ocupación de franja/capacidad. FK objetivo calendario_id -> calendarios, RESTRICT. service_id/cliente_id [LEGACY/EXTERNA].'
}

// ============================================================
// ENTREGA
// ============================================================

Table zonas_entrega {
  id varchar [pk]
  tenant_id varchar
  zona_id varchar
  name varchar
  postal_codes varchar[]
  active boolean
  created_at timestamp
  updated_at timestamp

  indexes {
    (tenant_id, zona_id) [unique, name: 'uq_zonas_tenant_zona']
    (tenant_id, active) [name: 'idx_zonas_tenant_active']
  }

  Note: 'ZonaEntrega = zona geográfica de entrega.'
}

Table turnos_entrega {
  id varchar [pk]
  tenant_id varchar
  turno_id varchar
  zona_id varchar [note: 'FK objetivo -> zonas_entrega']
  starts_at timestamp
  ends_at timestamp
  operador_ids varchar[]
  status varchar
  created_at timestamp
  updated_at timestamp

  indexes {
    (tenant_id, turno_id) [unique, name: 'uq_turnos_tenant_turno']
    (tenant_id, zona_id, status) [name: 'idx_turnos_tenant_zona_status']
  }

  Note: 'TurnoEntrega = turno operativo. FK objetivo (tenant_id, zona_id) -> zonas_entrega, RESTRICT.'
}

Table tareas_entrega {
  id varchar [pk]
  tenant_id varchar
  tarea_id varchar
  compromiso_id varchar [note: '[LOGICA] referencia a compromiso']
  prestador_id varchar [note: 'referencia lógica a prestador (merchantId)']
  context varchar
  zona_id varchar [note: '[LOGICA] referencia a zona']
  turno_id varchar [note: '[LOGICA] referencia a turno']
  operador_id varchar [null, note: '[EXTERNA] hasta asignación']
  status varchar
  version int
  proof json [null]
  incident json [null]
  sla json [null]
  pickup json [null]
  dropoff json [null]
  cancelled_at timestamp [null]
  failure_reason varchar [null]
  settlement_claim varchar
  created_at timestamp
  updated_at timestamp

  indexes {
    (tenant_id, tarea_id) [unique, name: 'uq_tareas_tenant_tarea']
    (tenant_id, compromiso_id) [name: 'idx_tareas_tenant_compromiso']
    (tenant_id, turno_id, status) [name: 'idx_tareas_tenant_turno_status']
    (tenant_id, compromiso_id, status) [name: 'idx_tareas_tenant_compromiso_status']
  }

  Note: 'TareaEntrega = tarea de entrega. compromiso_id es [LOGICA] (entrega puede vivir más que el compromiso). operador_id nullable.'
}

Table evidencias_entrega {
  id varchar [pk]
  tenant_id varchar
  evidencia_id varchar
  tarea_id varchar [note: 'FK objetivo -> tareas_entrega']
  compromiso_id varchar [note: '[LOGICA]']
  recipient_name varchar
  captured_at timestamp
  evidence_source varchar
  created_at timestamp

  indexes {
    (tenant_id, evidencia_id) [unique, name: 'uq_evidencias_tenant_evidencia']
    (tenant_id, tarea_id) [name: 'idx_evidencias_tenant_tarea']
  }

  Note: 'EvidenciaEntrega = comprobante de entrega. FK objetivo (tenant_id, tarea_id) -> tareas_entrega, RESTRICT.'
}

Table incidentes_entrega {
  id varchar [pk]
  tenant_id varchar
  incidente_id varchar
  tarea_id varchar [note: 'FK objetivo -> tareas_entrega']
  reason varchar
  status varchar
  created_at timestamp

  indexes {
    (tenant_id, incidente_id) [unique, name: 'uq_incidentes_tenant_incidente']
    (tenant_id, tarea_id, status) [name: 'idx_incidentes_tenant_tarea_status']
  }

  Note: 'IncidenteEntrega = incidente logístico. FK objetivo (tenant_id, tarea_id) -> tareas_entrega, RESTRICT.'
}

Table auditoria_entrega {
  id varchar [pk]
  tenant_id varchar
  auditoria_id varchar
  actor_id varchar
  correlation_id varchar
  action varchar
  resource_type varchar [note: '[POLIMORFICA]']
  resource_id varchar [note: '[POLIMORFICA]']
  outcome varchar
  created_at timestamp

  indexes {
    (tenant_id, auditoria_id) [unique, name: 'uq_auditoria_entrega_tenant_auditoria']
    (tenant_id, created_at) [name: 'idx_auditoria_entrega_tenant_created']
  }

  Note: 'AuditoriaEntrega = traza de entrega. resource_type/resource_id [POLIMORFICA].'
}

// ============================================================
// POS
// ============================================================

Table operaciones_pos {
  id varchar [pk]
  tenant_id varchar
  operacion_id varchar
  idempotency_key varchar
  schema_version varchar
  actor_id varchar
  device_id varchar [note: '[LOGICA] referencia a dispositivo']
  shift_id varchar [note: '[LOGICA] referencia a turno/sesión']
  created_at timestamp
  expected_version int [null]
  kind varchar
  context varchar
  amount bigint
  currency varchar
  response json [null]

  indexes {
    (tenant_id, operacion_id) [unique, name: 'uq_operaciones_pos_tenant_operacion']
    (tenant_id, idempotency_key) [unique, name: 'uq_operaciones_pos_tenant_idem']
    (tenant_id, shift_id, created_at) [name: 'idx_operaciones_pos_tenant_shift_created']
    (tenant_id, context, kind) [name: 'idx_operaciones_pos_tenant_context_kind']
  }

  Note: 'OperacionPOS = operación manual. device_id/shift_id [LOGICA]. Idempotencia por (tenant_id, idempotency_key).'
}

Table versiones_pos {
  id varchar [pk]
  tenant_id varchar
  shift_id varchar [note: '[LOGICA]']
  version int
  created_at timestamp
  updated_at timestamp

  indexes {
    (tenant_id, shift_id) [unique, name: 'uq_versiones_pos_tenant_shift']
    (tenant_id, shift_id, version) [name: 'idx_versiones_pos_tenant_shift_version']
  }

  Note: 'VersionPOS = control de versión por turno (shift_id lógico).'
}

Table comprobantes_pos {
  id varchar [pk]
  tenant_id varchar
  comprobante_id varchar
  operacion_id varchar [note: 'FK objetivo -> operaciones_pos']
  kind varchar
  context varchar
  amount bigint
  currency varchar
  status varchar
  source varchar
  provider_capture varchar
  settlement varchar
  integrity_hash varchar
  created_at timestamp

  indexes {
    (tenant_id, comprobante_id) [unique, name: 'uq_comprobantes_pos_tenant_comprobante']
    (tenant_id, operacion_id) [name: 'idx_comprobantes_pos_tenant_operacion']
    (tenant_id, operacion_id, created_at) [name: 'idx_comprobantes_pos_tenant_operacion_created']
  }

  Note: 'ComprobantePOS = comprobante. FK objetivo (tenant_id, operacion_id) -> operaciones_pos, RESTRICT.'
}

Table dispositivos_pos {
  id varchar [pk]
  tenant_id varchar
  dispositivo_id varchar
  label varchar
  fingerprint varchar
  status varchar
  created_at timestamp
  updated_at timestamp

  indexes {
    (tenant_id, dispositivo_id) [unique, name: 'uq_dispositivos_pos_tenant_dispositivo']
    (tenant_id, status) [name: 'idx_dispositivos_pos_tenant_status']
  }

  Note: 'DispositivoPOS = dispositivo físico.'
}

Table sesiones_pos {
  id varchar [pk]
  tenant_id varchar
  sesion_id varchar
  dispositivo_id varchar [note: '[LOGICA] referencia a dispositivo']
  actor_id varchar
  shift_id varchar [note: '[LOGICA]']
  status varchar
  opened_at timestamp
  closed_at timestamp [null]

  indexes {
    (tenant_id, sesion_id) [unique, name: 'uq_sesiones_pos_tenant_sesion']
    (tenant_id, dispositivo_id, shift_id, status) [name: 'idx_sesiones_pos_tenant_device_shift_status']
  }

  Note: 'SesionPOS = sesión de turno. dispositivo_id/shift_id [LOGICA].'
}

Table conflictos_pos {
  id varchar [pk]
  tenant_id varchar
  conflicto_id varchar
  operacion_id varchar [note: 'FK objetivo -> operaciones_pos']
  reason varchar
  expected_version int [null]
  actual_version int [null]
  status varchar
  created_at timestamp

  indexes {
    (tenant_id, conflicto_id) [unique, name: 'uq_conflictos_pos_tenant_conflicto']
    (tenant_id, operacion_id, status) [name: 'idx_conflictos_pos_tenant_operacion_status']
    (tenant_id, status, created_at) [name: 'idx_conflictos_pos_tenant_status_created']
  }

  Note: 'ConflictoPOS = conflicto de versión. FK objetivo (tenant_id, operacion_id) -> operaciones_pos, RESTRICT.'
}

Table auditoria_pos {
  id varchar [pk]
  tenant_id varchar
  auditoria_id varchar
  actor_id varchar
  correlation_id varchar
  action varchar
  operacion_id varchar [note: '[LOGICA] referencia a operación']
  outcome varchar
  created_at timestamp

  indexes {
    (tenant_id, auditoria_id) [unique, name: 'uq_auditoria_pos_tenant_auditoria']
    (tenant_id, operacion_id, created_at) [name: 'idx_auditoria_pos_tenant_operacion_created']
  }

  Note: 'AuditoriaPOS = traza de operaciones. operacion_id [LOGICA].'
}

// ============================================================
// SOPORTE
// ============================================================

Table casos_soporte {
  id varchar [pk]
  caso_id varchar
  disputa_id varchar [note: '[LOGICA] referencia a disputa']
  tenant_id varchar
  correlation_id varchar
  compromiso_id varchar [note: '[LOGICA] referencia a compromiso']
  opened_by varchar
  category varchar
  status varchar
  outcome varchar [null]
  created_at timestamp
  resolved_at timestamp [null]

  indexes {
    (tenant_id, caso_id) [unique, name: 'uq_casos_soporte_tenant_caso']
    (tenant_id, status, created_at) [name: 'idx_casos_soporte_tenant_status_created']
    (tenant_id, compromiso_id) [name: 'idx_casos_soporte_tenant_compromiso']
  }

  Note: 'CasoSoporte = caso de asistencia. compromiso_id/disputa_id [LOGICA].'
}

Table evidencias_soporte {
  id varchar [pk]
  evidencia_id varchar
  caso_id varchar [note: 'FK objetivo -> casos_soporte']
  tenant_id varchar
  correlation_id varchar
  party varchar
  summary varchar
  submitted_by varchar
  created_at timestamp

  indexes {
    (tenant_id, evidencia_id) [unique, name: 'uq_evidencias_soporte_tenant_evidencia']
    (tenant_id, caso_id, party) [name: 'idx_evidencias_soporte_tenant_caso_party']
  }

  Note: 'EvidenciaSoporte = evidencia de un caso. FK objetivo (tenant_id, caso_id) -> casos_soporte, RESTRICT.'
}

Table lineas_tiempo_soporte {
  id varchar [pk]
  entrada_id varchar
  caso_id varchar [note: 'FK objetivo -> casos_soporte']
  tenant_id varchar
  correlation_id varchar
  action varchar
  actor_id varchar
  created_at timestamp

  indexes {
    (tenant_id, entrada_id) [unique, name: 'uq_lineas_tiempo_tenant_entrada']
    (tenant_id, caso_id, created_at) [name: 'idx_lineas_tiempo_tenant_caso_created']
  }

  Note: 'LineaTiempoSoporte = timeline de un caso. FK objetivo (tenant_id, caso_id) -> casos_soporte, RESTRICT.'
}

Table compensaciones_soporte {
  id varchar [pk]
  entrada_id varchar
  caso_id varchar [note: 'FK objetivo -> casos_soporte']
  tenant_id varchar
  correlation_id varchar
  amount bigint
  currency varchar
  reason varchar
  status varchar
  settlement varchar
  created_at timestamp

  indexes {
    (tenant_id, entrada_id) [unique, name: 'uq_compensaciones_soporte_tenant_entrada']
    (tenant_id, caso_id) [unique, name: 'uq_compensaciones_soporte_tenant_caso', note: '1:1 compensación por caso']
    (tenant_id, caso_id, created_at) [name: 'idx_compensaciones_soporte_tenant_caso_created']
  }

  Note: 'CompensacionSoporte = compensación de un caso. FK objetivo (tenant_id, caso_id) -> casos_soporte, RESTRICT.'
}

// ============================================================
// WHATSAPP
// ============================================================

Table acciones_whatsapp {
  id varchar [pk]
  tenant_id varchar
  idempotency_key varchar
  request_hash varchar
  status varchar
  response json [null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (tenant_id, idempotency_key) [unique, name: 'uq_acciones_whatsapp_tenant_idem']
    (tenant_id, created_at) [name: 'idx_acciones_whatsapp_tenant_created']
  }

  Note: 'AccionWhatsApp = acción gobernada idempotente.'
}

Table confirmaciones_whatsapp {
  id varchar [pk]
  tenant_id varchar
  confirmacion_id varchar
  sender_id varchar [note: '[EXTERNA] número Meta/WhatsApp']
  expires_at timestamp
  consumed_at timestamp [null]
  items json
  created_at timestamp

  indexes {
    (tenant_id, confirmacion_id) [unique, name: 'uq_confirmaciones_whatsapp_tenant_confirmacion']
    (tenant_id, sender_id, expires_at) [name: 'idx_confirmaciones_whatsapp_tenant_sender_expiry']
  }

  Note: 'ConfirmacionWhatsApp = confirmación de consentimiento. sender_id [EXTERNA].'
}

Table auditoria_whatsapp {
  id varchar [pk]
  tenant_id varchar
  action varchar
  outcome varchar
  actor_id varchar
  sender_id varchar [note: '[EXTERNA]']
  correlation_id varchar
  created_at timestamp
  retention_until timestamp [null]

  indexes {
    (tenant_id, created_at) [name: 'idx_auditoria_whatsapp_tenant_created']
    (tenant_id, correlation_id) [name: 'idx_auditoria_whatsapp_tenant_correlation']
  }

  Note: 'AuditoriaWhatsApp = traza del canal. sender_id [EXTERNA].'
}

Table consentimientos_whatsapp {
  id varchar [pk]
  tenant_id varchar
  recipient_id varchar [note: '[EXTERNA] identidad externa']
  recipient_type varchar
  status varchar
  source varchar
