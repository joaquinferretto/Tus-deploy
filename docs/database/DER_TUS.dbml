  tenant_id varchar
  event_id varchar
  correlation_id varchar
  event_type varchar [note: '[TECNICA]']
  aggregate_id varchar [note: '[POLIMORFICA]']
  payload json
  status varchar
  created_at timestamp
  retention_until timestamp

  indexes {
    (tenant_id, event_id) [unique, name: 'uq_outbox_whatsapp_tenant_event']
    (tenant_id, status, created_at) [name: 'idx_outbox_whatsapp_tenant_status_created']
    (tenant_id, correlation_id) [name: 'idx_outbox_whatsapp_tenant_correlation']
  }

  Note: 'OutboxWhatsApp. event_type [TECNICA]; aggregate_id [POLIMORFICA]; sin FK.'
}

Table outbox_facturacion {
  id varchar [pk]
  tenant_id varchar
  event_id varchar
  correlation_id varchar
  event_type varchar [note: '[TECNICA]']
  aggregate_id varchar [note: '[POLIMORFICA]']
  payload json
  status varchar
  attempts int
  available_at timestamp
  created_at timestamp

  indexes {
    (tenant_id, event_id) [unique, name: 'uq_outbox_facturacion_tenant_event']
    (tenant_id, status, available_at) [name: 'idx_outbox_facturacion_tenant_status_available']
  }

  Note: 'OutboxFacturacion. event_type [TECNICA]; aggregate_id [POLIMORFICA]; sin FK.'
}

// ============================================================
// REPORTING
// ============================================================

Table registros_operaciones {
  id varchar [pk]
  tenant_id varchar
  context varchar
  channel varchar
  geography varchar
  outcome varchar
  amount bigint
  currency varchar
  ledger_status varchar
  whatsapp_actions int
  disputes int
  pos_offline int
  created_at timestamp

  indexes {
    (tenant_id, created_at) [name: 'idx_registros_operaciones_tenant_created']
    (tenant_id, context, channel, geography) [name: 'idx_registros_operaciones_tenant_ctx_channel_geo']
  }

  Note: 'RegistroOperaciones = métrica operativa (reporting). Sin FK.'
}

// ============================================================
// RELACIONES FISICAS ACTUALES
// ============================================================

// LineaFactura -> Factura (FK compuesta tenant_id + factura_id) — FISICA_ACTUAL
Ref: lineas_factura.(tenant_id, factura_id) > facturas.(tenant_id, factura_id)

// ============================================================
// RELACIONES OBJETIVO FUTURO
// ============================================================
// FK aprobadas por el análisis relacional; aún NO existen físicamente.

// MERCADO
Ref: publicaciones.(tenant_id, prestador_id) > prestadores.(tenant_id, prestador_id)         // Prestador 1:N Publicacion (OBJETIVO_FUTURO, corrige FK por tenant_id)
Ref: compromisos_mercado_servicios.publicacion_id > publicaciones.id                          // OBJETIVO_FUTURO (referencia PK; tenant validado en aplicación)

// COMPROMISOS
Ref: compromisos.(tenant_id, prestador_id) > prestadores.(tenant_id, prestador_id)           // OBJETIVO_FUTURO
Ref: transiciones_compromiso.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id) // OBJETIVO_FUTURO
Ref: compensaciones_compromiso.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id) // OBJETIVO_FUTURO

// CALENDARIO
Ref: reglas_calendario.calendario_id > calendarios.id              // OBJETIVO_FUTURO (referencia PK; tenant validado en aplicación)
Ref: excepciones_calendario.calendario_id > calendarios.id         // OBJETIVO_FUTURO (referencia PK; tenant validado en aplicación)
Ref: reservas.calendario_id > calendarios.id                       // OBJETIVO_FUTURO (referencia PK; tenant validado en aplicación)

// ENTREGA
Ref: turnos_entrega.(tenant_id, zona_id) > zonas_entrega.(tenant_id, zona_id)                // OBJETIVO_FUTURO
Ref: evidencias_entrega.(tenant_id, tarea_id) > tareas_entrega.(tenant_id, tarea_id)         // OBJETIVO_FUTURO
Ref: incidentes_entrega.(tenant_id, tarea_id) > tareas_entrega.(tenant_id, tarea_id)         // OBJETIVO_FUTURO

// POS
Ref: comprobantes_pos.(tenant_id, operacion_id) > operaciones_pos.(tenant_id, operacion_id)  // OBJETIVO_FUTURO
Ref: conflictos_pos.(tenant_id, operacion_id) > operaciones_pos.(tenant_id, operacion_id)    // OBJETIVO_FUTURO

// SOPORTE
Ref: evidencias_soporte.(tenant_id, caso_id) > casos_soporte.(tenant_id, caso_id)            // OBJETIVO_FUTURO
Ref: lineas_tiempo_soporte.(tenant_id, caso_id) > casos_soporte.(tenant_id, caso_id)         // OBJETIVO_FUTURO
Ref: compensaciones_soporte.(tenant_id, caso_id) > casos_soporte.(tenant_id, caso_id)        // OBJETIVO_FUTURO

// FINANZAS
Ref: intenciones_pago.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id)    // OBJETIVO_FUTURO
Ref: instantaneas_comision.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id) // OBJETIVO_FUTURO
Ref: movimientos_contables.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id) // OBJETIVO_FUTURO
Ref: evidencias_financieras.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id) // OBJETIVO_FUTURO
Ref: confirmaciones_financieras.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id) // OBJETIVO_FUTURO
Ref: bloqueos_financieros.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id) // OBJETIVO_FUTURO
Ref: registros_conciliacion.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id) // OBJETIVO_FUTURO

// FACTURACIÓN
Ref: facturas.(tenant_id, compromiso_id) > compromisos.(tenant_id, compromiso_id)            // OBJETIVO_FUTURO (REQUIERE VALIDACION: "" permitido)
Ref: notas_credito.(tenant_id, factura_id) > facturas.(tenant_id, factura_id)                // OBJETIVO_FUTURO
Ref: reintegros_facturacion.(tenant_id, factura_id) > facturas.(tenant_id, factura_id)       // OBJETIVO_FUTURO
Ref: movimientos_contables_facturacion.(tenant_id, factura_id) > facturas.(tenant_id, factura_id) // OBJETIVO_FUTURO
Ref: gestion_mora.(tenant_id, suscripcion_id) > suscripciones.(tenant_id, suscripcion_id)    // OBJETIVO_FUTURO
Ref: suscripciones.(tenant_id, plan_id) > planes_suscripcion.(tenant_id, plan_id)            // OBJETIVO_FUTURO (REQUIERE VALIDACION: "" permitido)

