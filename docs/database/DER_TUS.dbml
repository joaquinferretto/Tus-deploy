    (tenant_id, correlacion_id) [name: 'idx_outbox_whatsapp_tenant_correlacion']
  }

  Note: 'OutboxWhatsApp. tipo_evento [TECNICA]; agregado_id [POLIMORFICA]; sin FK.'
}

Table outbox_facturacion {
  id varchar [pk]
  tenant_id varchar
  evento_id varchar [note: 'ex eventId']
  correlacion_id varchar [note: 'ex correlationId']
  tipo_evento varchar [note: 'ex eventType; [TECNICA]']
