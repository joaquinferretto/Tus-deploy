// ============================================================
// DER CANÓNICO TUS — MODELO RELACIONAL OBJETIVO (español, snake_case)
// ============================================================
// ADVERTENCIA: este diagrama describe el modelo canónico OBJETIVO de TUS Core.
// NO es una copia exacta del estado físico actual de PostgreSQL.
// Las relaciones marcadas [OBJETIVO_FUTURO] todavía NO existen como FK física
// y se implementarán mediante migraciones forward-only posteriores.
// Las relaciones [FISICA_ACTUAL] ya existen físicamente.
// [LOGICA], [EXTERNA], [POLIMORFICA], [HISTORICA] y [TECNICA] NO son FK SQL.
//
// Convenciones:
//   id          -> PK surrogate estable e inmutable (varchar, generada por aplicación)
//   tenant_id   -> excepción técnica de aislamiento (permanece en inglés)
//   *_id de negocio -> identidad tenant-scoped, protegida por UNIQUE (tenant_id, <id>)
//   bigint      -> dinero/montos en unidades menores (NO int)
//   json        -> valores serializados congelados (NO se traducen los valores)
//
// Excepciones técnicas justificadas: id, tenant_id, actor_id, POS, WhatsApp, sla.
// Los VALORES externos/técnicos congelados NO se traducen (solo el nombre de columna).
//
// Utilizable directamente en dbdiagram.io
//
// WEB-04D2 (2026-09-16, commit 65df852) no agrega tablas, columnas, índices,
// constraints ni migraciones. Formaliza el uso de campos ya existentes desde
// WEB-04D1 para Publicacion, agenda principal y Reserva.

// ============================================================
// MERCADO
// ============================================================

Table prestadores {
  id varchar [pk, note: 'PK surrogate estable e inmutable']
  tenant_id varchar [note: 'excepción técnica de aislamiento']
  prestador_id varchar [note: 'id de negocio del prestador (ex merchantId)']
  cohorte varchar [note: 'ex cohort']
  ubicacion_id varchar [note: 'ex locationId']
  zona_horaria varchar [note: 'ex timezone']
  roles_personal varchar[] [note: 'ex staffRoles']
  version_politica_operativa varchar [note: 'ex operatingPolicyVersion']
  estado varchar [note: 'ex status']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, prestador_id) [unique, name: 'uq_prestadores_tenant_prestador', note: 'OBJETIVO_FUTURO: hoy solo tenant_id es @unique']
    (tenant_id, estado) [name: 'idx_prestadores_tenant_estado']
  }

  Note: 'Prestador = actor que ofrece y ejecuta servicios. PK surrogate; identidad tenant-scoped por (tenant_id, prestador_id).'
}

Table publicaciones {
  id varchar [pk, note: 'PK surrogate estable e inmutable']
  version_contrato varchar [note: 'ex contractVersion']
  tenant_id varchar
  prestador_id varchar [note: 'FK objetivo -> prestadores (ex merchantId)']
  tipo varchar [note: 'ex kind']
  nombre varchar [note: 'ex name']
  descripcion varchar [note: 'ex description']
  cohorte varchar [note: 'ex cohort']
  ubicacion_id varchar [note: 'ex locationId']
  moneda varchar [note: 'ex currency']
  precio bigint [note: 'ex price; unidades menores']
  version_disponibilidad int [note: 'ex availabilityVersion']
  publicada boolean [note: 'ex published']
  version_politica varchar [note: 'ex policyVersion']
  existencias int [null, note: 'ex stock']
  duracion_minutos int [null, note: 'ex durationMinutes']
  duracion_estimada_minutos int [null, note: 'duración estimada; no reemplaza diagnóstico']
  capacidad int [null, note: 'ex capacity']
  modalidad_reserva varchar [null, note: 'fisico canonico: turno_fijo | visita_diagnostico | duracion_estimada | requiere_presupuesto; aliases legacy aceptados']
  modalidad_precio varchar [null, note: 'fisico canonico: precio_fijo | precio_desde | por_hora | presupuesto; aliases legacy aceptados']
  horario_trabajo json [note: 'ex workingHours; LEGACY']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, id) [unique, name: 'uq_publicaciones_tenant_id', note: 'OBJETIVO_FUTURO: redundante con PK id, necesario para FK compuesta tenant-scoped']
    (tenant_id, publicada) [name: 'idx_publicaciones_tenant_publicada']
    (tenant_id, version_disponibilidad) [name: 'idx_publicaciones_tenant_version_disponibilidad']
    (prestador_id, tipo) [name: 'idx_publicaciones_prestador_tipo']
  }

  Note: 'Publicacion = oferta visible y, para tipo service, identidad comercial canónica del servicio MVP. Prestador 1:N Publicacion. horario_trabajo es LEGACY; la disponibilidad nueva vive en calendarios.'
}

Table compromisos_mercado_servicios {
  id varchar [pk]
  version_contrato varchar [note: 'ex contractVersion']
  compromiso_id varchar [note: 'ex commitmentId']
  carrito_id varchar [note: 'ex cartId']
  tenant_id varchar [note: 'tenant cliente del checkout']
  prestador_tenant_id varchar [note: 'tenant propietario de la publicacion']
  prestador_id varchar [note: 'referencia lógica a prestador (ex merchantId)']
  publicacion_id varchar [note: 'FK compuesta (prestador_tenant_id, publicacion_id) -> publicaciones (ex listingId)']
  contexto varchar [note: 'ex context']
  ids_lineas varchar[] [note: 'ex lineIds']
  cantidad int [note: 'ex quantity']
  monto bigint [note: 'ex amount']
  moneda varchar [note: 'ex currency']
  estado varchar [note: 'ex status']
  version_disponibilidad int [note: 'ex availabilityVersion']
  version_politica varchar [note: 'ex policyVersion']
  franja_inicio timestamp [null, note: 'ex slotStart']
  franja_fin timestamp [null, note: 'ex slotEnd']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, compromiso_id) [unique, name: 'uq_compromisos_ms_tenant_compromiso']
    (tenant_id, fecha_creacion) [name: 'idx_compromisos_ms_tenant_fecha_creacion']
    (publicacion_id, franja_inicio, franja_fin) [name: 'idx_compromisos_ms_publicacion_franja']
    (prestador_id, contexto, estado) [name: 'idx_compromisos_ms_prestador_contexto_estado']
  }

  Note: 'CompromisoMercadoServicios = línea de checkout del mercado. tenant_id es cliente; prestador_tenant_id conserva ownership de la publicación.'
}

Table auditoria_mercado_servicios {
  id varchar [pk]
  tenant_id varchar
  actor_id varchar [note: 'identificador técnico transversal']
  correlacion_id varchar [note: 'ex correlationId']
  accion varchar [note: 'ex action']
  tipo_recurso varchar [note: 'ex resourceType; [POLIMORFICA]']
  recurso_id varchar [note: 'ex resourceId; [POLIMORFICA]']
  resultado varchar [note: 'ex outcome']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, fecha_creacion) [name: 'idx_auditoria_ms_tenant_fecha_creacion']
    (tenant_id, tipo_recurso, recurso_id) [name: 'idx_auditoria_ms_tenant_recurso']
  }

  Note: 'AuditoriaMercadoServicios = traza de acciones. tipo_recurso/recurso_id son [POLIMORFICA], sin FK.'
}

// ============================================================
// COMPROMISOS
// ============================================================

Table compromisos {
  id varchar [pk]
  version_contrato varchar [note: 'ex contractVersion']
  compromiso_id varchar [note: 'ex commitmentId']
  carrito_id varchar [note: 'ex cartId']
  tenant_id varchar
  prestador_id varchar [note: 'FK objetivo -> prestadores (ex merchantId)']
  contexto varchar [note: 'ex context']
  monto bigint [note: 'ex amount']
  moneda varchar [note: 'ex currency']
  estado varchar [note: 'ex status']
  ids_lineas varchar[] [note: 'ex lineIds']
  version int
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, compromiso_id) [unique, name: 'uq_compromisos_tenant_compromiso']
    (tenant_id, fecha_creacion) [name: 'idx_compromisos_tenant_fecha_creacion']
    (tenant_id, carrito_id) [name: 'idx_compromisos_tenant_carrito']
  }

  Note: 'Compromiso = obligación comercial canónica. FK objetivo prestador_id -> prestadores, onDelete RESTRICT.'
}

Table transiciones_compromiso {
  id varchar [pk]
  tenant_id varchar
  compromiso_id varchar [note: 'FK objetivo -> compromisos']
  estado_anterior varchar [note: 'ex fromStatus']
  estado_nuevo varchar [note: 'ex toStatus']
  version int
  actor_id varchar [note: 'identificador técnico transversal']
  correlacion_id varchar [note: 'ex correlationId']
  motivo varchar [note: 'ex reason']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, compromiso_id, version) [unique, name: 'uq_transiciones_tenant_compromiso_version']
    (tenant_id, compromiso_id, fecha_creacion) [name: 'idx_transiciones_tenant_compromiso_fecha_creacion']
  }

  Note: '[HISTORICA] append-only. FK objetivo (tenant_id, compromiso_id) -> compromisos, onDelete RESTRICT.'
}

Table compensaciones_compromiso {
  id varchar [pk]
  compensacion_id varchar [note: 'ex compensationId']
  tenant_id varchar
  compromiso_id varchar [note: 'FK objetivo -> compromisos']
  actor_id varchar [note: 'identificador técnico transversal']
  correlacion_id varchar [note: 'ex correlationId']
  monto bigint [note: 'ex amount']
  moneda varchar [note: 'ex currency']
  motivo varchar [note: 'ex reason']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, compensacion_id) [unique, name: 'uq_compensaciones_tenant_compensacion']
    (tenant_id, compromiso_id) [unique, name: 'uq_compensaciones_tenant_compromiso', note: '1:1 compensación por compromiso']
    (tenant_id, compromiso_id, fecha_creacion) [name: 'idx_compensaciones_tenant_compromiso_fecha_creacion']
  }

  Note: 'CompensacionCompromiso = compensación de un compromiso. FK objetivo compromiso_id -> compromisos, RESTRICT.'
}

Table referencias_auditoria {
  id varchar [pk]
  referencia_id varchar [note: 'ex referenceId']
  tenant_id varchar
  actor_id varchar [note: 'identificador técnico transversal']
  correlacion_id varchar [note: 'ex correlationId']
  compromiso_id varchar [note: '[LOGICA] referencia a compromiso']
  tipo_referencia varchar [note: 'ex referenceType']
  metadatos json [null, note: 'ex metadata']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, referencia_id) [unique, name: 'uq_referencias_tenant_referencia']
    (tenant_id, compromiso_id, fecha_creacion) [name: 'idx_referencias_tenant_compromiso_fecha_creacion']
    (tenant_id, correlacion_id) [name: 'idx_referencias_tenant_correlacion']
  }

  Note: 'ReferenciaAuditoria = traza de referencias. compromiso_id es [LOGICA] (puede sobrevivir al agregado).'
}

// ============================================================
// CALENDARIO
// ============================================================

Table calendarios {
  id varchar [pk]
  tenant_id varchar
  prestador_id varchar [null, note: 'FK compuesta a prestadores; agenda principal nueva']
  servicio_id varchar [null, note: '[LEGACY] -> TusService; no usar en flujos nuevos']
  nombre varchar [note: 'ex name']
  zona_horaria varchar [note: 'ex timezone']
  estado varchar [note: 'ex status']
  granularidad_minutos int [default: 15, note: 'paso de posibles inicios']
  buffer_minutos int [default: 0, note: 'separación entre reservas']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, id) [unique, name: 'uq_calendarios_tenant_id', note: 'ya existe físicamente; necesario para FK compuesta tenant-scoped']
    (tenant_id, prestador_id) [unique, name: 'uq_calendarios_tenant_prestador', note: 'agenda principal nueva; NULL permitido para legacy']
    (tenant_id, prestador_id, estado) [name: 'idx_calendarios_tenant_prestador_estado']
    (tenant_id, servicio_id, estado) [name: 'idx_calendarios_tenant_servicio_estado']
  }

  Note: 'Calendario = agenda principal de disponibilidad del Prestador. Prestador 1:0..1 para nuevos datos; servicio_id es LEGACY y puede quedar NULL.'
}

Table reglas_calendario {
  id varchar [pk]
  tenant_id varchar
  calendario_id varchar [note: 'FK objetivo compuesta (tenant_id, calendario_id) -> calendarios']
  dia_semana int [note: 'ex weekday']
  hora_inicio varchar [note: 'ex startsAt (time string)']
  hora_fin varchar [note: 'ex endsAt (time string)']
  capacidad int [note: 'ex capacity']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, calendario_id, dia_semana, hora_inicio, hora_fin) [unique, name: 'uq_reglas_tenant_calendario_franja']
    (tenant_id, calendario_id) [name: 'idx_reglas_tenant_calendario']
  }

  Note: 'ReglaCalendario = regla de franja. FK objetivo (tenant_id, calendario_id) -> calendarios, onDelete CASCADE.'
}

Table excepciones_calendario {
  id varchar [pk]
  tenant_id varchar
  calendario_id varchar [note: 'FK objetivo compuesta (tenant_id, calendario_id) -> calendarios']
  fecha_inicio timestamp [note: 'ex startsAt']
  fecha_fin timestamp [note: 'ex endsAt']
  motivo varchar [note: 'ex reason']
  estado varchar [note: 'ex status']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, calendario_id, fecha_inicio, fecha_fin) [name: 'idx_excepciones_tenant_calendario_franja']
  }

  Note: 'ExcepcionCalendario = excepción de franja. FK objetivo (tenant_id, calendario_id) -> calendarios, CASCADE.'
}

Table reservas {
  id varchar [pk]
  tenant_id varchar
  cliente_tenant_id varchar [null, note: '[LOGICA] tenant cliente; NULL en reservas históricas sin backfill determinista']
  reserva_id varchar [note: 'ex bookingId']
  servicio_id varchar [null, note: '[LEGACY] -> TusService; no usar en reservas nuevas']
  calendario_id varchar [note: 'FK objetivo compuesta (tenant_id, calendario_id) -> calendarios']
  publicacion_id varchar [null, note: 'FK compuesta a publicaciones; identidad canónica nueva']
  cliente_id varchar [note: '[EXTERNA/LOGICA] identidad de cliente']
  fecha_inicio timestamp [note: 'ex startsAt']
  fecha_fin timestamp [note: 'ex endsAt']
  estado varchar [note: 'ex status']
  version int
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, reserva_id) [unique, name: 'uq_reservas_tenant_reserva']
    (tenant_id, calendario_id, fecha_inicio, fecha_fin) [name: 'idx_reservas_tenant_calendario_franja']
    (tenant_id, publicacion_id, fecha_inicio, fecha_fin) [name: 'idx_reservas_tenant_publicacion_franja']
    (tenant_id, cliente_id, estado) [name: 'idx_reservas_tenant_cliente_estado']
  }

  Note: 'Reserva = ocupación de franja/capacidad para una Publicacion. cliente_tenant_id preserva ownership cliente nuevo; publicacion_id es la identidad nueva; servicio_id/cliente_id son LEGACY/EXTERNA.'
}

// ============================================================
// ENTREGA
// ============================================================

Table zonas_entrega {
  id varchar [pk]
  tenant_id varchar
  zona_id varchar [note: 'ex zoneId']
  nombre varchar [note: 'ex name']
  codigos_postales varchar[] [note: 'ex postalCodes']
  activo boolean [note: 'ex active']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, zona_id) [unique, name: 'uq_zonas_tenant_zona']
    (tenant_id, activo) [name: 'idx_zonas_tenant_activo']
  }

  Note: 'ZonaEntrega = zona geográfica de entrega.'
}

Table turnos_entrega {
  id varchar [pk]
  tenant_id varchar
  turno_id varchar [note: 'ex shiftId']
  zona_id varchar [note: 'FK objetivo -> zonas_entrega; ex zoneId']
  fecha_inicio timestamp [note: 'ex startsAt']
  fecha_fin timestamp [note: 'ex endsAt']
  ids_operadores varchar[] [note: 'ex operatorIds']
  estado varchar [note: 'ex status']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, turno_id) [unique, name: 'uq_turnos_tenant_turno']
    (tenant_id, zona_id, estado) [name: 'idx_turnos_tenant_zona_estado']
  }

  Note: 'TurnoEntrega = turno operativo. FK objetivo (tenant_id, zona_id) -> zonas_entrega, RESTRICT.'
}

Table tareas_entrega {
  id varchar [pk]
  tenant_id varchar
  tarea_id varchar [note: 'ex taskId']
  compromiso_id varchar [note: '[LOGICA] referencia a compromiso']
  prestador_id varchar [note: 'referencia lógica a prestador (ex merchantId)']
  contexto varchar [note: 'ex context']
  zona_id varchar [note: '[LOGICA] referencia a zona']
  turno_id varchar [note: '[LOGICA] referencia a turno']
  operador_id varchar [null, note: '[EXTERNA] hasta asignación']
  estado varchar [note: 'ex status']
  version int
  evidencia json [null, note: 'ex proof']
  incidente json [null, note: 'ex incident']
  sla json [null, note: 'ex sla (EXCEPCION técnica)']
  retiro json [null, note: 'ex pickup']
  entrega json [null, note: 'ex dropoff']
  fecha_cancelacion timestamp [null, note: 'ex cancelledAt']
  motivo_fallo varchar [null, note: 'ex failureReason']
  reclamo_liquidacion varchar [note: 'ex settlementClaim']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, tarea_id) [unique, name: 'uq_tareas_tenant_tarea']
    (tenant_id, compromiso_id) [name: 'idx_tareas_tenant_compromiso']
    (tenant_id, turno_id, estado) [name: 'idx_tareas_tenant_turno_estado']
    (tenant_id, compromiso_id, estado) [name: 'idx_tareas_tenant_compromiso_estado']
  }

  Note: 'TareaEntrega = tarea de entrega. compromiso_id es [LOGICA] (entrega puede vivir más que el compromiso). operador_id nullable.'
}

Table evidencias_entrega {
  id varchar [pk]
  tenant_id varchar
  evidencia_id varchar [note: 'ex proofId']
  tarea_id varchar [note: 'FK objetivo -> tareas_entrega; ex taskId']
  compromiso_id varchar [note: '[LOGICA]']
  nombre_destinatario varchar [note: 'ex recipientName']
  fecha_captura timestamp [note: 'ex capturedAt']
  origen_evidencia varchar [note: 'ex evidenceSource']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, evidencia_id) [unique, name: 'uq_evidencias_tenant_evidencia']
    (tenant_id, tarea_id) [name: 'idx_evidencias_tenant_tarea']
  }

  Note: 'EvidenciaEntrega = comprobante de entrega. FK objetivo (tenant_id, tarea_id) -> tareas_entrega, RESTRICT.'
}

Table incidentes_entrega {
  id varchar [pk]
  tenant_id varchar
  incidente_id varchar [note: 'ex incidentId']
  tarea_id varchar [note: 'FK objetivo -> tareas_entrega; ex taskId']
  motivo varchar [note: 'ex reason']
  estado varchar [note: 'ex status']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, incidente_id) [unique, name: 'uq_incidentes_tenant_incidente']
    (tenant_id, tarea_id, estado) [name: 'idx_incidentes_tenant_tarea_estado']
  }

  Note: 'IncidenteEntrega = incidente logístico. FK objetivo (tenant_id, tarea_id) -> tareas_entrega, RESTRICT.'
}

Table auditoria_entrega {
  id varchar [pk]
  tenant_id varchar
  auditoria_id varchar [note: 'ex auditId']
  actor_id varchar [note: 'identificador técnico transversal']
  correlacion_id varchar [note: 'ex correlationId']
  accion varchar [note: 'ex action']
  tipo_recurso varchar [note: 'ex resourceType; [POLIMORFICA]']
  recurso_id varchar [note: 'ex resourceId; [POLIMORFICA]']
  resultado varchar [note: 'ex outcome']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, auditoria_id) [unique, name: 'uq_auditoria_entrega_tenant_auditoria']
    (tenant_id, fecha_creacion) [name: 'idx_auditoria_entrega_tenant_fecha_creacion']
  }

  Note: 'AuditoriaEntrega = traza de entrega. tipo_recurso/recurso_id [POLIMORFICA].'
}

// ============================================================
// POS
// ============================================================

Table operaciones_pos {
  id varchar [pk]
  tenant_id varchar
  operacion_id varchar [note: 'ex operationId']
  clave_idempotencia varchar [note: 'ex idempotencyKey']
  version_esquema varchar [note: 'ex schemaVersion']
  actor_id varchar [note: 'identificador técnico transversal']
  dispositivo_id varchar [note: '[LOGICA] referencia a dispositivo; ex deviceId']
  turno_id varchar [note: '[LOGICA] referencia a turno/sesión; ex shiftId']
  fecha_creacion timestamp [note: 'ex createdAt']
  version_esperada int [null, note: 'ex expectedVersion']
  tipo varchar [note: 'ex kind']
  contexto varchar [note: 'ex context']
  monto bigint [note: 'ex amount']
  moneda varchar [note: 'ex currency']
  respuesta json [null, note: 'ex response']

  indexes {
    (tenant_id, operacion_id) [unique, name: 'uq_operaciones_pos_tenant_operacion']
    (tenant_id, clave_idempotencia) [unique, name: 'uq_operaciones_pos_tenant_clave_idempotencia']
    (tenant_id, turno_id, fecha_creacion) [name: 'idx_operaciones_pos_tenant_turno_fecha_creacion']
    (tenant_id, contexto, tipo) [name: 'idx_operaciones_pos_tenant_contexto_tipo']
  }

  Note: 'OperacionPOS = operación manual. dispositivo_id/turno_id [LOGICA]. Idempotencia por (tenant_id, clave_idempotencia).'
}

Table versiones_pos {
  id varchar [pk]
  tenant_id varchar
  turno_id varchar [note: '[LOGICA]; ex shiftId']
  version int
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, turno_id) [unique, name: 'uq_versiones_pos_tenant_turno']
    (tenant_id, turno_id, version) [name: 'idx_versiones_pos_tenant_turno_version']
  }

  Note: 'VersionPOS = control de versión por turno (turno_id lógico).'
}

Table comprobantes_pos {
  id varchar [pk]
  tenant_id varchar
  comprobante_id varchar [note: 'ex receiptId']
  operacion_id varchar [note: 'FK objetivo -> operaciones_pos; ex operationId']
  tipo varchar [note: 'ex kind']
  contexto varchar [note: 'ex context']
  monto bigint [note: 'ex amount']
  moneda varchar [note: 'ex currency']
  estado varchar [note: 'ex status']
  origen varchar [note: 'ex source']
  captura_proveedor varchar [note: 'ex providerCapture']
  liquidacion varchar [note: 'ex settlement']
  hash_integridad varchar [note: 'ex integrityHash']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, comprobante_id) [unique, name: 'uq_comprobantes_pos_tenant_comprobante']
    (tenant_id, operacion_id) [name: 'idx_comprobantes_pos_tenant_operacion']
    (tenant_id, operacion_id, fecha_creacion) [name: 'idx_comprobantes_pos_tenant_operacion_fecha_creacion']
  }

  Note: 'ComprobantePOS = comprobante. FK objetivo (tenant_id, operacion_id) -> operaciones_pos, RESTRICT.'
}

Table dispositivos_pos {
  id varchar [pk]
  tenant_id varchar
  dispositivo_id varchar [note: 'ex deviceId']
  etiqueta varchar [note: 'ex label']
  huella varchar [note: 'ex fingerprint']
  estado varchar [note: 'ex status']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, dispositivo_id) [unique, name: 'uq_dispositivos_pos_tenant_dispositivo']
    (tenant_id, estado) [name: 'idx_dispositivos_pos_tenant_estado']
  }

  Note: 'DispositivoPOS = dispositivo físico.'
}

Table sesiones_pos {
  id varchar [pk]
  tenant_id varchar
  sesion_id varchar [note: 'ex sessionId']
  dispositivo_id varchar [note: '[LOGICA] referencia a dispositivo; ex deviceId']
  actor_id varchar [note: 'identificador técnico transversal']
  turno_id varchar [note: '[LOGICA]; ex shiftId']
  estado varchar [note: 'ex status']
  fecha_apertura timestamp [note: 'ex openedAt']
  fecha_cierre timestamp [null, note: 'ex closedAt']

  indexes {
    (tenant_id, sesion_id) [unique, name: 'uq_sesiones_pos_tenant_sesion']
    (tenant_id, dispositivo_id, turno_id, estado) [name: 'idx_sesiones_pos_tenant_dispositivo_turno_estado']
  }

  Note: 'SesionPOS = sesión de turno. dispositivo_id/turno_id [LOGICA].'
}

Table conflictos_pos {
  id varchar [pk]
  tenant_id varchar
  conflicto_id varchar [note: 'ex conflictId']
  operacion_id varchar [note: 'FK objetivo -> operaciones_pos; ex operationId']
  motivo varchar [note: 'ex reason']
  version_esperada int [null, note: 'ex expectedVersion']
  version_actual int [null, note: 'ex actualVersion']
  estado varchar [note: 'ex status']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, conflicto_id) [unique, name: 'uq_conflictos_pos_tenant_conflicto']
    (tenant_id, operacion_id, estado) [name: 'idx_conflictos_pos_tenant_operacion_estado']
    (tenant_id, estado, fecha_creacion) [name: 'idx_conflictos_pos_tenant_estado_fecha_creacion']
  }

  Note: 'ConflictoPOS = conflicto de versión. FK objetivo (tenant_id, operacion_id) -> operaciones_pos, RESTRICT.'
}

Table auditoria_pos {
  id varchar [pk]
  tenant_id varchar
  auditoria_id varchar [note: 'ex auditId']
  actor_id varchar [note: 'identificador técnico transversal']
  correlacion_id varchar [note: 'ex correlationId']
  accion varchar [note: 'ex action']
  operacion_id varchar [note: '[LOGICA] referencia a operación; ex operationId']
  resultado varchar [note: 'ex outcome']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, auditoria_id) [unique, name: 'uq_auditoria_pos_tenant_auditoria']
    (tenant_id, operacion_id, fecha_creacion) [name: 'idx_auditoria_pos_tenant_operacion_fecha_creacion']
  }

  Note: 'AuditoriaPOS = traza de operaciones. operacion_id [LOGICA].'
}

// ============================================================
// SOPORTE
// ============================================================

Table casos_soporte {
  id varchar [pk]
  caso_id varchar [note: 'ex caseId']
  disputa_id varchar [note: '[LOGICA] referencia a disputa; ex disputeId']
  tenant_id varchar
  correlacion_id varchar [note: 'ex correlationId']
  compromiso_id varchar [note: '[LOGICA] referencia a compromiso']
  abierto_por varchar [note: 'ex openedBy']
  categoria varchar [note: 'ex category']
  estado varchar [note: 'ex status']
  resultado varchar [null, note: 'ex outcome']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_resolucion timestamp [null, note: 'ex resolvedAt']

  indexes {
    (tenant_id, caso_id) [unique, name: 'uq_casos_soporte_tenant_caso']
    (tenant_id, estado, fecha_creacion) [name: 'idx_casos_soporte_tenant_estado_fecha_creacion']
    (tenant_id, compromiso_id) [name: 'idx_casos_soporte_tenant_compromiso']
  }

  Note: 'CasoSoporte = caso de asistencia. compromiso_id/disputa_id [LOGICA].'
}

Table evidencias_soporte {
  id varchar [pk]
  evidencia_id varchar [note: 'ex evidenceId']
  caso_id varchar [note: 'FK objetivo -> casos_soporte; ex caseId']
  tenant_id varchar
  correlacion_id varchar [note: 'ex correlationId']
  parte varchar [note: 'ex party']
  resumen varchar [note: 'ex summary']
  presentada_por varchar [note: 'ex submittedBy']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, evidencia_id) [unique, name: 'uq_evidencias_soporte_tenant_evidencia']
    (tenant_id, caso_id, parte) [name: 'idx_evidencias_soporte_tenant_caso_parte']
  }

  Note: 'EvidenciaSoporte = evidencia de un caso. FK objetivo (tenant_id, caso_id) -> casos_soporte, RESTRICT.'
}

Table lineas_tiempo_soporte {
  id varchar [pk]
  entrada_id varchar [note: 'ex entryId']
  caso_id varchar [note: 'FK objetivo -> casos_soporte; ex caseId']
  tenant_id varchar
  correlacion_id varchar [note: 'ex correlationId']
  accion varchar [note: 'ex action']
  actor_id varchar [note: 'identificador técnico transversal']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, entrada_id) [unique, name: 'uq_lineas_tiempo_tenant_entrada']
    (tenant_id, caso_id, fecha_creacion) [name: 'idx_lineas_tiempo_tenant_caso_fecha_creacion']
  }

  Note: 'LineaTiempoSoporte = timeline de un caso. FK objetivo (tenant_id, caso_id) -> casos_soporte, RESTRICT.'
}

Table compensaciones_soporte {
  id varchar [pk]
  entrada_id varchar [note: 'ex entryId']
  caso_id varchar [note: 'FK objetivo -> casos_soporte; ex caseId']
  tenant_id varchar
  correlacion_id varchar [note: 'ex correlationId']
  monto bigint [note: 'ex amount']
  moneda varchar [note: 'ex currency']
  motivo varchar [note: 'ex reason']
  estado varchar [note: 'ex status']
  liquidacion varchar [note: 'ex settlement']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, entrada_id) [unique, name: 'uq_compensaciones_soporte_tenant_entrada']
    (tenant_id, caso_id) [unique, name: 'uq_compensaciones_soporte_tenant_caso', note: '1:1 compensación por caso']
    (tenant_id, caso_id, fecha_creacion) [name: 'idx_compensaciones_soporte_tenant_caso_fecha_creacion']
  }

  Note: 'CompensacionSoporte = compensación de un caso. FK objetivo (tenant_id, caso_id) -> casos_soporte, RESTRICT.'
}

// ============================================================
// WHATSAPP
// ============================================================

Table acciones_whatsapp {
  id varchar [pk]
  tenant_id varchar
  clave_idempotencia varchar [note: 'ex idempotencyKey']
  hash_solicitud varchar [note: 'ex requestHash']
  estado varchar [note: 'ex status']
  respuesta json [null, note: 'ex response']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, clave_idempotencia) [unique, name: 'uq_acciones_whatsapp_tenant_clave_idempotencia']
    (tenant_id, fecha_creacion) [name: 'idx_acciones_whatsapp_tenant_fecha_creacion']
  }

  Note: 'AccionWhatsApp = acción gobernada idempotente.'
}

Table confirmaciones_whatsapp {
  id varchar [pk]
  tenant_id varchar
  confirmacion_id varchar [note: 'ex confirmationId']
  remitente_id varchar [note: 'ex senderId; [EXTERNA] número Meta/WhatsApp']
  fecha_expiracion timestamp [note: 'ex expiresAt']
  fecha_consumo timestamp [null, note: 'ex consumedAt']
  elementos json [note: 'ex items']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, confirmacion_id) [unique, name: 'uq_confirmaciones_whatsapp_tenant_confirmacion']
    (tenant_id, remitente_id, fecha_expiracion) [name: 'idx_confirmaciones_whatsapp_tenant_remitente_expiracion']
  }

  Note: 'ConfirmacionWhatsApp = confirmación de consentimiento. remitente_id [EXTERNA].'
}

Table auditoria_whatsapp {
  id varchar [pk]
  tenant_id varchar
  accion varchar [note: 'ex action']
  resultado varchar [note: 'ex outcome']
  actor_id varchar [note: 'identificador técnico transversal']
  remitente_id varchar [note: 'ex senderId; [EXTERNA]']
  correlacion_id varchar [note: 'ex correlationId']
  fecha_creacion timestamp [note: 'ex createdAt']
  retencion_hasta timestamp [null, note: 'ex retentionUntil']

  indexes {
    (tenant_id, fecha_creacion) [name: 'idx_auditoria_whatsapp_tenant_fecha_creacion']
    (tenant_id, correlacion_id) [name: 'idx_auditoria_whatsapp_tenant_correlacion']
  }

  Note: 'AuditoriaWhatsApp = traza del canal. remitente_id [EXTERNA].'
}

Table consentimientos_whatsapp {
  id varchar [pk]
  tenant_id varchar
  destinatario_id varchar [note: 'ex recipientId; [EXTERNA] identidad externa']
  tipo_destinatario varchar [note: 'ex recipientType']
  estado varchar [note: 'ex status']
  origen varchar [note: 'ex source']
  fecha_otorgamiento timestamp [note: 'ex grantedAt']
  fecha_revocacion timestamp [null, note: 'ex revokedAt']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, destinatario_id) [unique, name: 'uq_consentimientos_whatsapp_tenant_destinatario']
    (tenant_id, estado) [name: 'idx_consentimientos_whatsapp_tenant_estado']
  }

  Note: 'ConsentimientoWhatsApp = consentimiento. destinatario_id [EXTERNA].'
}

Table mensajes_whatsapp {
  id varchar [pk]
  tenant_id varchar
  mensaje_id varchar [note: 'ex messageId']
  destinatario_id varchar [note: 'ex recipientId; [EXTERNA]']
  plantilla varchar [note: 'ex template; [EXTERNA] plantilla Meta']
  version_plantilla varchar [note: 'ex templateVersion']
  consentimiento_id varchar [note: '[LOGICA] referencia a consentimiento; ex consentId']
  hash_solicitud varchar [note: 'ex requestHash']
  variables json [null, note: 'variables de plantilla (Meta)']
  estado varchar [note: 'ex status']
  correlacion_id varchar [note: 'ex correlationId']
  retencion_hasta timestamp [null, note: 'ex retentionUntil']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, mensaje_id) [unique, name: 'uq_mensajes_whatsapp_tenant_mensaje']
    (tenant_id, destinatario_id, estado) [name: 'idx_mensajes_whatsapp_tenant_destinatario_estado']
  }

  Note: 'MensajeWhatsApp = mensaje/plantilla. destinatario_id/plantilla [EXTERNA]; consentimiento_id [LOGICA].'
}

Table eventos_webhook_whatsapp {
  id varchar [pk]
  tenant_id varchar
  evento_proveedor_id varchar [note: 'ex providerEventId; [EXTERNA] id de Meta']
  firma varchar [note: 'ex signature; [EXTERNA]']
  fecha_ocurrencia timestamp [note: 'ex occurredAt']
  estado varchar [note: 'ex status']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, evento_proveedor_id) [unique, name: 'uq_eventos_webhook_whatsapp_tenant_evento']
    (tenant_id, estado, fecha_ocurrencia) [name: 'idx_eventos_webhook_whatsapp_tenant_estado_ocurrencia']
  }

  Note: 'EventoWebhookWhatsApp = evento de proveedor. evento_proveedor_id/firma [EXTERNA].'
}

// ============================================================
// HABILITACIÓN
// ============================================================

Table evidencias_habilitacion {
  id varchar [pk]
  version_contrato varchar [note: 'ex contractVersion']
  tenant_id varchar
  capacidad varchar [note: 'ex capability; [POLIMORFICA] capacidad evaluada']
  requisito varchar [note: 'ex gate; [POLIMORFICA] gate/requisito']
  propietario varchar [note: 'ex owner; [POLIMORFICA] propietario']
  alcance varchar [note: 'ex scope; [POLIMORFICA] alcance']
  tipo_evidencia varchar [note: 'ex evidenceType']
  referencia_evidencia varchar [note: 'ex evidenceRef; [EXTERNA] referencia a evidencia externa']
  version_politica varchar [note: 'ex policyVersion']
  fecha_emision timestamp [note: 'ex issuedAt']
  fecha_expiracion timestamp [null, note: 'ex expiresAt']
  revocada boolean [note: 'ex revoked']
  origen varchar [note: 'ex source']
  perfil varchar [note: 'ex profile']
  ejecucion varchar [note: 'ex execution']
  clase_evidencia varchar [note: 'ex evidenceClass']
  conformidad_produccion boolean [note: 'ex liveConformance']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, capacidad, requisito, referencia_evidencia) [unique, name: 'uq_evidencias_hab_tenant_requisito_ref']
    (tenant_id, capacidad, requisito, revocada) [name: 'idx_evidencias_hab_tenant_requisito_revocada']
    (fecha_expiracion) [name: 'idx_evidencias_hab_fecha_expiracion']
  }

  Note: '[HISTORICA] EvidenciaHabilitacion = evidencia de gate. capacidad/requisito/propietario/alcance [POLIMORFICA], sin FK.'
}

Table decisiones_habilitacion {
  id varchar [pk]
  tenant_id varchar
  capacidad varchar [note: 'ex capability; [POLIMORFICA]']
  fecha_evaluacion timestamp [note: 'ex evaluatedAt']
  habilitada boolean [note: 'ex enabled']
  resultado_habilitacion varchar [note: 'ex disposition; valor congelado']
  requisitos_fallidos json [note: 'ex failedGates; valor congelado']
  ids_evidencia varchar[] [note: 'ex evidenceIds']
  determinista boolean [note: 'ex deterministic']
  conflictos json [null, note: 'ex conflicts']
  motivo varchar [null, note: 'ex reason']
  evidencia_preservada boolean [null, note: 'ex evidencePreserved']
  auditoria_preservada boolean [null, note: 'ex auditPreserved']
  actor_id varchar [note: 'identificador técnico transversal']
  trabajo_id varchar [null, note: 'ex jobId']
  correlacion_id varchar [note: 'ex correlationId']
  perfil varchar [note: 'ex profile']
  alcance varchar [note: 'ex scope']
  resultado varchar [note: 'ex outcome']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, capacidad, fecha_evaluacion) [name: 'idx_decisiones_hab_tenant_capacidad_evaluacion']
    (tenant_id, capacidad, habilitada) [name: 'idx_decisiones_hab_tenant_capacidad_habilitada']
    (tenant_id, correlacion_id) [name: 'idx_decisiones_hab_tenant_correlacion']
  }

  Note: '[HISTORICA] append-only. capacidad/perfil/alcance [POLIMORFICA]. Valores resultado/requisitos congelados.'
}

// ============================================================
// FINANZAS
// ============================================================

Table intenciones_pago {
  id varchar [pk]
  version_contrato varchar [note: 'ex contractVersion']
  pago_id varchar [note: 'ex paymentId']
  tenant_id varchar
  compromiso_id varchar [null, note: 'FK -> compromisos (legacy); NULL cuando el sujeto es obligacion_id; ex commitmentId']
  obligacion_id varchar [null, note: 'WEB-09A: FK -> obligaciones_pago_servicio; exactamente un sujeto por fila']
  prestador_tenant_id varchar [null, note: 'WEB-09B: tenant prestador de la obligacion']
  intento int [null, note: 'WEB-09B: intento por obligacion']
  estado_despacho varchar [null, note: 'WEB-09B: pending_dispatch | dispatched | dispatch_failed']
  proveedor varchar [note: 'ex provider; [EXTERNA]']
  referencia_proveedor varchar [null, note: 'ex providerReference; [EXTERNA]']
  estado_proveedor varchar [note: 'ex providerStatus; [EXTERNA]']
  estado_comercial varchar [note: 'ex commercialStatus']
  monto bigint [note: 'ex amount']
  moneda varchar [note: 'ex currency']
  clave_idempotencia varchar [note: 'ex idempotencyKey']
  correlacion_id varchar [note: 'ex correlationId']
  credenciales_recolectadas boolean [note: 'ex credentialsCollected']
  origen varchar [note: 'ex source']
  orden_id varchar [note: 'ex orderId']
  operacion_pos_id varchar [null, note: 'ex posOperationId; [LOGICA]']
  comerciante_registro varchar [note: 'ex merchantOfRecord']
  modelo_cobro varchar [note: 'ex collectionModel']
  politica_distribucion json [null, note: 'ex splitPolicy']
  fecha_liberacion timestamp [note: 'ex releaseAt']
  fecha_evento_proveedor timestamp [null, note: 'ex providerEventAt']
  error_proveedor varchar [null, note: 'ex providerError']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']
  preferencia_id varchar [null, note: 'WEB-09E: [EXTERNA] preferencia Checkout Pro; unique (proveedor, preferencia_id)']
  url_checkout varchar [null, note: 'WEB-09E: URL https de Mercado Pago; no confirma pagos']
  checkout_expira_en timestamp [null]
  tasa_comision_bps int [null, note: 'WEB-09E: tasa congelada al crear el checkout (0..3000)']
  version_regla_comision varchar [null]
  politica_comision_id varchar [null, note: '[LOGICA] politicas_comision_servicio.politica_id']
  comision_marketplace bigint [null, note: 'WEB-09E: marketplace_fee enviado a Mercado Pago; <= monto']
  despacho_reclamado_hasta timestamp [null, note: 'WEB-09E: reclamo corto contra checkouts duplicados']
  entorno_proveedor varchar [null, note: 'sandbox | production | deterministic']

  indexes {
    (tenant_id, pago_id) [unique, name: 'uq_intenciones_pago_tenant_pago']
    (tenant_id, compromiso_id) [unique, name: 'uq_intenciones_pago_tenant_compromiso', note: '1:1 pago por compromiso']
    (tenant_id, clave_idempotencia) [unique, name: 'uq_intenciones_pago_tenant_clave_idempotencia']
    (tenant_id, estado_proveedor) [name: 'idx_intenciones_pago_tenant_estado_proveedor']
    (tenant_id, estado_comercial) [name: 'idx_intenciones_pago_tenant_estado_comercial']
  }

  Note: 'IntencionPago = intención/pago. proveedor/referencia_proveedor/estado_proveedor [EXTERNA]. FK objetivo compromiso_id -> compromisos, RESTRICT.'
}

Table idempotencia_financiera {
  id varchar [pk]
  tenant_id varchar
  clave_idempotencia varchar [note: 'ex idempotencyKey']
  hash_solicitud varchar [note: 'ex requestHash']
  respuesta json [note: 'ex response']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, clave_idempotencia) [unique, name: 'uq_idempotencia_fin_tenant_clave_idempotencia']
    (tenant_id, fecha_actualizacion) [name: 'idx_idempotencia_fin_tenant_fecha_actualizacion']
  }

  Note: 'IdempotenciaFinanciera = idempotencia de finanzas.'
}

Table instantaneas_comision {
  id varchar [pk]
  version_contrato varchar [note: 'ex contractVersion']
  instantanea_id varchar [note: 'ex snapshotId']
  tenant_id varchar
  compromiso_id varchar [null, note: 'NULL cuando el sujeto es obligacion_id; FK objetivo -> compromisos (RESTRICT); ex commitmentId']
  obligacion_id varchar [null, note: 'WEB-09A: FK -> obligaciones_pago_servicio; exactamente un sujeto por fila']
  contexto varchar [note: 'ex context']
  monto_bruto bigint [note: 'ex grossAmount']
  deducciones bigint [note: 'ex deductions']
  base_comisionable bigint [note: 'ex commissionableBase']
  tasa_puntos_base int [note: 'ex rateBps (decisión: españolizado)']
  version_regla varchar [note: 'ex ruleVersion']
  monto_comision bigint [note: 'ex commissionAmount']
  monto_neto bigint [note: 'ex netAmount']
  moneda varchar [note: 'ex currency']
  referencia_proveedor varchar [note: 'ex providerReference; [EXTERNA]']
  evidencia_id varchar [note: '[LOGICA] referencia a evidencia financiera']
  estado_contable varchar [note: 'ex ledgerStatus']
  fecha_creacion timestamp [note: 'ex createdAt']
  politica_comision_id varchar [null, note: 'WEB-09D: [LOGICA] politica aplicada (politicas_comision_servicio.politica_id); NULL = regla por defecto o fila historica']
  comision_proveedor_pago bigint [null, note: 'WEB-09D: fee del PSP en minor units informado por el evento; NULL si no se conoce']
  fee_proveedor_a_cargo varchar [null, note: 'WEB-09D: undetermined | provider | platform (snapshot)']
  neto_prestador bigint [null, note: 'WEB-09D: bruto - comision TUS - fee PSP si lo absorbe el prestador; NULL si no se puede afirmar']

  indexes {
    (tenant_id, instantanea_id) [unique, name: 'uq_instantaneas_comision_tenant_instantanea']
    (tenant_id, compromiso_id) [unique, name: 'uq_instantaneas_comision_tenant_compromiso']
    (tenant_id, version_regla) [name: 'idx_instantaneas_comision_tenant_version_regla']
  }

  Note: '[HISTORICA] InstantaneaComision = snapshot inmutable de comisión. referencia_proveedor [EXTERNA]. FK RESTRICT.'
}

Table movimientos_contables {
  id varchar [pk]
  entrada_id varchar [note: 'ex entryId']
  tenant_id varchar
  compromiso_id varchar [null, note: 'NULL cuando el sujeto es obligacion_id; FK objetivo -> compromisos (RESTRICT); ex commitmentId']
  obligacion_id varchar [null, note: 'WEB-09A: FK -> obligaciones_pago_servicio; exactamente un sujeto por fila']
  tipo_entrada varchar [note: 'ex entryType']
  monto bigint [note: 'ex amount']
  moneda varchar [note: 'ex currency']
  entrada_vinculada_id varchar [null, note: 'ex linkedEntryId; [LOGICA] auto-referencia append-only']
  motivo varchar [note: 'ex reason']
  inmutable boolean [note: 'ex immutable']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, entrada_id) [unique, name: 'uq_movimientos_tenant_entrada']
    (tenant_id, compromiso_id, fecha_creacion) [name: 'idx_movimientos_tenant_compromiso_fecha_creacion']
    (tenant_id, entrada_vinculada_id) [name: 'idx_movimientos_tenant_entrada_vinculada']
  }

  Note: '[HISTORICA] append-only (trigger). entrada_vinculada_id auto-referencia [LOGICA]. FK compromiso_id RESTRICT.'
}

Table evidencias_financieras {
  id varchar [pk]
  version_contrato varchar [note: 'ex contractVersion']
  evidencia_id varchar [note: 'ex evidenceId']
  tenant_id varchar
  compromiso_id varchar [note: 'FK objetivo -> compromisos (RESTRICT); ex commitmentId']
  actor_id varchar [note: 'identificador técnico transversal']
  correlacion_id varchar [note: 'ex correlationId']
  tipo varchar [note: 'ex kind']
  fecha_ocurrencia timestamp [note: 'ex occurredAt']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, evidencia_id) [unique, name: 'uq_evidencias_fin_tenant_evidencia']
    (tenant_id, compromiso_id, tipo) [name: 'idx_evidencias_fin_tenant_compromiso_tipo']
  }

  Note: 'EvidenciaFinanciera = evidencia financiera. FK compromiso_id RESTRICT.'
}

Table confirmaciones_financieras {
  id varchar [pk]
  confirmacion_id varchar [note: 'ex confirmationId']
  tenant_id varchar
  compromiso_id varchar [note: 'FK objetivo -> compromisos (RESTRICT); ex commitmentId']
  actor_id varchar [note: 'identificador técnico transversal']
  correlacion_id varchar [note: 'ex correlationId']
  fecha_confirmacion timestamp [note: 'ex confirmedAt']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, confirmacion_id) [unique, name: 'uq_confirmaciones_fin_tenant_confirmacion']
    (tenant_id, compromiso_id) [unique, name: 'uq_confirmaciones_fin_tenant_compromiso']
    (tenant_id, compromiso_id, fecha_confirmacion) [name: 'idx_confirmaciones_fin_tenant_compromiso_confirmacion']
  }

  Note: 'ConfirmacionFinanciera = confirmación de cumplimiento. FK compromiso_id RESTRICT.'
}

Table bloqueos_financieros {
  id varchar [pk]
  bloqueo_id varchar [note: 'ex freezeId']
  tenant_id varchar
  compromiso_id varchar [note: 'FK objetivo -> compromisos (RESTRICT); ex commitmentId']
  motivo varchar [note: 'ex reason']
  actor_id varchar [note: 'identificador técnico transversal']
  correlacion_id varchar [note: 'ex correlationId']
  activo boolean [note: 'ex active']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, bloqueo_id) [unique, name: 'uq_bloqueos_fin_tenant_bloqueo']
    (tenant_id, compromiso_id) [unique, name: 'uq_bloqueos_fin_tenant_compromiso']
    (tenant_id, motivo, activo) [name: 'idx_bloqueos_fin_tenant_motivo_activo']
  }

  Note: 'BloqueoFinanciero = congelamiento. FK compromiso_id RESTRICT.'
}

Table registros_conciliacion {
  id varchar [pk]
  conciliacion_id varchar [note: 'ex reconciliationId']
  tenant_id varchar
  compromiso_id varchar [note: 'FK objetivo -> compromisos (RESTRICT); ex commitmentId']
  referencia_proveedor varchar [note: 'ex providerReference; [EXTERNA]']
  monto_proveedor bigint [note: 'ex providerAmount; [EXTERNA]']
  evidencia_id varchar [note: '[LOGICA] referencia a evidencia financiera']
  actor_id varchar [note: 'identificador técnico transversal']
  correlacion_id varchar [note: 'ex correlationId']
  estado varchar [note: 'ex status']
  motivo varchar [note: 'ex reason']
  determinista boolean [note: 'ex deterministic']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, conciliacion_id) [unique, name: 'uq_conciliacion_tenant_conciliacion']
    (tenant_id, compromiso_id) [unique, name: 'uq_conciliacion_tenant_compromiso']
    (tenant_id, estado, fecha_creacion) [name: 'idx_conciliacion_tenant_estado_fecha_creacion']
  }

  Note: 'RegistroConciliacion = conciliación. referencia_proveedor/monto_proveedor [EXTERNA]. FK compromiso_id RESTRICT.'
}

Table eventos_webhook_pago {
  id varchar [pk]
  tenant_id varchar
  proveedor varchar [note: 'ex provider; [EXTERNA]']
  evento_proveedor_id varchar [note: 'ex providerEventId; [EXTERNA]']
  firma varchar [note: 'ex signature; [EXTERNA]']
  fecha_ocurrencia timestamp [note: 'ex occurredAt']
  datos_evento json [note: 'ex payload; [EXTERNA]']
  estado varchar [note: 'ex status; WEB-09B: resultado de procesamiento del inbox']
  fecha_creacion timestamp [note: 'ex createdAt']
  pago_id varchar [null, note: 'WEB-09B']
  obligacion_id varchar [null, note: 'WEB-09B: FK -> obligaciones_pago_servicio']
  referencia_proveedor varchar [null, note: 'WEB-09B; [EXTERNA]']
  estado_proveedor varchar [null, note: 'WEB-09B: estado crudo informado']
  monto bigint [null, note: 'WEB-09B: minor units informadas por el provider']
  moneda varchar [null]
  motivo varchar [null, note: 'WEB-09B: razon de cuarentena/descarte']
  fecha_recepcion timestamp [null]

  indexes {
    (tenant_id, proveedor, evento_proveedor_id) [unique, name: 'uq_eventos_webhook_pago_tenant_evento']
    (tenant_id, estado, fecha_ocurrencia) [name: 'idx_eventos_webhook_pago_tenant_estado_ocurrencia']
    (tenant_id, obligacion_id) [name: 'idx_eventos_webhook_pago_tenant_obligacion']
  }

  Note: 'EventoWebhookPago = evento de proveedor. proveedor/evento_proveedor_id/firma/datos_evento [EXTERNA].'
}

// ============================================================
// FACTURACIÓN
// ============================================================

Table facturas {
  id varchar [pk]
  tenant_id varchar
  factura_id varchar [note: 'ex invoiceId']
  cuenta_id varchar [note: 'ex accountId; @default ""; [LOGICA] referencia a cuenta de facturación']
  compromiso_id varchar [note: 'FK objetivo -> compromisos (RESTRICT); hoy permite ""']
  pago_id varchar [note: 'ex paymentId; @default ""; [LOGICA]']
  orden_id varchar [note: 'ex orderId; @default ""; [LOGICA]']
  operacion_pos_id varchar [null, note: 'ex posOperationId; [LOGICA]']
  moneda varchar [note: 'ex currency']
  subtotal bigint
  monto_impuestos bigint [note: 'ex taxAmount']
  monto_tarifas bigint [note: 'ex feeAmount']
  total bigint
  subtotal_menor bigint [note: 'ex subtotalMinor']
  impuestos_menor bigint [note: 'ex taxMinor']
  tarifas_menor bigint [note: 'ex feeMinor']
  total_menor bigint [note: 'ex totalMinor']
  estado varchar [note: 'ex status']
  numero varchar [null, note: 'ex number']
  tipo_factura varchar [note: 'ex invoiceType']
  referencia_fiscal varchar [null, note: 'ex taxReference']
  instantanea_fiscal json [null, note: 'ex taxSnapshot; [HISTORICA] snapshot fiscal']
  version_instantanea int [note: 'ex snapshotVersion']
  fecha_emision timestamp [null, note: 'ex issuedAt']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, factura_id) [unique, name: 'uq_facturas_tenant_factura']
    (tenant_id, compromiso_id, estado) [name: 'idx_facturas_tenant_compromiso_estado']
  }

  Note: '[HISTORICA] append-only (trigger). Documento fiscal. FK objetivo compromiso_id -> compromisos, RESTRICT.'
}

Table lineas_factura {
  id varchar [pk]
  tenant_id varchar
  factura_id varchar [note: 'FK FISICA_ACTUAL compuesta -> facturas; ex invoiceId']
  linea_id varchar [note: 'ex lineId; @default ""']
  descripcion varchar [note: 'ex description']
  cantidad int [note: 'ex quantity']
  unitario_menor bigint [note: 'ex unitMinor']
  impuestos_menor bigint [note: 'ex taxMinor']
  total_menor bigint [note: 'ex totalMinor']
  moneda varchar [note: 'ex currency']
  instantanea json [null, note: 'ex snapshot']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, id) [unique, name: 'uq_lineas_factura_tenant_id']
    (tenant_id, factura_id) [name: 'idx_lineas_factura_tenant_factura']
  }

  Note: 'LineaFactura = línea de factura. FK FISICA_ACTUAL (tenant_id, factura_id) -> facturas.'
}

Table notas_credito {
  id varchar [pk]
  tenant_id varchar
  nota_credito_id varchar [note: 'ex creditNoteId']
  factura_id varchar [note: 'FK objetivo -> facturas; ex invoiceId']
  pago_id varchar [note: 'ex paymentId; @default ""; [LOGICA]']
  orden_id varchar [note: 'ex orderId; @default ""; [LOGICA]']
  operacion_pos_id varchar [null, note: 'ex posOperationId; [LOGICA]']
  moneda varchar [note: 'ex currency']
  monto_menor bigint [note: 'ex amountMinor']
  motivo varchar [note: 'ex reason']
  estado varchar [note: 'ex status']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, nota_credito_id) [unique, name: 'uq_notas_credito_tenant_nota']
    (tenant_id, factura_id, estado) [name: 'idx_notas_credito_tenant_factura_estado']
  }

  Note: '[HISTORICA] append-only. FK objetivo factura_id -> facturas, RESTRICT.'
}

Table suscripciones {
  id varchar [pk]
  tenant_id varchar
  suscripcion_id varchar [note: 'ex subscriptionId']
  cliente_id varchar [note: '[EXTERNA/LOGICA] identidad de cliente; ex customerId']
  plan_id varchar [note: '@default ""; FK objetivo -> planes_suscripcion']
  instantanea_plan json [null, note: 'ex planSnapshot; [HISTORICA]']
  moneda varchar [note: 'ex currency']
  monto_menor bigint [note: 'ex amountMinor']
  intervalo varchar [note: 'ex interval']
  estado varchar [note: 'ex status']
  intento_mora int [note: 'ex dunningAttempt']
  motivo_cancelacion varchar [null, note: 'ex cancelReason']
  fecha_cancelacion timestamp [null, note: 'ex cancelledAt']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, suscripcion_id) [unique, name: 'uq_suscripciones_tenant_suscripcion']
    (tenant_id, cliente_id, estado) [name: 'idx_suscripciones_tenant_cliente_estado']
  }

  Note: 'Suscripcion = suscripción periódica. cliente_id [EXTERNA/LOGICA]; plan_id FK objetivo (requiere limpiar "").'
}

Table perfiles_fiscales {
  id varchar [pk]
  tenant_id varchar
  parte_id varchar [note: 'ex partyId; [POLIMORFICA] parte fiscal']
  identidad_fiscal varchar [note: 'ex taxIdentity']
  categoria_fiscal varchar [note: 'ex taxCategory']
  estado varchar [note: 'ex status']
  referencia_evidencia varchar [note: 'ex evidenceRef; [EXTERNA] referencia a evidencia fiscal']
  autoridad varchar [note: 'ex authority; [EXTERNA] AFIP/ARCA']
  tratamiento_iva varchar [null, note: 'ex ivaTreatment']
  tratamiento_retencion varchar [null, note: 'ex withholdingTreatment']
  referencia_aprobacion_externa varchar [null, note: 'ex externalApprovalReference; [EXTERNA]']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, parte_id) [unique, name: 'uq_perfiles_fiscales_tenant_parte']
    (tenant_id, estado) [name: 'idx_perfiles_fiscales_tenant_estado']
  }

  Note: 'PerfilFiscal = datos fiscales. parte_id [POLIMORFICA]; autoridad/referencia_evidencia [EXTERNA].'
}

Table cuentas_facturacion {
  id varchar [pk]
  tenant_id varchar
  cuenta_facturacion_id varchar [note: 'ex billingAccountId']
  parte_id varchar [note: 'ex partyId; [POLIMORFICA]']
  rol varchar [note: 'ex role']
  estado varchar [note: 'ex status']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, cuenta_facturacion_id) [unique, name: 'uq_cuentas_facturacion_tenant_cuenta']
    (tenant_id, parte_id, estado) [name: 'idx_cuentas_facturacion_tenant_parte_estado']
  }

  Note: 'CuentaFacturacion = cuenta de facturación. parte_id [POLIMORFICA].'
}

Table planes_suscripcion {
  id varchar [pk]
  tenant_id varchar
  plan_id varchar [note: 'id de negocio del plan']
  nombre varchar [note: 'ex name']
  monto_menor bigint [note: 'ex amountMinor']
  moneda varchar [note: 'ex currency']
  intervalo varchar [note: 'ex interval']
  estado varchar [note: 'ex status']
  fecha_creacion timestamp [note: 'ex createdAt']
  fecha_actualizacion timestamp [note: 'ex updatedAt']

  indexes {
    (tenant_id, plan_id) [unique, name: 'uq_planes_suscripcion_tenant_plan']
    (tenant_id, estado) [name: 'idx_planes_suscripcion_tenant_estado']
  }

  Note: 'PlanSuscripcion = plan de suscripción.'
}

Table reintegros_facturacion {
  id varchar [pk]
  tenant_id varchar
  reintegro_id varchar [note: 'ex refundId']
  factura_id varchar [note: 'FK objetivo -> facturas; ex invoiceId']
  pago_id varchar [note: 'ex paymentId; [LOGICA]']
  orden_id varchar [note: 'ex orderId; [LOGICA]']
  operacion_pos_id varchar [null, note: 'ex posOperationId; [LOGICA]']
  moneda varchar [note: 'ex currency']
  monto_menor bigint [note: 'ex amountMinor']
  motivo varchar [note: 'ex reason']
  estado varchar [note: 'ex status']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, reintegro_id) [unique, name: 'uq_reintegros_fact_tenant_reintegro']
    (tenant_id, factura_id) [name: 'idx_reintegros_fact_tenant_factura']
  }

  Note: '[HISTORICA] append-only. FK objetivo factura_id -> facturas, RESTRICT.'
}

Table movimientos_contables_facturacion {
  id varchar [pk]
  tenant_id varchar
  entrada_id varchar [note: 'ex entryId']
  factura_id varchar [note: 'FK objetivo -> facturas; ex invoiceId']
  tipo_entrada varchar [note: 'ex entryType']
  monto_menor bigint [note: 'ex amountMinor']
  moneda varchar [note: 'ex currency']
  entrada_vinculada_id varchar [null, note: 'ex linkedEntryId; [LOGICA] auto-referencia']
  nota_credito_id varchar [null, note: 'ex creditNoteId; [LOGICA]']
  reintegro_id varchar [null, note: 'ex refundId; [LOGICA]']
  pago_id varchar [note: 'ex paymentId; [LOGICA]']
  orden_id varchar [note: 'ex orderId; [LOGICA]']
  operacion_pos_id varchar [null, note: 'ex posOperationId; [LOGICA]']
  inmutable boolean [note: 'ex immutable']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, entrada_id) [unique, name: 'uq_movimientos_fact_tenant_entrada']
    (tenant_id, factura_id, fecha_creacion) [name: 'idx_movimientos_fact_tenant_factura_fecha_creacion']
  }

  Note: '[HISTORICA] append-only (trigger). FK objetivo factura_id -> facturas, RESTRICT.'
}

Table idempotencia_facturacion {
  id varchar [pk]
  tenant_id varchar
  clave varchar [note: 'ex key']
  hash_solicitud varchar [note: 'ex requestHash']
  respuesta json [note: 'ex response']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, clave) [unique, name: 'uq_idempotencia_fact_tenant_clave']
    (tenant_id, fecha_creacion) [name: 'idx_idempotencia_fact_tenant_fecha_creacion']
  }

  Note: 'IdempotenciaFacturacion = idempotencia de facturación.'
}

Table auditoria_facturacion {
  id varchar [pk]
  tenant_id varchar
  auditoria_id varchar [note: 'ex auditId']
  actor_id varchar [note: 'identificador técnico transversal']
  correlacion_id varchar [note: 'ex correlationId']
  accion varchar [note: 'ex action']
  recurso_id varchar [note: 'ex resourceId; [POLIMORFICA]']
  resultado varchar [note: 'ex outcome']
  motivo varchar [null, note: 'ex reason']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, auditoria_id) [unique, name: 'uq_auditoria_fact_tenant_auditoria']
    (tenant_id, correlacion_id, fecha_creacion) [name: 'idx_auditoria_fact_tenant_correlacion_fecha_creacion']
  }

  Note: '[HISTORICA] append-only (trigger). recurso_id [POLIMORFICA].'
}

Table gestion_mora {
  id varchar [pk]
  tenant_id varchar
  mora_id varchar [note: 'ex dunningId']
  suscripcion_id varchar [note: 'FK objetivo -> suscripciones; ex subscriptionId']
  intento int [note: 'ex attempt']
  motivo varchar [note: 'ex reason']
  estado varchar [note: 'ex status']
  fecha_reintento timestamp [null, note: 'ex retryAt']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, mora_id) [unique, name: 'uq_gestion_mora_tenant_mora']
    (tenant_id, suscripcion_id, fecha_creacion) [name: 'idx_gestion_mora_tenant_suscripcion_fecha_creacion']
  }

  Note: 'GestionMora = seguimiento de mora. FK objetivo suscripcion_id -> suscripciones, RESTRICT.'
}

Table secuencias_numeracion {
  id varchar [pk]
  tenant_id varchar [unique, note: '1:1 una secuencia por tenant']
  siguiente_numero int [note: 'ex nextNumber']

  Note: 'SecuenciaNumeracion = numeración de facturas. tenant_id @unique (1:1).'
}

Table exportaciones_contables {
  id varchar [pk]
  tenant_id varchar
  exportacion_id varchar [note: 'ex exportId']
  ids_facturas varchar[] [note: 'ex invoiceIds; [LOGICA] lista de facturas']
  ids_entradas_contables varchar[] [note: 'ex ledgerEntryIds; [LOGICA] lista de movimientos']
  referencia_aprobacion_externa varchar [note: 'ex externalApprovalReference; [EXTERNA]']
  estado varchar [note: 'ex status']
  publicada_externamente boolean [note: 'ex postedExternally']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, exportacion_id) [unique, name: 'uq_exportaciones_tenant_exportacion']
    (tenant_id, fecha_creacion) [name: 'idx_exportaciones_tenant_fecha_creacion']
  }

  Note: '[HISTORICA] append-only (trigger). ids_facturas/ids_entradas_contables [LOGICA]. referencia_aprobacion_externa [EXTERNA].'
}

// ============================================================
// OUTBOX TUS
// ============================================================

Table outbox_entrega {
  id varchar [pk]
  tenant_id varchar
  evento_id varchar [note: 'ex eventId']
  correlacion_id varchar [note: 'ex correlationId']
  tipo_evento varchar [note: 'ex eventType; [TECNICA] congelado']
  agregado_id varchar [note: 'ex aggregateId; [POLIMORFICA]']
  datos_evento json [note: 'ex payload']
  estado varchar [note: 'ex status']
  intentos int [note: 'ex attempts']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, evento_id) [unique, name: 'uq_outbox_entrega_tenant_evento']
    (tenant_id, estado, fecha_creacion) [name: 'idx_outbox_entrega_tenant_estado_fecha_creacion']
  }

  Note: 'OutboxEntrega. tipo_evento [TECNICA]; agregado_id [POLIMORFICA]; sin FK.'
}

Table outbox_pos {
  id varchar [pk]
  tenant_id varchar
  evento_id varchar [note: 'ex eventId']
  tipo_evento varchar [note: 'ex eventType; [TECNICA]']
  agregado_id varchar [note: 'ex aggregateId; [POLIMORFICA]']
  datos_evento json [note: 'ex payload']
  estado varchar [note: 'ex status']
  intentos int [note: 'ex attempts']
  disponible_desde timestamp [note: 'ex availableAt']
  ultimo_error varchar [null, note: 'ex lastError']
  reclamo_procesamiento_id varchar [null, note: 'ex claimId (lease del worker)']
  reclamado_hasta timestamp [null, note: 'ex claimUntil (lease del worker)']
  fecha_publicacion timestamp [null, note: 'ex publishedAt']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, evento_id) [unique, name: 'uq_outbox_pos_tenant_evento']
    (tenant_id, estado, fecha_creacion) [name: 'idx_outbox_pos_tenant_estado_fecha_creacion']
    (tenant_id, agregado_id, estado) [name: 'idx_outbox_pos_tenant_agregado_estado']
  }

  Note: 'OutboxPOS. tipo_evento [TECNICA]; agregado_id [POLIMORFICA]; sin FK.'
}

Table outbox_soporte {
  id varchar [pk]
  tenant_id varchar
  evento_id varchar [note: 'ex eventId']
  correlacion_id varchar [note: 'ex correlationId']
  tipo_evento varchar [note: 'ex eventType; [TECNICA]']
  agregado_id varchar [note: 'ex aggregateId; [POLIMORFICA]']
  datos_evento json [note: 'ex payload']
  estado varchar [note: 'ex status']
  fecha_creacion timestamp [note: 'ex createdAt']

  indexes {
    (tenant_id, evento_id) [unique, name: 'uq_outbox_soporte_tenant_evento']
    (tenant_id, estado, fecha_creacion) [name: 'idx_outbox_soporte_tenant_estado_fecha_creacion']
    (tenant_id, correlacion_id) [name: 'idx_outbox_soporte_tenant_correlacion']
  }

  Note: 'OutboxSoporte. tipo_evento [TECNICA]; agregado_id [POLIMORFICA]; sin FK.'
}

Table outbox_whatsapp {
  id varchar [pk]
  tenant_id varchar
  evento_id varchar [note: 'ex eventId']
  correlacion_id varchar [note: 'ex correlationId']
  tipo_evento varchar [note: 'ex eventType; [TECNICA]']
  agregado_id varchar [note: 'ex aggregateId; [POLIMORFICA]']
  datos_evento json [note: 'ex payload']
  estado varchar [note: 'ex status']
  fecha_creacion timestamp [note: 'ex createdAt']
