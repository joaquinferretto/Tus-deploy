    (tenant_id, idempotency_key) [unique, name: 'uq_intenciones_pago_tenant_idem']
    (tenant_id, provider_status) [name: 'idx_intenciones_pago_tenant_provider_status']
    (tenant_id, commercial_status) [name: 'idx_intenciones_pago_tenant_commercial_status']
  }

