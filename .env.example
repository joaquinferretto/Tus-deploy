# Fictitious local-only values. Real values belong in the profile secret store.
FACTORY_PROFILE=local
RUNTIME_ROLE=api-edge
SERVICE_NAME=product-factory-api
SERVICE_VERSION=0.1.0
SECRET_STORE_REF=local://fictitious

# Local/test database source. Seed commands read this key from the repository root only.
DATABASE_URL="postgresql://factory_user:factory_password@localhost:5432/factory_local"
# Prisma release jobs use a direct endpoint; local development may use the same URL.
DIRECT_URL="postgresql://factory_user:factory_password@localhost:5432/factory_local"
MONGODB_URL="mongodb://localhost:27017/factory_local"
REDIS_URL="redis://localhost:6379/0"

# API Configuration
API_PORT=3101
NODE_ENV=development
LOG_LEVEL=debug
OTEL_SAMPLE_RATIO=1

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:3101"
EXPO_PUBLIC_API_URL="http://localhost:3101"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_WHATSAPP_URL="https://support.example.invalid/whatsapp"

# Security
JWT_SECRET="fictitious-local-secret-not-for-production"
TRUST_PROXY_HOPS=

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3101"

# TUS runtime (API). Native readiness keeps MongoDB/Redis/worker optional.
NATIVE_PROFILE=1
TUS_ROUTES_ENABLED=false
TUS_PROVIDER_ACTIONS_ENABLED=false

# WEB-09D payments: placeholders only. Real values live in the secret store (never in Git or NEXT_PUBLIC_*).
# Payments stay unavailable (fail closed) while any value is missing. See docs/PRODUCCION_TUS.md.
TUS_MERCADOPAGO_ENABLED=false
MERCADO_PAGO_ENVIRONMENT=sandbox
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_OAUTH_REDIRECT_URI="http://localhost:3101/tus/v1/integrations/mercado-pago/oauth/callback"
# WEB-09E: public HTTPS URL of the webhook (Mercado Pago cannot reach localhost; use a tunnel in sandbox).
MERCADO_PAGO_NOTIFICATION_URL="https://api.example.invalid/tus/v1/integrations/mercado-pago/webhooks"
# Optional: only if Mercado Pago requires the `marketplace` field with marketplace_fee for your application.
MERCADO_PAGO_MARKETPLACE=
# 32 random bytes, base64: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TUS_PAYMENT_CREDENTIALS_KEY=
TUS_WEB_BASE_URL="http://localhost:3000"
TUS_PLATFORM_ADMIN_TENANT_ID=

# IDENTITY-NOSIS: provider identity verification. Placeholders only; secrets live in the secret
# store. See docs/IDENTIDAD_PRESTADORES_TUS.md. `demo` is refused when NODE_ENV=production.
IDENTITY_PROVIDER=nosis-browser
NOSIS_BROWSER_MAX_CHECKS_PER_HOUR=7
NOSIS_BROWSER_CONCURRENCY=1
NOSIS_BROWSER_HEADLESS=true
NOSIS_BROWSER_AUTO_LOGIN=true
# Mi Nosis URLs (login page and Localizador) of the operator account.
NOSIS_BROWSER_LOGIN_URL=
NOSIS_BROWSER_LOCALIZADOR_URL=
# Mi Nosis credentials (Documento / Clave): SECRET, worker host only, never in Git.
NOSIS_BROWSER_DOCUMENTO=
NOSIS_BROWSER_CLAVE=
# 32 random bytes, base64 (same command as TUS_PAYMENT_CREDENTIALS_KEY); one key per purpose.
TUS_NOSIS_SESSION_KEY=
TUS_IDENTITY_DOCUMENTS_KEY=
# Vision reader (Groq, OpenAI-compatible API). SECRET. Model and response format are optional.
GROQ_API_KEY=
GROQ_VISION_MODEL=
GROQ_VISION_RESPONSE_FORMAT=json_object
