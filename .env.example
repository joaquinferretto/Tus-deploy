# Fictitious local-only values. Real values belong in the profile secret store (Hostinger panel,
# Vercel project settings, worker host secret manager). Never commit real values.
# Lines marked "# SECRET" hold credentials in real environments. Never expose them as NEXT_PUBLIC_*.
# 32-byte keys (base64): node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Production guide: docs/PRODUCCION_TUS.md

# ---------- API Runtime ------------------------------------------------------------------
FACTORY_PROFILE=local
RUNTIME_ROLE=api-edge
SERVICE_NAME=product-factory-api
SERVICE_VERSION=0.1.0
SECRET_STORE_REF=local://fictitious
NODE_ENV=development
# Local port. In production the platform provides PORT (do not hardcode it).
API_PORT=3101
LOG_LEVEL=debug
OTEL_SAMPLE_RATIO=1
SHUTDOWN_TIMEOUT_MS=10000
# Native readiness keeps MongoDB/Redis/worker optional.
NATIVE_PROFILE=1
# native-local | render-native | aws-terraform
TUS_DEPLOYMENT_PROFILE=native-local
TUS_ROUTES_ENABLED=false
TUS_PROVIDER_ACTIONS_ENABLED=false
# Number of trusted proxy hops (measure it before setting; never "true").
TRUST_PROXY_HOPS=
# CORS Origins (comma-separated, exact Web origins, no wildcards)
CORS_ORIGINS="http://localhost:3000,http://localhost:3101"

# ---------- PostgreSQL 16 ----------------------------------------------------------------
# SECRET. Local/test database source. Seed commands read this key from the repository root only.
# Production: pooled URL with TLS (sslmode=require).
DATABASE_URL="postgresql://factory_user:factory_password@localhost:5432/factory_local"
# SECRET. Prisma release jobs use a direct endpoint; local development may use the same URL.
DIRECT_URL="postgresql://factory_user:factory_password@localhost:5432/factory_local"
MONGODB_URL="mongodb://localhost:27017/factory_local"

# ---------- Redis (optional for a single API instance) -----------------------------------
# SECRET when it carries credentials. Without Redis, rate limits stay in memory.
REDIS_URL="redis://localhost:6379/0"

# ---------- Platform ---------------------------------------------------------------------
TUS_WEB_BASE_URL="http://localhost:3000"
# Tenant of the platform administrators (payments, identity and WhatsApp support admin).
TUS_PLATFORM_ADMIN_TENANT_ID=

# ---------- Google sign-in (OIDC, API only) — OFF until all three are set -----------------
# OAuth client of type "Web application" in Google Cloud Console. The API runs the whole flow
# (state, nonce, PKCE, id_token verification); the Web never sees the secret.
# GOOGLE_REDIRECT_URI must be the API callback registered in Google, e.g.
# https://api.tusservicios.shop/auth/oauth/google/callback (HTTPS in production).
GOOGLE_CLIENT_ID=
# SECRET. Backend only; never NEXT_PUBLIC_*.
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------- Mercado Pago (payments stay OFF / fail closed until validated) ---------------
# Payments stay unavailable while any value is missing. See docs/PRODUCCION_TUS.md.
TUS_MERCADOPAGO_ENABLED=false
MERCADO_PAGO_ENVIRONMENT=sandbox
MERCADO_PAGO_CLIENT_ID=
# SECRET
MERCADO_PAGO_CLIENT_SECRET=
# SECRET
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_OAUTH_REDIRECT_URI="http://localhost:3101/tus/v1/integrations/mercado-pago/oauth/callback"
# Public HTTPS URL of the webhook (Mercado Pago cannot reach localhost; use a tunnel in sandbox).
MERCADO_PAGO_NOTIFICATION_URL="https://api.example.invalid/tus/v1/integrations/mercado-pago/webhooks"
# Optional: only if Mercado Pago requires the `marketplace` field with marketplace_fee.
MERCADO_PAGO_MARKETPLACE=
# SECRET. 32 bytes base64: encrypts provider OAuth tokens.
TUS_PAYMENT_CREDENTIALS_KEY=

# ---------- Identity (provider verification) ---------------------------------------------
# nosis-browser | demo (demo is refused when NODE_ENV=production). See docs/IDENTIDAD_PRESTADORES_TUS.md.
IDENTITY_PROVIDER=nosis-browser
NOSIS_BROWSER_MAX_CHECKS_PER_HOUR=7
# SECRET. 32 bytes base64: encrypts DNI images. SHARED VALUE: the API and the identity worker
# must use exactly the same key (the API encrypts uploads, the worker decrypts them).
TUS_IDENTITY_DOCUMENTS_KEY=

# ---------- Groq (AI provider: WhatsApp assistant, vision, speech) ------------------------
# SECRET. Key pool used in rotation; GROQ_API_KEY is the legacy single key.
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_WHATSAPP_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# ---------- WhatsApp Cloud API (Meta) — OFF until Meta assets exist ----------------------
# TUS_WHATSAPP_ENABLED is accepted as an alias; if both are set they must agree.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=v25.0
# SECRET. System user token (never a temporary user token).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# SECRET. Meta App Secret (verifies X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
# SECRET. At least 16 characters; the same value is configured in the Meta webhook settings.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_BUSINESS_PHONE_NUMBER=
# Comma-separated UTILITY templates already approved in WhatsApp Manager.
WHATSAPP_APPROVED_TEMPLATES=
WHATSAPP_AUDIO_TRANSCRIPTION=false
WHATSAPP_INBOUND_MAX_PER_MINUTE=12
WHATSAPP_INBOUND_BLOCK_PER_MINUTE=60
WHATSAPP_DEBOUNCE_MS=1500
WHATSAPP_AI_MAX_TOOL_CALLS=5
WHATSAPP_AI_MAX_COMPLETION_TOKENS=600
WHATSAPP_AI_HISTORY_MESSAGES=12
WHATSAPP_AI_SUMMARY_THRESHOLD=24
WHATSAPP_AI_TOOL_TIMEOUT_MS=8000

# ---------- RAG / knowledge base ---------------------------------------------------------
RAG_ENABLED=true
RAG_TOP_K=4
# none (full-text only) | openai-compatible | local-hash (development only, refused in production)
RAG_EMBEDDING_PROVIDER=none
# Only for openai-compatible (HTTPS, 1024-dimension vectors).
RAG_EMBEDDING_BASE_URL=
# SECRET
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_SEND_DIMENSIONS=false

# ---------- Identity worker (separate host with Chromium) --------------------------------
# Also needs DATABASE_URL, TUS_IDENTITY_DOCUMENTS_KEY (same value as the API) and the GROQ_* pool.
NOSIS_BROWSER_CONCURRENCY=1
NOSIS_BROWSER_HEADLESS=true
NOSIS_BROWSER_AUTO_LOGIN=true
# Mi Nosis URLs (login page and Localizador) of the operator account.
NOSIS_BROWSER_LOGIN_URL=
NOSIS_BROWSER_LOCALIZADOR_URL=
# SECRET. Mi Nosis credentials (Documento / Clave): worker host only.
NOSIS_BROWSER_DOCUMENTO=
NOSIS_BROWSER_CLAVE=
# SECRET. 32 bytes base64: encrypts the stored Mi Nosis browser session.
TUS_NOSIS_SESSION_KEY=
GROQ_VISION_MODEL=
GROQ_VISION_RESPONSE_FORMAT=json_object
# Optional tuning.
NOSIS_BROWSER_EXECUTABLE_PATH=
NOSIS_BROWSER_TIMEOUT_MS=20000
NOSIS_BROWSER_SELECTORS=
NOSIS_LOGIN_WAIT_MS=600000
TESSERACT_LANG_PATH=
IDENTITY_WORKER_IDLE_MS=5000

# ---------- Web / Vercel (all public: NEVER put secrets here) ----------------------------
NEXT_PUBLIC_API_URL="http://localhost:3101"
EXPO_PUBLIC_API_URL="http://localhost:3101"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_WHATSAPP_URL="https://support.example.invalid/whatsapp"
# Home map (optional). Default: OpenStreetMap tiles centred on Córdoba Capital. For heavy
# traffic configure a tile provider URL with its attribution.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
NEXT_PUBLIC_MAP_DEFAULT_LAT=
NEXT_PUBLIC_MAP_DEFAULT_LNG=
NEXT_PUBLIC_MAP_DEFAULT_LABEL=
# Legacy alias of NEXT_PUBLIC_API_URL (prefer the canonical one).
API_BASE_URL=
# Local Windows builds only: disables Next standalone output (Linux/Render keep it).
NEXT_DISABLE_STANDALONE=false
